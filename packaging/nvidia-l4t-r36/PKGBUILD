# nvidia-l4t-r36: NVIDIA's L4T R36.4 userspace driver libraries (CUDA driver, Vulkan, EGL core,
# nvrm) for the Jetson Nano's GM20B GPU on nvgpu, from NVIDIA's nvidia-l4t-core, -cuda and
# -3d-core 36.4.7 packages (Tegra234 repository; the 540 branch still carries GM20B), downloaded
# from NVIDIA at build time (not redistributed in this repository).
#
# Libraries go to /usr/lib/nvidia-l4t, found through ld.so.conf.d (no file there shares a name
# with a system library). The Vulkan ICD manifest is kept out of the loader's default directory:
# it is selected by VK_DRIVER_FILES in the CUDA boot mode only (nvgpu-nano), so nouveau-mode
# boots never load NVIDIA's driver. The manifest names libEGL_nvidia, which exports the same ICD
# entry points as libGLX_nvidia but does not open an X display while loading (that deadlocks
# Xwayland when glamor runs on Zink).
#
# VK_LAYER_NANO_display (our code, MIT, nano_display_layer.c): the driver's VK_KHR_display path
# opens the downstream /dev/tegra_dc_ctrl, which mainline does not have, and returns
# VK_ERROR_INITIALIZATION_FAILED from the display queries, a result the spec does not allow there
# (vulkaninfo aborts). The layer turns exactly that result into "no displays". It also hides the
# Wayland/X11 window-surface extensions: presenting through them needs NVIDIA's own display
# driver and hangs on mainline (vkcube, mpv's Vulkan output, GTK 4's Vulkan renderer), so apps
# take their OpenGL path on Zink instead. And it keeps the driver's libraries mapped (RTLD_NODELETE)
# once loaded: the driver dlcloses them while its worker threads still run in them, which crashed
# GL apps at exit. Every other call and result passes through.
pkgname=nvidia-l4t-r36
pkgver=36.4.7
pkgrel=3
_debver=36.4.7-20250918154033
pkgdesc="NVIDIA L4T R36.4 CUDA, Vulkan and EGL driver libraries for GM20B on nvgpu (Jetson Nano)"
arch=(aarch64)
url="https://developer.nvidia.com/embedded/jetson-linux"
license=(LicenseRef-NVIDIA-L4T MIT)
depends=(glibc libglvnd libdrm expat)
makedepends=(vulkan-headers)
optdepends=('nvgpu-nano: the kernel driver these libraries need')
options=(!strip !debug)
_pool=https://repo.download.nvidia.com/jetson/t234/pool/main/n
source=("$_pool/nvidia-l4t-core/nvidia-l4t-core_${_debver}_arm64.deb"
        "$_pool/nvidia-l4t-cuda/nvidia-l4t-cuda_${_debver}_arm64.deb"
        "$_pool/nvidia-l4t-3d-core/nvidia-l4t-3d-core_${_debver}_arm64.deb"
        nano_display_layer.c
        VkLayer_nano_display.json
        LICENSE.VK_LAYER_NANO_display)
noextract=("nvidia-l4t-core_${_debver}_arm64.deb"
           "nvidia-l4t-cuda_${_debver}_arm64.deb"
           "nvidia-l4t-3d-core_${_debver}_arm64.deb")
sha256sums=('32d697687db9766b90c021655dc49e62558e7c843a52867c85733c346af283e1'
            '09a153c6e619fa1ad2ba2130ff81c90630d7ac79126f9b7765ca841442cfc8be'
            'b8e79b6a653abcebb3ac21c80dd19e8d1e5c4c1210233d03dd340cd3f1a84c5b'
            'd1d772ebb8df590428181961e28c2a4cdd378065ec92afb1dabba9f195c798b8'
            'd79cd19984678145e0bd9ba3b79a94e64a11f66ada6c74b560121d342da9db00'
            'c7b01f924b87a68caf1a591d1f198fc8d36326efde8f98035316c8f629600ded')

prepare() {
  local p
  for p in core cuda 3d-core; do
    rm -rf "$p" && mkdir -p "$p/deb"
    bsdtar -xf "nvidia-l4t-${p}_${_debver}_arm64.deb" -C "$p/deb"
    bsdtar -xf "$p"/deb/data.tar.* -C "$p"
  done
}

build() {
  ${CC:-gcc} $CFLAGS -Wall -Wextra -fPIC -shared -fvisibility=hidden $LDFLAGS \
    -o libVkLayer_nano_display.so nano_display_layer.c -lpthread
}

package() {
  local L="$pkgdir/usr/lib/nvidia-l4t" p
  install -d "$L"
  for p in core cuda 3d-core; do
    cp -a "$p/usr/lib/aarch64-linux-gnu/nvidia/." "$L/"
    install -Dm644 "$p/usr/share/doc/nvidia-l4t-$p/copyright" \
      "$pkgdir/usr/share/licenses/$pkgname/copyright.nvidia-l4t-$p"
  done
  cp -a 3d-core/usr/lib/aarch64-linux-gnu/tegra-egl/. "$L/"
  # Debian-layout files that do not apply here
  rm -f "$L/ld.so.conf" "$L/nvidia.json" "$L/nvidia_icd.json"
  chmod -R u+rwX,go+rX,go-w "$L"

  install -Dm644 /dev/stdin "$pkgdir/etc/ld.so.conf.d/nvidia-l4t.conf" <<< /usr/lib/nvidia-l4t
  install -Dm644 /dev/stdin "$pkgdir/usr/share/nvidia-l4t/nvidia_icd.json" <<'EOF'
{"file_format_version":"1.0.0","ICD":{"library_path":"/usr/lib/nvidia-l4t/libEGL_nvidia.so.0","api_version":"1.3.251"}}
EOF

  install -Dm755 libVkLayer_nano_display.so "$pkgdir/usr/lib/libVkLayer_nano_display.so"
  install -Dm644 VkLayer_nano_display.json \
    "$pkgdir/usr/share/vulkan/implicit_layer.d/VkLayer_nano_display.json"
  install -Dm644 LICENSE.VK_LAYER_NANO_display \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.VK_LAYER_NANO_display"
}
