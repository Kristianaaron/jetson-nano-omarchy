-# same span rather than as a row of its own.
-def window_title(minutes):
-  if minutes >= 28 * 24 * 60:
-    return "Monthly"
-  if minutes >= 24 * 60:
-    return "Weekly"
-  if minutes > 0:
-    return "Session"
