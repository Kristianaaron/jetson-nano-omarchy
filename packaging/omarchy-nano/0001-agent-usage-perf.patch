+# omarchy:summary=Print the Fireworks usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Fireworks serverless usage into one display-ready JSON record.
+
+Token stats come from the Fireworks billing API grouped by day and model for
+the last 30 days. Fireworks does not expose its prepaid ledger, so the record
+carries an estimated balance instead of rate limits: the credits configured in
+~/.config/omarchy/agents/fireworks.json minus rated account costs since the
+funding date. The agents panel only ever reads the JSON this prints.
+
+Each API key keeps its account's last good usage rows and balance under the
+agent-usage cache, so a failed check shows them stale rather than blank.
+"""
+
+from __future__ import annotations
+
+import argparse
+import configparser
+import json
+import math
+import os
+import re
+import sys
+import urllib.parse
+import urllib.request
+from datetime import date, datetime, time, timedelta, timezone
+from decimal import Decimal, InvalidOperation
+from pathlib import Path
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  Stats,
+  base_record as shared_base_record,
+  cache_root,  # noqa: F401 - the tests find the cached answers through it
+  config_home,
+  data_home,
+  emit,
+  number,
+  open_json,
+  read_json,
+  scan_max_age,
+  trusted_endpoint,
+)
+
+AGENT_ID = "fireworks"
+AGENT_NAME = "Fireworks"
+AUTH_HELP = "Set FIREWORKS_API_KEY, run `firectl set-api-key`, or sign in to Fireworks in pi or opencode."
+API_BASE_URL = "https://api.fireworks.ai"
+
+
+class FireworksError(Exception):
+  pass
+
+
+# No server answered at all (DNS, connection, timeout): the one failure worth
+# a sooner retry.
+class FireworksTransportError(FireworksError):
+  pass
+
+
+# The key itself was refused, so only a new one helps.
+class FireworksAuthError(FireworksError):
+  pass
+
+
+# The key may not read this: a billing role it lacks.
+class FireworksDeniedError(FireworksError):
+  pass
+
+
+def representable(amount: Decimal) -> bool:
+  # Finite as a Decimal can still overflow the float the record prints.
+  return amount.is_finite() and math.isfinite(float(amount))
+
+
+def money_value(value: Any, unreadable: Decimal | None = Decimal("0")) -> Decimal | None:
+  if not isinstance(value, dict):
+    return unreadable
+  try:
+    units = Decimal(str(value.get("units", 0) or 0))
+    nanos = Decimal(str(value.get("nanos", 0) or 0)) / Decimal("1000000000")
+    total = units + nanos
+  except (InvalidOperation, TypeError, ValueError):
+    return unreadable
+  # An amount the record can't print as a number is no amount.
+  return total if representable(total) else unreadable
+
+
+def model_id(row: dict[str, Any]) -> str:
+  group = row.get("group") if isinstance(row.get("group"), dict) else {}
+  raw = group.get("model_name") or row.get("modelName") or "unknown"
+  name = str(raw).rstrip("/").split("/")[-1] or "unknown"
+  return re.sub(r"(?<=\d)p(?=\d)", ".", name)
+
+
+def row_date(row: dict[str, Any]) -> str:
+  # The query asks for day buckets in the local timezone, but the API reports
+  # each bucket's boundary in UTC: local Aug 7 starts at Aug 6 22:00Z east of
+  # Greenwich. Convert back to local time to recover the day the bucket names —
+  # taking the raw date prefix would file every day under its predecessor.
+  raw = str(row.get("startTime") or "")
+  if not raw:
+    return ""
+  try:
+    parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
+  except ValueError:
+    try:
+      return date.fromisoformat(raw[:10]).isoformat()
+    except ValueError:
+      return ""
+  if parsed.tzinfo is None:
+    parsed = parsed.replace(tzinfo=timezone.utc)
+  try:
+    return parsed.astimezone().date().isoformat()
+  except (OverflowError, ValueError):
+    # A time at the edge of the calendar has no local day.
+    return ""
+
+
+def base_record(**overrides: Any) -> dict[str, Any]:
+  return shared_base_record(AGENT_ID, AGENT_NAME, **{
+    # Billing-API numbers are account-global, not machine-local: every synced
+    # device reports the same truth, so aggregation must not sum them.
+    "scope": "account",
+    # The billing API reports tokens, never prompt or session counts; the
+    # panel keeps those numbers out of today's tooltip when this is false.
+    "hasPromptStats": False,
+    "tierLabel": "Prepaid",
+    **overrides,
+  })
+
+
+# The billing API's rows are account-wide day-and-model buckets, not replies:
+# no prompt or session to count, a bucket without a day still counts toward
+# its model, and `today` is the caller's. So the record carries only their
+# token fields.
+def summarize_usage(payload: dict[str, Any], today: date | None = None) -> dict[str, Any]:
+  stats = Stats(today)
+
+  rows = payload.get("serverlessCosts")
+  if not isinstance(rows, list):
+    rows = []
+
+  for raw_row in rows:
+    if not isinstance(raw_row, dict):
+      continue
+    day = row_date(raw_row)
+    model = model_id(raw_row)
+    # Counts from the API are untrusted, and come as strings: number() reads
+    # a boolean, a negative, a non-finite or an absurdly large one as nothing.
+    prompt = number(raw_row.get("promptTokens"))
+    cached = min(prompt, number(raw_row.get("cachedPromptTokens")))
+    uncached = number(raw_row.get("uncachedPromptTokens"))
+    if "uncachedPromptTokens" not in raw_row:
+      uncached = max(0, prompt - cached)
+    output = number(raw_row.get("completionTokens"))
+    stats.add(day or None, None, model, uncached, output, cached, 0, prompts=0)
+
+  snapshot = stats.snapshot()
+  return {key: snapshot[key] for key in ("todayTotalTokens", "todayTokensByModel", "recentDays", "activeDays", "activeDates", "modelUsage")}
+
+
+def read_auth_file(path: Path) -> tuple[str, str]:
+  if not path.is_file():
+    return "", ""
+
+  parser = configparser.ConfigParser(interpolation=None)
+  try:
+    parser.read(path)
+  except (configparser.Error, UnicodeDecodeError):
+    return "", ""
+
+  api_key = ""
+  account_id = ""
+  sections = [parser.defaults()]
+  sections.extend(parser[section] for section in parser.sections())
+  for values in sections:
+    api_key = api_key or str(values.get("api_key", values.get("api-key", ""))).strip()
+    account_id = account_id or str(values.get("account_id", values.get("account-id", ""))).strip()
+  return api_key, account_id
+
+
+def pi_auth_path() -> Path:
+  agent_dir = Path(os.environ.get("PI_CODING_AGENT_DIR") or (Path.home() / ".pi" / "agent"))
+  return agent_dir / "auth.json"
+
+
+def opencode_auth_path() -> Path:
+  return data_home() / "opencode" / "auth.json"
+
+
+PI_ENV_REFERENCE = re.compile(r"\$(?:\{([A-Za-z_][A-Za-z0-9_]*)\}|([A-Za-z_][A-Za-z0-9_]*))")
+
+
+def resolve_pi_key(raw: Any) -> str:
+  # pi credential keys are literals, $ENV_VAR/${ENV_VAR} references, or
+  # !command shell lookups. The collector resolves the first two; command
+  # lookups stay pi-only and are skipped rather than sent to the API verbatim.
+  key = str(raw or "").strip()
+  if not key or key.startswith("!"):
+    return ""
+  # Escapes survive interpolation as sentinels, then restore.
+  key = key.replace("$$", "\x00").replace("$!", "\x01")
+
+  unresolved = False
+
+  def substitute(match: re.Match[str]) -> str:
+    nonlocal unresolved
+    value = os.environ.get(match.group(1) or match.group(2), "")
+    if not value:
+      unresolved = True
+    return value
+
+  key = PI_ENV_REFERENCE.sub(substitute, key)
+  if unresolved:
+    return ""
+  return key.replace("\x00", "$").replace("\x01", "!")
+
+
+def read_pi_key(path: Path) -> str:
+  entry = read_json(path).get("fireworks")
+  if not isinstance(entry, dict):
+    return ""
+  if entry.get("type") not in (None, "api_key"):
+    return ""
+  return resolve_pi_key(entry.get("key"))
+
+
+def read_opencode_key(path: Path) -> str:
+  entry = read_json(path).get("fireworks-ai")
+  if not isinstance(entry, dict):
+    return ""
+  return str(entry.get("key") or "").strip()
+
+
+def config_path() -> Path:
+  return config_home() / "omarchy" / "agents" / "fireworks.json"
+
+
+def read_config() -> dict[str, Any]:
+  return read_json(config_path())
+
+
+def credentials(auth_path: Path, config: dict[str, Any]) -> tuple[str, str]:
+  file_key, file_account = read_auth_file(auth_path)
+  # Agent logins are the fallback ladder below an explicit key or a firectl
+  # login: pi first as Omarchy's default agent, opencode as the last resort.
+  api_key = (
+    str(os.environ.get("FIREWORKS_API_KEY", "")).strip()
+    or file_key
+    or read_pi_key(pi_auth_path())
+    or read_opencode_key(opencode_auth_path())
+  )
+  account_id = (
+    str(os.environ.get("FIREWORKS_ACCOUNT_ID", "")).strip()
+    or str(config.get("accountId") or "").strip()
+    or file_account
+  )
+  return api_key, account_id
+
+
+def normalize_account_id(value: str) -> str:
+  return str(value or "").strip().removeprefix("accounts/").strip("/")
+
+
+def timezone_name() -> str:
+  configured = str(os.environ.get("TZ", "")).strip()
+  if configured:
+    return configured
+  try:
+    target = (Path("/etc/localtime").resolve()).as_posix()
+    marker = "/zoneinfo/"
+    if marker in target:
+      return target.split(marker, 1)[1]
+  except OSError:
+    pass
+  return "UTC"
+
+
+def local_midnight_utc(day: date) -> str:
+  # The API buckets by the requested timezone, so the window must run between
+  # local midnights — expressed in UTC, since a bare date with a Z suffix
+  # shifts the window by the UTC offset and clips today's tail west of
+  # Greenwich.
+  return datetime.combine(day, time.min).astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def iso_timestamp(value: str) -> str:
+  raw = str(value or "").strip()
+  if not raw:
+    return ""
+  try:
+    if len(raw) == 10:
+      parsed = datetime.combine(date.fromisoformat(raw), time.min, tzinfo=timezone.utc)
+    else:
+      parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
+      if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+  except ValueError:
+    raise FireworksError("Fireworks fundedAt must be an ISO date such as 2026-07-01")
+
+
+class FireworksClient:
+  def __init__(self, api_key: str, base_url: str = API_BASE_URL):
+    self.api_key = api_key
+    self.base_url = base_url.rstrip("/")
+
+  def request(
+    self,
+    path: str,
+    query: dict[str, Any] | None = None,
+    body: dict[str, Any] | None = None,
+  ) -> dict[str, Any]:
+    url = self.base_url + path
+    # FIREWORKS_API_BASE_URL moves the endpoint, never the key onto a
+    # connection anyone on the way can read.
+    if not trusted_endpoint(url):
+      raise FireworksError("FIREWORKS_API_BASE_URL must use HTTPS (plain HTTP only for loopback)")
+    if query:
+      url += "?" + urllib.parse.urlencode(query, doseq=True)
+    data = None if body is None else json.dumps(body).encode("utf-8")
+    request = urllib.request.Request(
+      url,
+      data=data,
+      method="POST" if body is not None else "GET",
+      headers={
+        "Authorization": "Bearer " + self.api_key,
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+      },
+    )
+    try:
+      decoded = open_json(request, timeout=15)
+    except HttpError as error:
+      if error.status == 401:
+        raise FireworksAuthError("Fireworks rejected the API key") from error
+      if error.status == 403:
+        raise FireworksDeniedError("The Fireworks API key cannot read billing data") from error
+      if error.status == 404:
+        raise FireworksError("Fireworks account not found") from error
+      if error.status:
+        raise FireworksError(f"Fireworks API returned HTTP {error.status}") from error
+      if error.transport:
+        raise FireworksTransportError("Could not reach the Fireworks API") from error
+      raise FireworksError("Fireworks returned an invalid billing response") from error
+    # Every answer is an object; anything else would read as an account with
+    # nothing in it and replace the last good numbers.
+    if not isinstance(decoded, dict):
+      raise FireworksError("Fireworks returned an invalid billing response")
+    return decoded
+
+  def discover_account(self) -> tuple[str, dict[str, Any]]:
+    payload = self.request("/v1/accounts", query={"pageSize": 100})
+    accounts = payload.get("accounts", [])
+    if not isinstance(accounts, list):
+      raise FireworksError("Fireworks returned an invalid billing response")
+    accounts = [item for item in accounts if isinstance(item, dict)]
+    if len(accounts) == 1:
+      account = accounts[0]
+      return normalize_account_id(str(account.get("name") or "")), account
+    if not accounts:
+      raise FireworksError("No Fireworks account is available for this API key")
+    raise FireworksError("Set accountId in fireworks.json when the API key can access multiple accounts")
+
+  def account(self, account_id: str) -> dict[str, Any]:
+    quoted = urllib.parse.quote(normalize_account_id(account_id), safe="")
+    return self.request(f"/v1/accounts/{quoted}")
+
+  def usage(self, account_id: str, start_day: date, end_day: date) -> dict[str, Any]:
+    quoted = urllib.parse.quote(normalize_account_id(account_id), safe="")
+    query = {
+      "startTime": local_midnight_utc(start_day),
+      "endTime": local_midnight_utc(end_day),
+      "usageType": "SERVERLESS",
+      "timezone": timezone_name(),
+      "groupBy": ["model_name"],
+    }
+    # 30 days grouped by model can exceed one page; follow the continuation
+    # tokens or heavy accounts lose their tail. The bound is a runaway stop.
+    rows: list[Any] = []
+    for _ in range(20):
+      payload = self.request(f"/v1/accounts/{quoted}/billingUsage", query=query)
+      # The API leaves out a list with nothing in it, so a missing one is an
+      # idle month; one that is there but isn't a list is a broken answer.
+      page = payload.get("serverlessCosts", [])
+      if not isinstance(page, list):
+        raise FireworksError("Fireworks returned an invalid billing response")
+      rows.extend(page)
+      token = str(payload.get("nextPageToken") or "")
+      if not token:
+        break
+      query = dict(query, pageToken=token)
+    return {"serverlessCosts": rows}
+
+  def spent(self, account_id: str, start_at: str, end_at: str) -> Decimal:
+    quoted = urllib.parse.quote(normalize_account_id(account_id), safe="")
+    body = {
+      "startTime": start_at,
+      "endTime": end_at,
+      "scope": "ACCOUNT",
+    }
+    try:
+      payload = self.request(f"/v1/accounts/{quoted}/usageCosts:query", body=body)
+      subtotal = money_value(payload.get("subtotal"), None)
+      if subtotal is None:
+        raise FireworksError("Fireworks cost response did not include a subtotal")
+      return subtotal
+    except FireworksError:
+      parsed_end = datetime.fromisoformat(end_at.replace("Z", "+00:00"))
+      summary_end = (parsed_end.date() + timedelta(days=1)).isoformat() + "T00:00:00Z"
+      payload = self.request(
+        f"/v1/accounts/{quoted}/billing/summary",
+        query={"startTime": start_at, "endTime": summary_end},
+      )
+      items = payload.get("lineItems", [])
+      if not isinstance(items, list):
+        raise FireworksError("Fireworks returned an invalid billing response")
+      return sum((money_value(item.get("totalCost")) for item in items if isinstance(item, dict)), Decimal("0"))
+
+
+def live_balance(client: FireworksClient, account_id: str) -> Decimal | None:
+  # accounts/{id}:getBalance exists but is permission-gated: keys without the
+  # billing role get PERMISSION_DENIED, and then the configured estimate below
+  # is the best we can do. The response shape is undocumented, so accept a
+  # Money object at the top level or under any plausible field name.
+  quoted = urllib.parse.quote(normalize_account_id(account_id), safe="")
+  # Any other failure means the balance couldn't be checked at all, which a
+  # missing estimate must not paper over as "no balance": it propagates, and
+  # the last good balance stands.
+  try:
+    payload = client.request(f"/v1/accounts/{quoted}:getBalance")
+  except FireworksDeniedError:
+    return None
+  candidates = [payload] + [payload.get(field) for field in ("balance", "creditBalance", "prepaidBalance", "amount")]
+  for value in candidates:
+    if isinstance(value, dict) and ("units" in value or "nanos" in value):
+      amount = money_value(value, None)
+      if amount is None:
+        raise FireworksError("Fireworks returned an unreadable balance")
+      return amount
+  return None
+
+
+def estimated_balance(
+  client: FireworksClient,
+  account_id: str,
+  account: dict[str, Any],
+  config: dict[str, Any],
+) -> dict[str, Any] | None:
+  try:
+    funded = Decimal(str(config.get("fundedAmount") or "0"))
+  except InvalidOperation:
+    raise FireworksError("Fireworks fundedAmount must be a number")
+  if not representable(funded):
+    raise FireworksError("Fireworks fundedAmount must be a finite number")
+  if funded <= 0:
+    return None
+
+  funded_at = iso_timestamp(str(config.get("fundedAt") or ""))
+  if not funded_at:
+    if not account:
+      account = client.account(account_id)
+    funded_at = iso_timestamp(str(account.get("createTime") or ""))
+  if not funded_at:
+    raise FireworksError("Set fundedAt because the Fireworks account creation date is unavailable")
+
+  end_at = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
+  spent = max(Decimal("0"), client.spent(account_id, funded_at, end_at))
+  return {
+    "remaining": float(max(Decimal("0"), funded - spent)),
+    "funded": float(funded),
+    "spent": float(spent),
+    "currency": "USD",
+    "estimated": True,
+  }
+
+
+def current_balance(
+  client: FireworksClient,
+  account_id: str,
+  account: dict[str, Any],
+  config: dict[str, Any],
+) -> dict[str, Any] | None:
+  live = live_balance(client, account_id)
+  if live is None:
+    return estimated_balance(client, account_id, account, config)
+  try:
+    funded = Decimal(str(config.get("fundedAmount") or "0"))
+    if not representable(funded) or funded < 0:
+      funded = Decimal("0")
+  except InvalidOperation:
+    funded = Decimal("0")
+  # An overdrawn account has nothing left, and spent no more than it funded.
+  live = max(Decimal("0"), live)
+  return {
+    "remaining": float(live),
+    "funded": float(funded),
+    "spent": float(max(Decimal("0"), funded - live)),
+    "currency": "USD",
+    "estimated": False,
+  }
+
+
+# ---------------------------------------------------------------- caches
+
+
+# Both answers are keyed by the API key: the balance under the limits cache
+# name every collector shares, the usage rows beside it. Neither holds limit
+# windows, so either stands in for a probe on its stamp alone.
+def caches(api_key: str) -> tuple[LimitsCache, LimitsCache]:
+  return LimitsCache(AGENT_ID, api_key, kind="usage"), LimitsCache(AGENT_ID, api_key)
+
+
+# The last good answer of one kind (the account's usage rows, or its balance)
+# for this API key and account, whatever its file time: a clock that went
+# back doesn't lose it. An answer for another account never stands in.
+def cached_part(cache: LimitsCache, account_id: str) -> dict[str, Any] | None:
+  if not cache.fetched_at:
+    return None
+  if account_id and normalize_account_id(str(cache.data.get("accountId") or "")) != account_id:
+    return None
+  return dict(cache.data, fetchedAtMs=cache.fetched_at)
+
+
+# Refreshes can overlap (the panel's own and a sooner retry), so an answer
+# only replaces one fetched before it.
+def remember(cache: LimitsCache, **part: Any) -> dict[str, Any]:
+  cache.save([], only_if_newer=True, **part)
+  return dict(cache.data)
+
+
+# ---------------------------------------------------------------- record
+
+
+def scan(api_base_url: str, auth_path: Path, force: bool = False, limits_only: bool = False) -> dict[str, Any]:
+  config = read_config()
+  api_key, account_id = credentials(auth_path, config)
+  # No key anywhere: Fireworks isn't used here, and the panel skips it.
+  if not api_key:
+    return base_record(tierLabel="")
+
+  account_id = normalize_account_id(account_id) if account_id else ""
+  usage_cache, balance_cache = caches(api_key)
+  usage_part = cached_part(usage_cache, account_id)
+  balance_part = cached_part(balance_cache, account_id)
+
+  # The usage rows are this record's stats, so they are reused like a local
+  # scan: briefly on a normal run, for 15 minutes on the panel's near-limit
+  # refresh. That refresh is about the balance, which comes from separate
+  # calls, so it is probed like a normal run. --force reuses nothing.
+  usage_fresh = usage_part is not None and usage_cache.fresh(force, scan_max_age(force, limits_only), allow_empty=True)
+  balance_fresh = balance_part is not None and balance_cache.fresh(force, allow_empty=True)
+
+  errors: list[FireworksError] = []
+  failed: set[str] = set()
+  today = datetime.now().astimezone().date()
+  if not (usage_fresh and balance_fresh):
+    client = FireworksClient(api_key, api_base_url)
+    account: dict[str, Any] = {}
+    try:
+      if not account_id:
+        account_id, account = client.discover_account()
+        # A key that now reaches another account starts over.
+        if usage_part and normalize_account_id(str(usage_part.get("accountId") or "")) != account_id:
+          usage_part, usage_fresh = None, False
+        if balance_part and normalize_account_id(str(balance_part.get("accountId") or "")) != account_id:
+          balance_part, balance_fresh = None, False
+    except FireworksError as error:
+      errors.append(error)
+      failed.update(name for name, fresh in (("usage", usage_fresh), ("balance", balance_fresh)) if not fresh)
+    else:
+      if not usage_fresh:
+        try:
+          usage = client.usage(account_id, today - timedelta(days=29), today + timedelta(days=1))
+          usage_part = remember(usage_cache, accountId=account_id, serverlessCosts=usage.get("serverlessCosts") or [])
+        except FireworksError as error:
+          errors.append(error)
+          failed.add("usage")
+      if not balance_fresh:
+        try:
+          balance_part = remember(balance_cache, accountId=account_id, balance=current_balance(client, account_id, account, config))
+        except FireworksError as error:
+          errors.append(error)
+          failed.add("balance")
+
+  record = base_record(ready=True)
+  # Kept rows are summarized against today, so a day-old answer still files
+  # its tokens under the right days.
+  if usage_part is not None:
+    rows = usage_part.get("serverlessCosts")
+    record.update(summarize_usage({"serverlessCosts": rows if isinstance(rows, list) else []}, today))
+    record["hasLocalStats"] = True
+  if balance_part is not None and isinstance(balance_part.get("balance"), dict):
+    record["balance"] = balance_part["balance"]
+  kept = [part for part in (usage_part, balance_part) if part is not None]
+  if kept:
+    record["limitsFetchedAt"] = min(part["fetchedAtMs"] for part in kept)
+  # Anything that didn't come back fresh marks the record stale, kept or not;
+  # the panel shows the kept numbers' age on hover.
+  record["limitsStale"] = bool(failed)
+  if any(isinstance(error, FireworksTransportError) for error in errors):
+    # Usually the seconds after login before the network is up; the panel
+    # tries once more soon instead of waiting out its refresh interval.
+    record["retryAdvised"] = True
+
+  if any(isinstance(error, FireworksAuthError) for error in errors):
+    record["usageStatusText"] = "Sign-in expired"
+    record["authHelpText"] = "Fireworks rejected the API key. " + AUTH_HELP
+  elif "usage" in failed and usage_part is None:
+    record["usageStatusText"] = "Fireworks unavailable"
+    record["authHelpText"] = str(errors[0])
+  elif "balance" in failed and balance_part is None:
+    record["usageStatusText"] = "Balance unavailable"
+    record["authHelpText"] = str(errors[0])
+  elif errors:
+    record["authHelpText"] = str(errors[0])
+  return record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description="Print the Fireworks usage record as JSON")
+  parser.add_argument("--force", action="store_true", help="re-fetch usage and balance, ignoring caches")
+  parser.add_argument("--limits-only", action="store_true", help="reuse any recent usage answer; only the balance must be fresh")
+  parser.add_argument("--auth-path", default=os.environ.get("FIREWORKS_AUTH_PATH", "~/.fireworks/auth.ini"))
+  parser.add_argument("--api-base-url", default=os.environ.get("FIREWORKS_API_BASE_URL", API_BASE_URL))
+  args = parser.parse_args()
+
+  try:
+    record = scan(args.api_base_url, Path(args.auth_path).expanduser(), args.force, args.limits_only)
+  except Exception as error:
+    record = base_record(usageStatusText="Fireworks unavailable", authHelpText="Fireworks usage scan failed")
+    print(f"omarchy-agent-usage-fireworks: {type(error).__name__}", file=sys.stderr)
+  emit(record)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/grok.py b/shell/plugins/agents/usage/grok.py
--- a/shell/plugins/agents/usage/grok.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/grok.py	2026-11-18 13:32:49.500603773 +0000
@@ -0,0 +1,395 @@
+# omarchy:summary=Print the Grok usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Grok usage into one display-ready JSON record.
+
+The plan comes from the settings Grok caches from xAI, and the limit from the
+credits endpoint the Grok CLI itself reads for its /usage view, asked with
+each account's own sign-in. Sessions come from the summary Grok keeps beside
+each session, and tokens and prompts from its usage.json, the ledger `grok
+usage` prints: one entry per finished turn, with when it ended and its tokens
+by model. The agents panel only ever reads the JSON this prints.
+"""
+
+import argparse
+import json
+import math
+import os
+import re
+import sys
+import time
+import urllib.request
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  account_entry,
+  base_record,
+  cached_scan,
+  emit,
+  empty_bucket,
+  local_day,
+  obj,
+  open_json,
+  read_json,
+  registered_accounts,
+  scan_max_age,
+  token_count,
+)
+
+AGENT_ID = "grok"
+AGENT_NAME = "Grok"
+AUTH_HELP = "Start Grok, or run `grok login`, to sign in."
+CREDITS_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
+# A unified-billing account counts its usage against a monthly quota, which
+# the same endpoint answers without the credits format.
+MONTHLY_URL = "https://cli-chat-proxy.grok.com/v1/billing"
+# Grok's docs give a saved sign-in 30 days; a refresh token older than that
+# can't renew the access token, so it no longer counts as signed in.
+REFRESH_LIFETIME_SECONDS = 30 * 24 * 3600
+
+
+def parse_time(value):
+  try:
+    parsed = datetime.fromisoformat(str(value or "").replace("Z", "+00:00"))
+  except ValueError:
+    return None
+  return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
+
+
+# The home Grok uses when nothing selects an account: GROK_HOME when set,
+# as the CLI itself reads it, else ~/.grok.
+def default_home():
+  return Path(os.environ.get("GROK_HOME") or (Path.home() / ".grok"))
+
+
+# The local day a session or turn was active on, or None to skip it: a
+# missing time is no activity here, and one local_day() can't trust (out of
+# range, before 2000 or after 2100) counts nowhere. A time without a zone is
+# UTC, as parse_time() reads it.
+def active_day(value):
+  if value is None:
+    return None
+  parsed = parse_time(value) if isinstance(value, str) else None
+  return local_day(parsed.isoformat() if parsed else value)
+
+
+# Every session under <home>/sessions/<folder>/<session>/: its summary says
+# when it was last active, and its usage.json lists each finished turn with
+# its tokens by model, one turn per typed prompt. Added accounts link their
+# sessions to the primary's, so this covers all of them. Grok counts cached
+# input inside inputTokens; the record keeps the two apart, as the other
+# collectors do. Counts are read as every collector reads them: one that
+# isn't a plain number is no count.
+#
+# A fork's usage.json repeats its source's turns verbatim before its own, so
+# a turn already seen (same end time, same tokens) counts once. A subagent's
+# turns are tokens it spent, but its prompts came from the parent agent, not
+# the person typing. The summary's num_messages counts system and assistant
+# messages, inherited ones too, so it is no prompt count.
+def local_stats(home):
+  now = datetime.now().astimezone()
+  today = now.date().isoformat()
+  week = [(now.date() - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
+  prompts = sessions = today_sessions = today_prompts = today_tokens = 0
+  days = set()
+  by_day = {day: 0 for day in week}
+  today_by_model = {}
+  models = {}
+  seen = set()
+  for session in (Path(home) / "sessions").glob("*/*/"):
+    summary = read_json(session / "summary.json")
+    subagent = False
+    if isinstance(summary, dict):
+      subagent = str(summary.get("session_kind") or "").startswith("subagent")
+      day = active_day(summary.get("last_active_at"))
+      if day:
+        sessions += 1
+        days.add(day)
+        if day == today:
+          today_sessions += 1
+
+    usage = read_json(session / "usage.json")
+    turns = usage.get("turns") if isinstance(usage, dict) else None
+    for turn in turns if isinstance(turns, list) else []:
+      day = active_day(turn.get("endedAt")) if isinstance(turn, dict) else None
+      if not day:
+        continue
+      copy = json.dumps([turn.get("endedAt"), turn.get("modelUsage")], sort_keys=True, default=str)
+      if copy in seen:
+        continue
+      seen.add(copy)
+      days.add(day)
+      if not subagent:
+        prompts += 1
+        if day == today:
+          today_prompts += 1
+      for model, bucket in obj(turn.get("modelUsage")).items():
+        if not isinstance(bucket, dict):
+          continue
+        # Grok's totalTokens leaves cache writes out; counting them here keeps
+        # the day's total equal to the sum of its model's buckets.
+        cached = token_count(bucket.get("cachedReadTokens"))
+        uncached = max(0, token_count(bucket.get("inputTokens")) - cached)
+        output = token_count(bucket.get("outputTokens"))
+        created = token_count(bucket.get("cacheCreationTokens"))
+        tokens = uncached + cached + output + created
+        totals = models.setdefault(model, empty_bucket())
+        totals["inputTokens"] += uncached
+        totals["outputTokens"] += output
+        totals["cacheReadInputTokens"] += cached
+        totals["cacheCreationInputTokens"] += created
+        if day in by_day:
+          by_day[day] += tokens
+        if day == today:
+          today_tokens += tokens
+          today_by_model[model] = today_by_model.get(model, 0) + tokens
+
+  return {
+    "hasLocalStats": sessions > 0,
+    "todayPrompts": today_prompts,
+    "todaySessions": today_sessions,
+    "todayTotalTokens": today_tokens,
+    "todayTokensByModel": today_by_model,
+    "recentDays": [{"date": day, "messageCount": by_day[day]} for day in week],
+    "totalPrompts": prompts,
+    "totalSessions": sessions,
+    "activeDays": len(days),
+    "activeDates": sorted(days),
+    "modelUsage": models,
+  }
+
+
+# Cached per home and per day, and rebuilt under a lock, so overlapping runs
+# (the update command backgrounds one per agent while the panel refreshes on
+# its own) scan once between them.
+def cached_local_stats(home, max_age):
+  return cached_scan(AGENT_ID, [home], max_age, lambda: (local_stats(home), True))
+
+
+# One login per issuer in auth.json; the first is the CLI's own.
+def login(home):
+  auth = read_json(Path(home) / "auth.json")
+  if not isinstance(auth, dict):
+    return {}
+  return next((v for v in auth.values() if isinstance(v, dict)), {})
+
+
+def plan(home):
+  cached = read_json(Path(home) / "settings_cache.json")
+  try:
+    settings = obj(obj(json.loads(cached.get("payload") or "{}")).get("settings"))
+  except Exception:
+    return ""
+  return str(settings.get("subscription_tier_display") or "")
+
+
+# A percentage or amount from xAI's answer: a number, or a money field's
+# {"val": n}, whose val protobuf JSON leaves out when it's zero.
+def amount(value):
+  if isinstance(value, dict):
+    value = value.get("val") or 0
+  if isinstance(value, bool):
+    raise ValueError("not a number")
+  value = float(value)
+  # NaN would pass any clamp as 100%; a number that isn't one is no answer.
+  if not math.isfinite(value):
+    raise ValueError("not a number")
+  return value
+
+
+# The credits answer as one limit window: how much of this period's included
+# usage is gone, and when the period ends. The answer is protobuf JSON, which
+# leaves out a field holding zero, so a period with nothing used yet has no
+# percentage at all. A unified-billing account leaves it out too, its usage
+# counted against the monthly quota instead, so it has no window here (None);
+# and a period already over without one says nothing about this one.
+def credits_limit(data):
+  config = data["config"]
+  period = config["currentPeriod"]
+  ends = parse_time(period["end"])
+  used = config.get("creditUsagePercent")
+  if used is None:
+    if config.get("isUnifiedBillingUser") is True:
+      return None
+    if ends.timestamp() <= time.time():
+      raise ValueError("an ended period without a percentage")
+    used = 0
+  return {
+    "label": "Weekly" if "WEEK" in str(period.get("type")) else "Monthly",
+    "percent": max(0.0, min(1.0, amount(used) / 100)),
+    "resetsAt": ends.isoformat(),
+  }
+
+
+# The monthly answer as one limit window: how much of the month's included
+# quota is used, and when the billing period ends.
+def monthly_limit(data):
+  config = data["config"]
+  quota = amount(config["monthlyLimit"])
+  if quota <= 0:
+    raise ValueError("no monthly quota")
+  return {
+    "label": "Monthly",
+    "percent": max(0.0, min(1.0, amount(config["used"]) / quota)),
+    "resetsAt": parse_time(config["billingPeriodEnd"]).isoformat(),
+  }
+
+
+def collect_limits(home, key, force):
+  result = {"limits": [], "usageStatusText": "", "authHelpText": AUTH_HELP, "live": False, "fetchedAtMs": 0}
+  entry = login(home)
+  token = str(entry.get("key") or "")
+  if not token:
+    result["usageStatusText"] = "Waiting for auth"
+    return result
+
+  # A kept window whose reset has passed starts over empty. Its next reset is
+  # xAI's to say, so it stays unknown until a probe answers.
+  cache = LimitsCache(AGENT_ID, key)
+  fallback, result["fetchedAtMs"] = cache.kept()
+
+  expires = parse_time(entry.get("expires_at"))
+  if expires and expires.timestamp() <= time.time():
+    result["limits"] = fallback
+    # The access token lives six hours and Grok mints a new one from its
+    # refresh token whenever it starts, so a lapsed one is routine, not a
+    # sign-out: the limits are paused, the last numbers kept as stale, until
+    # Grok runs again. Only a refresh token past its 30 days is a sign-in to
+    # redo.
+    if entry.get("refresh_token") and time.time() - expires.timestamp() < REFRESH_LIFETIME_SECONDS:
+      result["usageStatusText"] = "Limits paused"
+      result["authHelpText"] = (
+        "Grok's access token has lapsed"
+        + (" — showing the last known limits." if fallback else ".")
+        + " Start Grok to refresh it; signing in again is not needed."
+      )
+    else:
+      result["usageStatusText"] = "Sign-in expired"
+      result["authHelpText"] = "Grok's saved sign-in expired. Start Grok to refresh it."
+    return result
+
+  # A panel opened and shut repeatedly reuses an answer this recent rather
+  # than asking xAI again.
+  if cache.fresh(force):
+    result.update(limits=fallback, live=True, authHelpText="")
+    return result
+
+  headers = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
+  limits = []
+  try:
+    credits = open_json(urllib.request.Request(CREDITS_URL, headers=headers), timeout=8)
+    weekly = credits_limit(credits)
+    if weekly is None:
+      limits = [monthly_limit(open_json(urllib.request.Request(MONTHLY_URL, headers=headers), timeout=8))]
+    else:
+      limits = [weekly]
+      # A unified-billing account can carry both: the weekly credits and the
+      # monthly included quota, which Grok's own /usage shows side by side.
+      # The weekly window stands on its own when the monthly one won't come.
+      if credits["config"].get("isUnifiedBillingUser") is True and weekly["label"] == "Weekly":
+        try:
+          limits.append(monthly_limit(open_json(urllib.request.Request(MONTHLY_URL, headers=headers), timeout=8)))
+        except Exception:
+          pass
+  except HttpError as error:
+    if error.status in (401, 403):
+      # The token was turned away before it lapsed: a sign-in to redo.
+      result["usageStatusText"] = "Sign-in expired"
+      result["authHelpText"] = "xAI refused Grok's saved sign-in. Start Grok, or run `grok login`, to sign in again."
+    elif error.status:
+      result["authHelpText"] = f"Grok's usage endpoint returned status {error.status}. Local Grok stats are still shown."
+    elif error.transport:
+      # No server answered at all (no route, no DNS, a timeout), often a
+      # network not up yet after login, so the panel asks again soon. Any real
+      # answer, an error status included, is a server to stop pestering.
+      result["retryAdvised"] = True
+      result["authHelpText"] = "Couldn't reach Grok's usage endpoint. Retrying shortly. Local Grok stats are still shown."
+    else:
+      result["authHelpText"] = "Grok's usage endpoint answered without a usable limit. Local Grok stats are still shown."
+  except Exception:
+    result["authHelpText"] = "Grok's usage endpoint answered without a usable limit. Local Grok stats are still shown."
+
+  if limits:
+    result.update(limits=limits, live=True, fetchedAtMs=cache.save(limits), authHelpText="")
+  else:
+    result["limits"] = fallback
+    if not result["usageStatusText"] and not result["limits"]:
+      result["usageStatusText"] = "Grok limits unavailable"
+  return result
+
+
+def home_of(account):
+  return Path(account.get("home") or (Path.home() / ".grok"))
+
+
+# Keyed by who the home is signed in as, so a home signed in to someone else
+# never shows the last one's numbers.
+def cache_key(home, fallback):
+  user = str(login(home).get("user_id") or "")
+  return re.sub(r"[^A-Za-z0-9_-]", "", user) or fallback
+
+
+def account_limits(account, force):
+  home = home_of(account)
+  limits = collect_limits(home, cache_key(home, account["id"]), force)
+  return account_entry(account, limits, plan(home))
+
+
+def main():
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  args = parser.parse_args()
+
+  registered = registered_accounts(AGENT_ID)
+  accounts = [account_limits(account, args.force) for account in registered]
+  current = next((a for a in accounts if a["active"]), None)
+  if current:
+    tier = current["plan"]
+    limits = current
+    stale, fetched_at = current["stale"], current["fetchedAt"]
+  else:
+    home = default_home()
+    tier = plan(home)
+    limits = collect_limits(home, cache_key(home, "main"), args.force)
+    stale, fetched_at = not limits["live"] and bool(limits["limits"]), limits["fetchedAtMs"]
+
+  # With accounts registered, the primary is ~/.grok by definition.
+  stats_home = Path.home() / ".grok" if accounts else default_home()
+  stats = cached_local_stats(stats_home, scan_max_age(args.force, args.limits_only))
+  # In use here once someone signed in or ran a session; otherwise an empty
+  # record, which the panel skips.
+  in_use = bool(accounts) or bool(login(stats_home)) or stats["totalSessions"] > 0
+  # A missing sign-in is only news where Grok has been set up: a machine
+  # with no Grok home at all says nothing.
+  if not in_use and not stats_home.exists() and not limits["limits"]:
+    limits = {"limits": [], "usageStatusText": "", "authHelpText": ""}
+    stale, fetched_at = False, 0
+  record = base_record(
+    AGENT_ID,
+    AGENT_NAME,
+    ready=in_use,
+    tierLabel=tier,
+    usageStatusText=limits["usageStatusText"],
+    authHelpText=limits["authHelpText"],
+    limits=limits["limits"],
+    limitsStale=stale,
+    limitsFetchedAt=fetched_at,
+  )
+  if limits.get("retryAdvised"):
+    record["retryAdvised"] = True
+  record.update(stats)
+  if accounts:
+    record["accountSwitch"] = registered[0]["switch"]
+    record["accounts"] = accounts
+  emit(record)
+
+
+if __name__ == "__main__":
+  main()
diff -ruN a/shell/plugins/agents/usage/grokbot.py b/shell/plugins/agents/usage/grokbot.py
--- a/shell/plugins/agents/usage/grokbot.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/grokbot.py	2026-11-18 13:32:49.501063806 +0000
@@ -0,0 +1,172 @@
+# omarchy:summary=Print the Grok Bot usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Grok Bot usage into one display-ready JSON record.
+
+Grok Bot runs on a Cursor account, but its weekly allowance is metered apart
+from Cursor's own plan: the dashboard's GetSandUsageStatus RPC (Sand is Grok
+Bot's internal name) says how much of this week's included usage is gone and
+when it resets. It is asked as the same account the Cursor collector reads,
+found the same way, so the two never describe different people. Grok Bot
+keeps nothing countable on disk, so the record carries the limit alone, and
+an account without a Grok Bot allowance gives an unused record, which the
+panel skips. The agents panel only ever reads the JSON this prints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+import urllib.request
+from datetime import datetime, timezone
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  account_key,
+  base_record,
+  cursor_token,
+  emit,
+  finite,
+  open_json,
+  token_lapsed,
+)
+
+AGENT_ID = "grokbot"
+AGENT_NAME = "Grok Bot"
+AUTH_HELP = "Sign in to the Cursor editor, or run `cursor-agent login`, with your Grok Bot account."
+USAGE_URL = "https://api2.cursor.sh/aiserver.v1.DashboardService/GetSandUsageStatus"
+
+
+def parse_time(value: Any) -> datetime | None:
+  try:
+    parsed = datetime.fromisoformat(str(value or "").replace("Z", "+00:00"))
+  except ValueError:
+    return None
+  return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
+
+
+# ------------------------------------------------------------------ limit
+
+
+def fetch_status(token: str) -> dict[str, Any]:
+  request = urllib.request.Request(
+    USAGE_URL,
+    data=b"{}",
+    headers={
+      "Content-Type": "application/json",
+      "Connect-Protocol-Version": "1",
+      "Authorization": f"Bearer {token}",
+      "x-cursor-client-type": "cli",
+    },
+    method="POST",
+  )
+  status = open_json(request, timeout=15)
+  if not isinstance(status, dict):
+    raise ValueError("not an object")
+  return status
+
+
+# The answer is protobuf JSON, which leaves out a field holding zero or
+# false: no included limit means no Grok Bot allowance on this account, and
+# a week with nothing used yet has no percentage at all.
+def weekly_limits(status: dict[str, Any]) -> list[dict[str, Any]]:
+  if status.get("hasNonZeroIncludedLimit") is not True:
+    return []
+  resets = parse_time(status.get("nextResetTimestampUtc"))
+  return [{
+    "label": "Weekly",
+    "percent": max(0.0, min(1.0, finite(status.get("usagePercent")) / 100)),
+    "resetsAt": resets.isoformat() if resets else "",
+  }]
+
+
+def collect(force: bool = False) -> dict[str, Any]:
+  record = base_record(AGENT_ID, AGENT_NAME, hasPromptStats=False)
+  # Without a sign-in there is no telling whether this account has Grok Bot
+  # at all, so the machine reads as not using it; the Cursor collector is the
+  # one that asks for a sign-in.
+  token = cursor_token()
+  if not token:
+    return record
+
+  cache = LimitsCache(AGENT_ID, account_key(token))
+  # A kept week that has ended is a fresh allowance, so it comes back at zero
+  # with no reset time until a check says when the next one ends. One with no
+  # known end is kept as it is.
+  kept = cache.limits
+  fetched_at = cache.fetched_at
+  kept_tier = str(cache.data.get("tierLabel") or "")
+
+  # A panel opened and shut repeatedly must not turn into a request per
+  # flick, so an answer this recent is the answer, even one saying the
+  # account has no Grok Bot.
+  if cache.fresh(force, allow_empty=True):
+    record.update(ready=bool(kept), tierLabel=kept_tier, limits=kept, limitsFetchedAt=fetched_at)
+    return record
+
+  retry = False
+  if token_lapsed(token):
+    status = "Limits paused"
+    detail = "Cursor's access token has lapsed. Open the Cursor editor, or run `cursor-agent`, to renew it; signing in again is not needed."
+  else:
+    try:
+      answer = fetch_status(token)
+      limits = weekly_limits(answer)
+    except HttpError as error:
+      if error.status in (401, 403):
+        status, detail = "Sign-in expired", "Cursor refused the saved sign-in. " + AUTH_HELP
+      elif error.status:
+        status, detail = "", f"Cursor's dashboard returned status {error.status}."
+      # No route, no DNS, refused, reset or timed out: nothing answered, so
+      # the panel tries again soon.
+      elif error.transport:
+        status, detail, retry = "", "Couldn't reach Cursor's dashboard. Retrying shortly.", True
+      # A reply cut short or one that isn't the expected JSON came from a
+      # server that answered.
+      else:
+        status, detail = "", "Cursor's dashboard sent a reply that couldn't be read."
+    except (ValueError, TypeError, AttributeError):
+      status, detail = "", "Cursor's dashboard sent a reply that couldn't be read."
+    else:
+      tier = str(answer.get("grokPlanLabel") or "")
+      # The cache only backs later runs; failing to keep it never costs this
+      # run's live answer.
+      record.update(ready=bool(limits), tierLabel=tier, limits=limits, limitsFetchedAt=cache.save(limits, tierLabel=tier))
+      return record
+
+  # A failed check keeps the last good limit, marked stale so the panel
+  # gives its age on hover. With nothing kept the record stays unused, so a
+  # Cursor account that never had Grok Bot doesn't appear on a blip.
+  record.update(
+    ready=bool(kept),
+    tierLabel=kept_tier if kept else "",
+    usageStatusText=status or ("" if kept else "Grok Bot limits unavailable"),
+    authHelpText=detail + (" Showing the last known limit." if kept else ""),
+    limits=kept,
+    limitsStale=True,
+    limitsFetchedAt=fetched_at if kept else 0,
+  )
+  if retry:
+    record["retryAdvised"] = True
+  return record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description="Print the Grok Bot usage record as JSON")
+  parser.add_argument("--force", action="store_true")
+  # Grok Bot has no local scan to reuse, so a near-limit refresh is a normal
+  # run; the flag keeps the invocation every collector takes.
+  parser.add_argument("--limits-only", action="store_true")
+  args = parser.parse_args()
+  emit(collect(force=args.force))
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/hermes.py b/shell/plugins/agents/usage/hermes.py
--- a/shell/plugins/agents/usage/hermes.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/hermes.py	2026-11-18 13:32:49.501553478 +0000
@@ -0,0 +1,277 @@
+# omarchy:summary=Print the Hermes Agent usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Hermes Agent usage into one display-ready JSON record.
+
+Everything the agents panel shows for Hermes is local session stats, read
+only from the state.db in Hermes' home (HERMES_HOME, else ~/.hermes) and in
+each named profile under its root's profiles/, and in ~/.hermes whole. Hermes
+has no subscription of its own, so the record has no limits.
+
+Tokens count under the provider that bills them, so this record holds what
+Hermes ran on Nous Portal, and what it ran before it recorded a route. A
+session sent to a server you run is the local collector's, which reads it
+through harness_rows(); one sent to any other provider is not counted here.
+
+Chat sessions that arrived over messaging gateways count too: Hermes treats
+them as first-class sessions and so does this record.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sqlite3
+import sys
+from datetime import datetime
+from pathlib import Path
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  NUMBER_CEILING,
+  Stats,
+  UsageRow,
+  base_record,
+  cached_scan,
+  claude_code_owner,
+  date_string,
+  emit,
+  local_day,
+  number,
+  scan_max_age,
+  url_host,
+)
+
+AGENT_ID = "hermes"
+AGENT_NAME = "Hermes"
+
+# Nous Portal's hosts (portal., inference-api., welcome-api.), the service
+# Nous Research, who make Hermes, bill.
+NOUS_HOST = "nousresearch.com"
+
+
+# Hermes' home is HERMES_HOME, its ~ and $VARs expanded, else
+# ~/.hermes<HERMES_DATA_DIR_SUFFIX>. Named profiles sit under the root's
+# profiles/: the default home, unless HERMES_HOME lies outside it, where a
+# <root>/profiles/<name> home makes <root> the root and any other home is its
+# own (hermes_constants.get_default_hermes_root). The root is the default
+# profile, so a profile home still counts the root's own state.db
+# (hermes_cli.profiles.list_profiles). The default home ~/.hermes is read
+# whatever the root, as before, and whole: its own state.db is its default
+# profile, beside its profiles/. A profile linked to the home counts once.
+def state_paths():
+  native = Path.home() / (".hermes" + os.environ.get("HERMES_DATA_DIR_SUFFIX", ""))
+  configured = os.environ.get("HERMES_HOME", "").strip()
+  home = Path(os.path.expanduser(os.path.expandvars(configured))) if configured else native
+  root = native
+  if not home.resolve().is_relative_to(native.resolve()):
+    root = home.parent.parent if home.parent.name == "profiles" else home
+  roots = dict.fromkeys((root, native, Path.home() / ".hermes"))
+  candidates = [home / "state.db", *(base / "state.db" for base in roots)]
+  for profiles in (base / "profiles" for base in roots):
+    if profiles.is_dir():
+      candidates.extend(sorted(path / "state.db" for path in profiles.iterdir() if path.is_dir()))
+
+  paths, seen = [], set()
+  for candidate in candidates:
+    if not candidate.is_file():
+      continue
+    resolved = candidate.resolve()
+    if resolved not in seen:
+      seen.add(resolved)
+      paths.append(candidate)
+  return paths
+
+
+# Hermes records where it sent each session and each request: the provider
+# it billed and the base URL it reached. Nous Portal, Hermes' own maker's
+# service, is Hermes'; any other URL is read the way every collector reads
+# Claude Code's (claude_code_owner): a provider's host is that provider's,
+# and a server you run is local's unless the model is a Claude or an Ollama
+# cloud one it only forwards. A gateway nothing here can place, or a
+# provider's own API no collector reads Hermes for (Anthropic's, OpenAI's),
+# is nobody's. A row from before Hermes kept the route ran where nothing
+# says, and stays Hermes', as every row was read before. A session Hermes
+# keeps routes for that recorded none never reached a provider, since Hermes
+# records the route with the first request it accounts, so no one bills it.
+def route_owner(provider, base_url, model):
+  url = str(base_url or "").strip()
+  if url:
+    host = url_host(url)
+    if host == NOUS_HOST or host.endswith("." + NOUS_HOST):
+      return AGENT_ID
+    return claude_code_owner(str(model or ""), url)
+  provider = str(provider or "").strip().lower()
+  return AGENT_ID if provider in ("", "nous") else None
+
+
+def columns(conn, table):
+  return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
+
+
+def route_columns(conn, table, alias):
+  """The route columns of a table, or NULLs where Hermes didn't keep them yet."""
+  if {"billing_provider", "billing_base_url"} <= columns(conn, table):
+    return f"{alias}.billing_provider, {alias}.billing_base_url"
+  return "NULL, NULL"
+
+
+# A column's sum over the rows whose count can be trusted: a negative row
+# would net out real usage, and text or a count past the ceiling is none.
+def trusted_sum(column):
+  return f"SUM(CASE WHEN typeof({column}) IN ('integer', 'real') AND {column} >= 0 AND {column} < {NUMBER_CEILING} THEN {column} ELSE 0 END)"
+
+
+# A time names a day only when it is a number that local_day trusts: SQLite
+# ranks text above every number, and a stray 1 is a damaged stamp, not a day
+# in 1970.
+def stamp_day(value):
+  return local_day(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else None
+
+
+def scan(path, owner):
+  """One state.db's rows that `owner` bills: a row per session, dated by its
+  start, with the tokens of each model it used and the prompts typed on each
+  day. A session counts where its route says, else where its first request
+  went, else nowhere when Hermes keeps routes and it made none."""
+  conn = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
+  try:
+    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
+    usage = []
+    # A Hermes that keeps no usage table yet still has its sessions and
+    # prompts to count.
+    if "session_model_usage" in tables:
+      usage = conn.execute(
+        """SELECT smu.session_id, smu.model, {}, {}, {}, {}, {}
+           FROM session_model_usage smu
+           GROUP BY 1, 2, 3, 4""".format(route_columns(conn, "session_model_usage", "smu"),
+                                         *(trusted_sum("smu." + column) for column in ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens")))
+      ).fetchall()
+    first_owner = {}
+    for session_id, model, provider, url, *_ in usage:
+      first_owner.setdefault(session_id, route_owner(provider, url, model))
+
+    model_column = "s.model" if "model" in columns(conn, "sessions") else "NULL"
+    session_routes = route_columns(conn, "sessions", "s")
+    unrouted = None if "session_model_usage" in tables and session_routes != "NULL, NULL" else AGENT_ID
+    sessions = {}
+    for session_id, started, model, provider, url in conn.execute(f"SELECT s.id, s.started_at, {model_column}, {session_routes} FROM sessions s"):
+      recorded = str(provider or "").strip() or str(url or "").strip()
+      sessions[session_id] = (stamp_day(started), route_owner(provider, url, model) if recorded else first_owner.get(session_id, unrouted))
+
+    rows = []
+    database = path.resolve()
+    key = lambda session_id: f"{database}:{session_id}"
+    for session_id, (day, billed) in sessions.items():
+      if billed == owner:
+        rows.append(UsageRow(day, key(session_id), "", "", 0, 0, 0, 0, prompts=0))
+
+    # Usage is kept per session and model, so a session's tokens land on the
+    # day it started.
+    for session_id, model, provider, url, *counts in usage:
+      if session_id not in sessions or route_owner(provider, url, model) != owner:
+        continue
+      # Counts from disk are untrusted: a negative, non-finite, absurdly
+      # large or non-numeric value counts as nothing.
+      counts = [number(count) for count in counts]
+      if sum(counts):
+        rows.append(UsageRow(sessions[session_id][0], key(session_id), str(provider or ""), str(model or "hermes"), *counts, prompts=0))
+
+    # A prompt from the future is no day's yet.
+    today = date_string(datetime.now())
+    for session_id, stamp, count in conn.execute(
+      "SELECT session_id, CASE WHEN typeof(timestamp) IN ('integer', 'real') THEN timestamp END, COUNT(*) FROM messages WHERE role = 'user' GROUP BY 1, 2"
+    ):
+      if sessions.get(session_id, (None, AGENT_ID))[1] != owner:
+        continue
+      day = stamp_day(stamp)
+      rows.append(UsageRow(day if day is not None and day <= today else None, key(session_id), "", "", 0, 0, 0, 0, prompts=count))
+    return rows
+  finally:
+    conn.close()
+
+
+def harness_sources():
+  return [path.resolve() for path in state_paths()]
+
+
+# What harness_rows() decided owners under, for cached_scan(match=...):
+# nothing beyond the databases, which record every route themselves.
+def harness_match():
+  return {}
+
+
+def scan_all(paths, owner):
+  """Every state.db's rows that `owner` bills, and the paths that couldn't
+  be read."""
+  rows, unreadable = [], []
+  for path in paths:
+    try:
+      rows.extend(scan(path, owner))
+    except sqlite3.Error as error:
+      unreadable.append(f"{path}: {error}")
+  return rows, unreadable
+
+
+def harness_rows(owner):
+  """Every state.db's rows that `owner` bills, and whether all were read."""
+  rows, unreadable = scan_all(state_paths(), owner)
+  return rows, not unreadable
+
+
+# The stats from every state.db, with the paths that couldn't be read.
+def collect_stats(paths):
+  stats = Stats()
+  rows, unreadable = scan_all(paths, AGENT_ID)
+  for row in rows:
+    stats.add_row(row, row.model)
+  return stats.snapshot(), unreadable
+
+
+# The scan is cached per day and per set of databases. A scan that couldn't
+# read every database isn't cached, so a scan served from the cache read them
+# all.
+def cached_stats(paths, max_age):
+  unreadable = []
+
+  def scan_all():
+    stats, missed = collect_stats(paths)
+    unreadable.extend(missed)
+    return stats, not missed
+
+  stats = cached_scan(AGENT_ID, [path.resolve() for path in paths], max_age, scan_all)
+  return stats, unreadable
+
+
+def collect(force=False, limits_only=False):
+  record = base_record(AGENT_ID, AGENT_NAME)
+
+  # No state.db: Hermes isn't used on this machine, which is not trouble --
+  # with sync on, another machine's Hermes still shows through its stats.
+  paths = state_paths()
+  if not paths:
+    return record
+
+  stats, unreadable = cached_stats(paths, scan_max_age(force, limits_only))
+  record.update(stats)
+  # Sessions all billed elsewhere leave Hermes nothing of its own to show.
+  record["hasLocalStats"] = bool(stats.get("modelUsage") or stats.get("totalSessions"))
+  record["ready"] = record["hasLocalStats"] or bool(unreadable)
+  if unreadable:
+    record["usageStatusText"] = "Hermes unavailable"
+    record["authHelpText"] = "Couldn't read Hermes' state.db (" + "; ".join(unreadable) + ")."
+  return record
+
+
+def main():
+  parser = argparse.ArgumentParser(description="Print the Hermes Agent usage record as JSON")
+  parser.add_argument("--force", action="store_true", help="rescan every state.db, ignoring the cache")
+  parser.add_argument("--limits-only", action="store_true", help="reuse any recent scan; Hermes has no limits to probe")
+  args = parser.parse_args()
+  emit(collect(args.force, args.limits_only))
+
+
+if __name__ == "__main__":
+  main()
