+
+# Kimi as pi, omp and opencode name it: the Kimi Code plan (pi's own
+# `kimi-coding` provider and omp's `kimi-code`, both api.kimi.com/coding/v1,
+# and models.dev's `kimi-code-plan-global` and `kimi-code-plan-cn`), and
+# Moonshot's pay-as-you-go API (pi's and opencode's `moonshotai` and
+# `moonshotai-cn`, omp's `moonshot`), which these limits don't meter but
+# which counts here, as Claude Code's turns to Moonshot do. Exact ids.
+PROVIDERS = ("kimi-coding", "kimi-code", "kimi-code-plan-global", "kimi-code-plan-cn", "moonshotai", "moonshotai-cn", "moonshot")
+
+
+def billed_here(provider: str, model: str, entry: dict) -> bool:
+  return provider in PROVIDERS
+
+
+# Kimi Code logs each agent of a session, subagents included, to its own
+# append-only sessions/<workspace>/<session>/agents/<agent>/wire.jsonl: a
+# usage.record for every model request it made, compactions included, the
+# input its user gave (turn.prompt, or turn.steer into a running turn), the
+# model alias an agent is bound to (profile.bind) and each request is sent on
+# (llm.request), answered or not, and, at the end of a fork's copy of its
+# source's records, a forked marker.
+WIRE_TYPES = (b'"usage.record"', b'"turn.prompt"', b'"turn.steer"', b'"forked"', b'"profile.bind"', b'"llm.request"')
+USAGE_FIELDS = ("inputOther", "output", "inputCacheRead", "inputCacheCreation")
+
+
+# What someone typed, as Kimi Code's isUserVisibleTurnInputRecord reads it,
+# less a shell command, which asks the model nothing.
+def typed(origin: dict[str, Any]) -> bool:
+  kind = origin.get("kind")
+  return kind == "user" or kind in ("skill_activation", "plugin_command") and origin.get("trigger") == "user-slash"
+
+
+def read_wire(path: Path) -> tuple[bool, list[tuple]]:
+  """Whether a wire.jsonl is a fork's, and its rows: ("u", key, day, model,
+  counts) for a request's usage, ("p", key, day) for a typed input, and
+  ("b", alias) and ("r", alias) for an alias bound and a request sent on
+  it. A usage or input row whose time can't be trusted is skipped."""
+  forked, rows = False, []
+  with path.open("rb") as handle:
+    for raw in handle:
+      if not any(marker in raw for marker in WIRE_TYPES):
+        continue
+      try:
+        record = json.loads(raw)
+      except (ValueError, RecursionError):
+        continue
+      if not isinstance(record, dict):
+        continue
+      kind, time_ms = record.get("type"), record.get("time")
+      if kind == "forked":
+        forked = True
+        continue
+      alias = record.get("modelAlias")
+      if kind in ("profile.bind", "llm.request") and isinstance(alias, str) and alias.strip():
+        rows.append(("b" if kind == "profile.bind" else "r", alias.strip()))
+        continue
+      day = local_day(time_ms) if isinstance(time_ms, (int, float)) else None
+      if day is None:
+        continue
+      if kind == "usage.record":
+        model = record.get("model")
+        usage = obj(record.get("usage"))
+        counts = tuple(token_count(usage.get(field)) for field in USAGE_FIELDS)
+        if isinstance(model, str) and model.strip() and sum(counts) > 0:
+          # A fork copies its source's records as they were, so a record's
+          # agent, time, model and counts together name it.
+          rows.append(("u", (str(record.get("agentId")), time_ms, model, counts), day, model.strip(), counts))
+      elif kind in ("turn.prompt", "turn.steer") and typed(obj(record.get("origin"))):
+        key = record.get("promptId" if kind == "turn.prompt" else "messageId")
+        if not isinstance(key, str) or not key:
+          key = (str(record.get("agentId")), time_ms)
+        rows.append(("p", (kind, key), day))
+  return forked, rows
+
+
+# A usage.record names the model alias it ran on, and config.toml says where
+# that alias goes: its [models.<alias>] provider, whose type and base_url
+# (else the *_BASE_URL in the provider's env table) name the endpoint, unless
+# the model carries a base_url of its own. A provider with no base_url is its
+# type's official endpoint: Kimi's for a `kimi` one, no collector's for
+# Anthropic's, OpenAI's or Google's.
+def code_routes() -> dict[str, tuple[str, str, str]]:
+  """model alias -> (provider type, base URL, model id), from Kimi Code's
+  config.toml."""
+  try:
+    with (code_home() / "config.toml").open("rb") as handle:
+      config = tomllib.load(handle)
+  except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
+    return {}
+  providers, models = obj(config.get("providers")), obj(config.get("models"))
+  routes = {}
+  for alias, model in models.items():
+    model = obj(model)
+    provider = obj(providers.get(str(model.get("provider") or "")))
+    env = obj(provider.get("env"))
+    url = model.get("base_url") if model.get("protocol") else None
+    url = url or provider.get("base_url") or next((value for key, value in env.items() if str(key).endswith("_BASE_URL")), "")
+    routes[str(alias)] = (str(provider.get("type") or ""), str(url or "").strip(), str(model.get("model") or alias))
+  return routes
+
+
+# The prefix of the aliases /login provisions for the Kimi Code plan
+# (managedModelKey).
+MANAGED_PREFIX = "kimi-code/"
+
+
+def route_owner(alias: str, routes: dict[str, tuple[str, str, str]]) -> str | None:
+  """The collector that bills a request on `alias`, or None for one nothing
+  here can place. A base URL is read the way every collector reads Claude
+  Code's (claude_code_owner): a provider's host is that provider's, and a
+  server you run is local's, unless the model is a Claude or an Ollama cloud
+  one it only forwards. Kimi Code sends nothing on an alias config.toml
+  doesn't name, so one missing from it is either Kimi's own, the alias
+  KIMI_MODEL_NAME makes up for a run (no provider prefix) or one of the
+  plan's `kimi-code/` models /logout or a catalog refresh dropped, or a
+  provider's since removed, which nothing here can place."""
+  if alias not in routes:
+    return AGENT_ID if "/" not in alias or alias.startswith(MANAGED_PREFIX) else None
+  kind, url, model = routes[alias]
+  if url:
+    return claude_code_owner(model, url)
+  return AGENT_ID if kind == "kimi" else None
+
+
+def harness_sources() -> list[Path]:
+  return [code_home()]
+
+
+def harness_match() -> dict[str, str]:
+  """What harness_rows() decided owners under, for cached_scan(match=...):
+  config.toml's routes, so a scan made before a route changed never stands in
+  for one after it, in this collector or in local."""
+  routes = json.dumps(sorted(code_routes().items()))
+  return {"kimiCodeRoutes": hashlib.sha256(routes.encode("utf-8", "surrogatepass")).hexdigest()[:16]}
+
+
+def harness_rows(owner: str) -> tuple[list[UsageRow], bool]:
+  """Kimi Code's usage that `owner` bills, each request counted once though
+  forks copy them, with each typed prompt as a row of its own billed with the
+  next request sent for it, answered or not, else with the alias its agent
+  was bound to, and whether every session was read. A prompt in a log that
+  names neither, from before Kimi Code recorded them, is Kimi Code's own."""
+  routes = code_routes()
+  complete = True
+  wires = []
+  for path in sorted((code_home() / "sessions").glob("*/*/agents/*/wire.jsonl")):
+    try:
+      forked, rows = read_wire(path)
+    except OSError as exc:
+      warn(f"skipping {path}: {type(exc).__name__}")
+      complete = False
+      continue
+    wires.append((forked, path, rows))
+  # A source's rows go to the source's session, not to a fork read first.
+  wires.sort(key=lambda wire: wire[0])
+  seen = set()
+  found = []
+  for _, path, rows in wires:
+    session = path.parents[2].name
+    bound, unanswered = AGENT_ID, []
+    for row in rows:
+      if row[0] == "b":
+        bound = route_owner(row[1], routes)
+      unanswered.append(bound)
+    requested, answered = False, None
+    owners = []
+    for row, fallback in zip(reversed(rows), reversed(unanswered)):
+      if row[0] in ("u", "r"):
+        requested, answered = True, route_owner(row[3] if row[0] == "u" else row[1], routes)
+      owners.append(answered if requested else fallback)
+    for row, billed in zip(rows, reversed(owners)):
+      if row[0] not in ("u", "p") or (row[0], row[1]) in seen:
+        continue
+      seen.add((row[0], row[1]))
+      if billed != owner:
+        continue
+      if row[0] == "u":
+        found.append(UsageRow(row[2], session, "", row[3], *row[4], prompts=0))
+      else:
+        found.append(UsageRow(row[2], session, "", "", 0, 0, 0, 0))
+  return found, complete
+
+
+def scan(reuse: bool = True) -> tuple[dict[str, Any], bool]:
+  """Kimi Code's usage and typed prompts on Kimi's routes, pi, omp and
+  opencode sessions on the Kimi Code plan, Claude Code's turns on Kimi
+  (pointed at Kimi's or Moonshot's API, or answered by a Kimi model) and
+  MiniMax Code's custom providers at those hosts, and whether every session
+  was read."""
+  stats = Stats()
+  code_rows, complete = harness_rows(AGENT_ID)
+  for row in code_rows:
+    stats.add_row(row, row.model)
+  routed_rows, routed_complete = scan_routed(AGENT_ID, reuse)
+  pi_rows, pi_complete = scan_pi_sessions(r'"provider"\s*:\s*"(' + "|".join(PROVIDERS) + r')"', billed_here)
+  # The database's prefilter matches every plan id.
+  db_rows, db_complete = scan_opencode(["kimi-cod", "moonshot"], billed_here)
+  for row in routed_rows + pi_rows + db_rows:
+    stats.add_row(row, row.model.rstrip("/").split("/")[-1] or AGENT_ID)
+  return stats.snapshot(), complete and routed_complete and pi_complete and db_complete
+
+
+# Keyed by the credential store, the endpoint, and the token, so another
+# sign-in or another Kimi service never shows this one's quota.
+def limits_cache(key: str) -> LimitsCache:
+  return LimitsCache(AGENT_ID, str(CREDENTIALS_PATH), USAGE_URL, key)
+
+
+def has_credential() -> bool:
+  return bool(os.environ.get("KIMI_API_KEY", "").strip() or read_credentials().get("access_token"))
+
+
+# Kimi counts as in use on this machine when it has a credential or a Kimi
+# home of its own, where Kimi Code keeps its sessions: a home without a
+# sign-in is waiting for one, while a machine with neither never ran Kimi.
+def in_use() -> bool:
+  if has_credential() or CREDENTIALS_PATH.exists():
+    return True
+  if home := os.environ.get("KIMI_CODE_HOME"):
+    return Path(home).expanduser().is_dir()
+  return (Path.home() / ".kimi-code").is_dir() or legacy_home().is_dir()
+
+
+def failure_record(error: Exception, cache: LimitsCache | None) -> dict[str, Any]:
+  # A kept window whose reset has passed comes back at zero, with no reset
+  # time until Kimi names the next one.
+  fallback, fetched_at = cache.kept() if cache else ([], 0)
+  help_text = str(error) if isinstance(error, KimiError) else "Kimi usage scan failed"
+  if isinstance(error, KimiError) and error.missing or not has_credential():
+    status, help_text = "Waiting for auth", AUTH_HELP
+  elif isinstance(error, KimiError) and error.refused:
+    status = "Sign-in expired"
+  elif fallback:
+    # A failed check that kept the last good limits isn't trouble to flag;
+    # limitsStale and the age on hover say the rest.
+    status = ""
+  else:
+    status = "Kimi limits unavailable"
+  record = base_record(
+    ready=True,
+    usageStatusText=status,
+    authHelpText=help_text,
+    limits=fallback,
+    limitsStale=bool(fallback),
+    limitsFetchedAt=fetched_at,
+  )
+  if isinstance(error, KimiError) and error.retry:
+    record["retryAdvised"] = True
+  return record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description="Print the Kimi usage record as JSON")
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  args = parser.parse_args()
+
+  # The digest covers Kimi Code's home, so another home never reuses this
+  # one's numbers, pi's and omp's session roots and opencode's database, and
+  # Claude Code's and MiniMax Code's sessions, whose owner depends on where
+  # they are sent, as Kimi Code's does on its routes.
+  sources = [code_home(), *pi_session_roots(), opencode_db(), *routed_sources()]
+  # A forced scan reads every Codex rollout again too.
+  max_age = scan_max_age(args.force, args.limits_only)
+  stats = cached_scan(AGENT_ID, sources, max_age, lambda: scan(reuse=max_age > 0), match={**routed_match(), **harness_match()})
+  if not in_use() and not stats.get("modelUsage") and not stats.get("totalPrompts"):
+    emit(base_record())
+    return 0
+
+  cache = None
+  auth = {}
+  try:
+    key = api_key(auth)
+    if not key:
+      raise KimiError(AUTH_HELP, missing=True)
+    cache = limits_cache(key)
+    if not cache.fetched_at and auth.get("previous_key"):
+      # A refresh just rotated the token: the last answer under the old one
+      # is still this account's, so it moves to the new key.
+      previous = limits_cache(auth["previous_key"])
+      if previous.fetched_at:
+        try:
+          write_json(cache.path, previous.data)
+        except OSError:
+          pass
+        cache.reload()
+    # A plan without windows is an answer too, and stands in like one.
+    if cache.fresh(args.force, allow_empty=True):
+      limits, fetched_at = cache.limits, cache.fetched_at
+    else:
+      limits = to_limits(quota(key))
+      fetched_at = cache.save(limits)
+    record = base_record(ready=True, limits=limits, limitsFetchedAt=fetched_at)
+  except Exception as error:
+    if (cache is None or not cache.fetched_at) and auth.get("key"):
+      cache = limits_cache(auth["key"])
+    record = failure_record(error, cache)
+  record.update(stats)
+  record["hasLocalStats"] = bool(stats.get("modelUsage") or stats.get("totalSessions"))
+  emit(record)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/local.py b/shell/plugins/agents/usage/local.py
--- a/shell/plugins/agents/usage/local.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/local.py	2026-11-18 13:32:49.509448330 +0000
@@ -0,0 +1,315 @@
+# omarchy:summary=Print the self-hosted model usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect self-hosted model usage into one display-ready JSON record.
+
+Every other collector counts what a subscription or a provider bills. This
+one counts the turns that ran on hardware you own: Codex CLI pointed at
+Ollama, opencode on a local gateway, pi on llama.cpp, Kimi Code, Qwen Code,
+Hermes or Mistral Vibe on a server of your own, whether the endpoint is this
+machine or a box down the hall. It is the exact complement of the
+provider collectors: a provider id another collector counts is never counted
+here, and the Codex collector's own `openai` rollouts never are either.
+
+A provider is self-hosted when it is a well-known local runtime, an id named
+in ~/.config/omarchy/agents/local.json, or a Codex model_providers entry whose
+base_url is on a loopback, private, link-local or LAN address:
+
+    {"providers": ["homelab", "my-gateway"]}
+
+Ollama's cloud models (a `:cloud` or `-cloud` tag) run on Ollama's servers
+even when the local daemon fronts them, so they are never counted here, and
+nor are opencode's google rows on antigravity- models, which the agy
+collector counts. There
+are no limits and no balance: the meter on self-hosted work is the
+electricity bill. The agents panel only ever reads the JSON this prints.
+"""
+
+import argparse
+import importlib.machinery
+import importlib.util
+import json
+import os
+import re
+import sys
+from pathlib import Path
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  Stats,
+  base_record,
+  cached_scan,
+  cloud_model,
+  codex_home,
+  codex_native_key,
+  codex_native_routed,
+  codex_rollout_cache,
+  codex_provider_urls,
+  codex_route_owner,
+  codex_rollouts,
+  config_home,
+  emit,
+  number,
+  opencode_db,
+  pi_session_roots,
+  read_json,
+  routed_match,
+  routed_sources,
+  scan_max_age,
+  scan_opencode,
+  scan_pi_sessions,
+  scan_routed,
+  self_hosted,
+  warn,
+)
+
+AGENT_ID = "local"
+AGENT_NAME = "Local models"
+
+# Runtimes that serve models from your own hardware, for provider ids with no
+# URL to classify: opencode and pi record the id but not the endpoint, and
+# Codex's built-in `--oss` providers have no config.toml entry.
+KNOWN_LOCAL_PROVIDERS = {
+  "gpt4all", "jan", "koboldcpp", "llama-cpp", "llamacpp", "llamafile",
+  "lm-studio", "lmstudio", "local", "localai", "mlx", "ollama",
+  "openai-local", "oss", "sglang", "tabby", "text-generation-webui", "vllm",
+}
+
+# Provider ids the provider collectors count whole, from pi, omp and opencode,
+# each the exact id that collector's filter matches. A local.json naming one
+# of them would count its tokens twice, so they are never local, whatever the
+# configuration says: the claiming collector wins. Each collector's own
+# provider list must be a subset of this one; agent-usage-partition-test.sh
+# fails when an id is added there and not here. Two more are claimed only for some models, and only
+# those rows are left out: Ollama's cloud-tagged models (cloud_model) and
+# opencode's Antigravity plugin (antigravity_row).
+CLAIMED_PROVIDERS = {
+  "anthropic",  # claude
+  "deepseek",  # deepseek
+  "devin",  # devin
+  "fireworks", "fireworks-ai",  # fireworks, which counts the whole account
+  "kimi-coding", "kimi-code", "kimi-code-plan-global", "kimi-code-plan-cn",  # kimi
+  "moonshotai", "moonshotai-cn", "moonshot",  # kimi
+  "google-antigravity",  # agy, pi's Antigravity sign-in
+  "kimchi", "kimchi-dev", "kimchi-experimental",  # kimchi
+  "meta", "muse-code",  # muse
+  "minimax", "minimax-cn", "minimax-coding-plan", "minimax-cn-coding-plan",  # minimax
+  "mistral",  # vibe
+  "ollama-cloud",  # ollama
+  "openai", "openai-codex",  # codex
+  "opencode", "opencode-go",  # opencode
+  "openrouter",  # openrouter
+  "alibaba-coding-plan", "alibaba-coding-plan-cn", "alibaba-token-plan", "alibaba-token-plan-cn",  # qwen
+  "qwen-token-plan", "qwen-token-plan-cn", "qwen-token-plan-individual", "qwen-portal",  # qwen
+  "synthetic",  # synthetic
+  "zai", "zhipu", "zai-coding-cn", "zai-coding-plan",  # zai
+  "zhipu-coding-plan", "zhipuai", "zhipuai-coding-plan",  # zai
+}
+
+# Ids a collector claims by prefix rather than whole: Kimchi 1.18 names each
+# gateway route kimchi-dev/<upstream>, and kimchi counts every one.
+CLAIMED_PREFIXES = ("kimchi-dev/",)  # kimchi
+
+def model_name(raw):
+  return str(raw or "").strip() or AGENT_ID
+
+
+# --------------------------------------------------------- classification
+
+
+def config_path():
+  return config_home() / "omarchy" / "agents" / "local.json"
+
+
+def configured_providers():
+  names = read_json(config_path()).get("providers")
+  if not isinstance(names, list):
+    return set()
+  return {str(name).strip().lower() for name in names if isinstance(name, str) and name.strip()}
+
+
+def antigravity_row(provider, model):
+  # opencode's Antigravity plugin runs under a "google" provider with model
+  # ids it prefixes with antigravity-; the agy collector counts exactly
+  # those opencode rows, and every other google model stays local's to count
+  # when local.json names it.
+  return str(provider or "").strip().lower().startswith("google") and str(model or "").startswith("antigravity-")
+
+
+class Classifier:
+  def __init__(self):
+    self.configured = configured_providers()
+    # Every Codex provider's base_url, remembered past config.toml
+    # dropping it.
+    self.endpoints = codex_provider_urls()
+    ids = set(KNOWN_LOCAL_PROVIDERS) | self.configured
+    ids |= {pid for pid, url in self.endpoints.items() if url and self_hosted(url) and not codex_native_key(pid)}
+    self.local_ids = {pid for pid in ids - CLAIMED_PROVIDERS if not pid.startswith(CLAIMED_PREFIXES)}
+
+  def provider_is_local(self, provider):
+    return str(provider or "").strip().lower() in self.local_ids
+
+  def accepts(self, provider, model):
+    return self.provider_is_local(provider) and not cloud_model(model)
+
+  def fingerprint(self):
+    return sorted(self.local_ids)
+
+
+CLASSIFIER = None
+
+
+def classifier():
+  global CLASSIFIER
+  if CLASSIFIER is None:
+    CLASSIFIER = Classifier()
+  return CLASSIFIER
+
+
+def pi_pattern():
+  ids = "|".join(re.escape(pid) for pid in sorted(classifier().local_ids))
+  return r'(?i)"provider"\s*:\s*"(?:' + ids + ')"'
+
+
+def accept_pi(provider, model, message):
+  # The Codex collector also counts any message on its openai-codex API,
+  # whatever the provider id says.
+  if str(message.get("api") or "").startswith("openai-codex"):
+    return False
+  return classifier().accepts(provider, model)
+
+
+def accept_opencode(provider, model, entry):
+  return classifier().accepts(provider, model) and not antigravity_row(provider, model)
+
+
+# --------------------------------------------------- harnesses of their own
+
+# Kimi Code, Qwen Code, Hermes and Mistral Vibe keep their sessions in stores
+# of their own. Each one's collector reads its store and says who bills each
+# row (harness_rows), from the route Hermes and older Vibe sessions record
+# or, for Kimi Code, Qwen Code and Vibe's Unified Harness, from the current
+# config, so this one takes the rows a server you run answered from the same
+# reader.
+HARNESSES = ("hermes", "kimi", "qwen", "vibe")
+
+
+def harness(name):
+  # The harness collectors are modules beside this one (usage/<name>.py).
+  return importlib.import_module(f"usage.{name}")
+
+
+HARNESS_MODULES = {}
+
+
+def harness_modules():
+  if not HARNESS_MODULES:
+    HARNESS_MODULES.update((name, harness(name)) for name in HARNESSES)
+  return HARNESS_MODULES
+
+
+def scan_harnesses(stats):
+  complete = True
+  for name, module in harness_modules().items():
+    try:
+      rows, read = module.harness_rows(AGENT_ID)
+    except Exception as exc:
+      # One harness's reader failing costs only its rows.
+      warn(f"could not read {name} sessions ({type(exc).__name__}: {exc})")
+      complete = False
+      continue
+    complete = complete and read
+    for row in rows:
+      stats.add_row(row, model_name(row.model))
+  return complete
+
+
+def harness_sources():
+  return [source for module in harness_modules().values() for source in module.harness_sources()]
+
+
+# Each harness's route config decides which of its rows are self-hosted, and
+# can change without its store changing, so a scan is kept only while every
+# harness still classifies the way it did.
+def harness_match():
+  match = {}
+  for name, module in harness_modules().items():
+    try:
+      match.update(module.harness_match())
+    except Exception as exc:
+      warn(f"could not read {name}'s routes ({exc})")
+      match[f"{name}Routes"] = "unreadable"
+  return match
+
+
+# ------------------------------------------------------------------- Codex
+
+
+
+def scan_codex(stats, use_file_cache):
+  endpoints = classifier().endpoints
+  records, complete = codex_rollouts(codex_rollout_cache(), reuse=use_file_cache, native=codex_native_routed(endpoints))
+  for record in records.values():
+    for day, models in record["days"].items():
+      for model, (input_tokens, output_tokens, cache_read, cache_write, prompts) in models.items():
+        # A provider's host, or Ollama Cloud, bills the rollouts
+        # codex_route_owner() places, whatever the provider's id, and it
+        # gives the built-in provider's to this one while openai_base_url
+        # is self-hosted.
+        owner = codex_route_owner(record["provider"], model, endpoints)
+        if owner == "local" or (owner is None and classifier().provider_is_local(record["provider"]) and not cloud_model(model)):
+          # A Codex rollout's totals arrive per day and model, prompts
+          # counted, under the session that started it.
+          stats.add(day, record["session"], model, input_tokens, output_tokens, cache_read, cache_write, prompts=prompts)
+  return complete
+
+
+# -------------------------------------------------------------- scan cache
+
+
+def scan_sources():
+  # Every path the scan reads, and which providers it counts as local, so a
+  # changed local.json or Codex config is a new scan rather than a stale one.
+  return [Path.home(), codex_home(), opencode_db(), *pi_session_roots(), *routed_sources(), *harness_sources(), json.dumps(classifier().fingerprint())]
+
+
+def run_local_scans(max_age):
+  stats = Stats()
+  complete = scan_codex(stats, use_file_cache=max_age > 0)
+  pi_rows, pi_complete = scan_pi_sessions(pi_pattern(), accept_pi)
+  # The closing quote makes the database's prefilter match the whole id.
+  db_rows, db_complete = scan_opencode([pid + '"' for pid in sorted(classifier().local_ids)], accept_opencode)
+  # Claude Code pointed at a self-hosted endpoint, for the models that ran
+  # there, and MiniMax Code's custom providers on one.
+  routed_rows, routed_complete = scan_routed(AGENT_ID)
+  for row in pi_rows + db_rows + routed_rows:
+    stats.add_row(row, model_name(row.model))
+  harnesses_complete = scan_harnesses(stats)
+  return stats.snapshot(), complete and pi_complete and db_complete and routed_complete and harnesses_complete
+
+
+# ------------------------------------------------------------------ record
+
+
+def main():
+  parser = argparse.ArgumentParser(description="Print the self-hosted model usage record as JSON")
+  # There are no limits to fetch, so --limits-only only means a redraw may
+  # reuse an older scan.
+  parser.add_argument("--force", action="store_true", help="rescan every session, ignoring caches")
+  parser.add_argument("--limits-only", action="store_true", help="reuse a recent scan")
+  args = parser.parse_args()
+
+  max_age = scan_max_age(args.force, args.limits_only)
+  stats = cached_scan(AGENT_ID, scan_sources(), max_age, lambda: run_local_scans(max_age), match={**routed_match(), **harness_match()})
+  # Self-hosted work has no plan, no limits and no balance.
+  in_use = number(stats.get("totalSessions")) > 0
+  record = base_record(AGENT_ID, AGENT_NAME, ready=in_use, hasLocalStats=in_use)
+  record.update(stats)
+  emit(record, sort_keys=True)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/minimax.py b/shell/plugins/agents/usage/minimax.py
--- a/shell/plugins/agents/usage/minimax.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/minimax.py	2026-11-18 13:32:49.503869065 +0000
@@ -0,0 +1,472 @@
+# omarchy:summary=Print the MiniMax Token Plan usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect MiniMax usage into a display-ready JSON record.
+
+The 5-hour session and weekly windows come from MiniMax's Token Plan API with
+the key MiniMax's own `mmx` CLI, opencode, or pi saved. Each credential's last
+good limits are cached, so a failed check keeps showing them, marked stale,
+rather than dropping the section.
+
+Local stats come from MiniMax Code's own session files, and from pi/omp and
+opencode sessions that ran on a MiniMax provider. The agents panel only ever
+reads the JSON this prints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import sys
+import urllib.request
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  Stats,
+  base_record as shared_base_record,
+  cached_scan,
+  data_home,
+  emit,
+  open_json,
+  opencode_db,
+  pi_session_roots,
+  read_json,
+  routed_match,
+  routed_sources,
+  scan_max_age,
+  scan_opencode,
+  scan_pi_sessions,
+  scan_routed,
+  trusted_endpoint,
+  warn,
+)
+
+AGENT_ID = "minimax"
+AGENT_NAME = "MiniMax"
+DEFAULT_BASE_URL = "https://api.minimax.io"
+CN_BASE_URL = "https://api.minimaxi.com"
+AUTH_HELP = "Set MINIMAX_API_KEY, or sign in to MiniMax in opencode, to show Token Plan limits."
+AUTH_HELP_BAD_KEY = "MiniMax rejected the saved credentials. Set MINIMAX_API_KEY, or sign in to MiniMax again with `mmx` or opencode."
+# The plan the quota endpoint describes: only a Token Plan has these windows.
+TIER_LABEL = "Token Plan"
+# The pi/omp and opencode provider names MiniMax bills, by region. Exact
+# names: a custom gateway in front of MiniMax is not this account.
+PROVIDERS = ("minimax", "minimax-cn", "minimax-coding-plan", "minimax-cn-coding-plan")
+# base_resp codes MiniMax answers a bad key with: 1004 is an authentication
+# failure, 2049 an invalid API key.
+AUTH_STATUS_CODES = {1004, 2049}
+# The quota rows for MiniMax's media models ride on allowances of their own
+# (video and image generation, speech, vision) and are not the coding plan.
+MEDIA_MODEL_WORDS = ("video", "image", "audio", "vision")
+
+
+class MiniMaxError(Exception):
+  def __init__(self, message: str, transport: bool = False, rejected: bool = False) -> None:
+    super().__init__(message)
+    self.transport = transport
+    self.rejected = rejected
+
+
+def base_record(**overrides: Any) -> dict[str, Any]:
+  return shared_base_record(AGENT_ID, AGENT_NAME, **overrides)
+
+
+def limits_cache_paths(api_key: str, base_url: str) -> tuple[Path, Path]:
+  # Keyed by the credential and the host it signs in to: another key, or the
+  # same key in the other region, never shows this one's allowance.
+  cache = LimitsCache(AGENT_ID, base_url.rstrip("/"), api_key)
+  return cache.path, cache.lock_path
+
+
+# --------------------------------------------------------------------------
+# Credentials
+# --------------------------------------------------------------------------
+
+def mmx_config_dir() -> Path:
+  return Path(os.path.expandvars(os.path.expanduser(os.environ.get("MMX_CONFIG_DIR", "~/.mmx"))))
+
+
+def mmx_config() -> dict[str, Any]:
+  config_dir = mmx_config_dir()
+  parsed = read_json(config_dir / "config.json")
+  if parsed:
+    return parsed
+
+  # Older mmx releases documented YAML configuration. Only read the one scalar
+  # we need, avoiding a runtime YAML dependency in the base installation.
+  try:
+    for line in (config_dir / "config.yaml").read_text(encoding="utf-8").splitlines():
+      key, separator, value = line.partition(":")
+      if separator and key.strip() == "api_key":
+        return {"api_key": value.strip().strip("'\"")}
+  except Exception:
+    pass
+  return {}
+
+
+def config_key(config: dict[str, Any]) -> str:
+  value = config.get("api_key") or config.get("apiKey")
+  if isinstance(value, str) and value.strip():
+    return value.strip()
+
+  oauth = config.get("oauth")
+  if isinstance(oauth, dict):
+    token = oauth.get("access_token")
+    if isinstance(token, str) and token.strip():
+      return token.strip()
+  return ""
+
+
+def config_base_url(config: dict[str, Any]) -> str:
+  """The host mmx itself asks: its base_url, then the OAuth session's
+  resource_url, then the region (MINIMAX_REGION over the saved one)."""
+  oauth = config.get("oauth")
+  oauth = oauth if isinstance(oauth, dict) else {}
+  for value in (config.get("base_url"), oauth.get("resource_url")):
+    if isinstance(value, str) and value.strip():
+      return value.strip()
+  # mmx refuses a region it doesn't know; here one just doesn't decide.
+  for region in (os.environ.get("MINIMAX_REGION"), config.get("region"), oauth.get("region")):
+    if region in ("cn", "global"):
+      return CN_BASE_URL if region == "cn" else DEFAULT_BASE_URL
+  return DEFAULT_BASE_URL
+
+
+def pi_agent_dir() -> Path:
+  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
+  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"
+
+
+def saved_key(path: Path, providers: tuple[str, ...]) -> tuple[str, str]:
+  """(key, provider) for the first provider `path` holds a literal key for."""
+  parsed = read_json(path)
+  for provider in providers:
+    entry = parsed.get(provider)
+    if isinstance(entry, dict):
+      value = entry.get("key") or entry.get("apiKey") or entry.get("token")
+      # A pi `$VAR` or `!command` entry is resolved by pi alone.
+      if isinstance(value, str) and value.strip() and not value.strip().startswith(("!", "$")):
+        return value.strip(), provider
+  return "", ""
+
+
+def credentials() -> tuple[str, str]:
+  """(key, host). A key only answers on its own region's host, so the host
+  follows wherever the key came from: mmx's region applies to mmx's key
+  alone. MINIMAX_BASE_URL overrides any of them."""
+  override = os.environ.get("MINIMAX_BASE_URL", "").strip()
+  env_key = os.environ.get("MINIMAX_API_KEY", "").strip()
+  if env_key:
+    return env_key, override or (CN_BASE_URL if os.environ.get("MINIMAX_REGION") == "cn" else DEFAULT_BASE_URL)
+
+  config = mmx_config()
+  if mmx_key := config_key(config):
+    return mmx_key, override or config_base_url(config)
+
+  # The key opencode or pi signed in to MiniMax with; a China-region
+  # provider's key only answers on the China host.
+  for path in (data_home() / "opencode" / "auth.json", pi_agent_dir() / "auth.json", Path.home() / ".omp" / "agent" / "auth.json"):
+    # Only the provider ids MiniMax bills: a key saved under any other
+    # name belongs to a gateway, and is never sent to MiniMax.
+    api_key, provider = saved_key(path, PROVIDERS)
+    if api_key:
+      return api_key, override or (CN_BASE_URL if provider.startswith("minimax-cn") else DEFAULT_BASE_URL)
+  return "", override or DEFAULT_BASE_URL
+
+
+# --------------------------------------------------------------------------
+# Token Plan limits
+# --------------------------------------------------------------------------
+
+def number(value: Any) -> float | None:
+  # Booleans are ints to Python; neither they nor NaN or infinity are numbers
+  # the quota API meant.
+  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+    return None
+  return float(value)
+
+
+def reset_at(entry: dict[str, Any], end_key: str, remains_key: str) -> str:
+  try:
+    end_ms = number(entry.get(end_key))
+    if end_ms and end_ms > 0:
+      return datetime.fromtimestamp(end_ms / 1000, timezone.utc).isoformat()
+    # Without an end time MiniMax still says how long the window has left,
+    # which places its own reset rather than guessing one.
+    remains_ms = number(entry.get(remains_key))
+    if remains_ms and remains_ms > 0:
+      return (datetime.now(timezone.utc) + timedelta(milliseconds=remains_ms)).isoformat()
+  except (OverflowError, OSError, ValueError):
+    pass
+  return ""
+
+
+def used_fraction(remaining: Any) -> float | None:
+  percent = number(remaining)
+  if percent is None:
+    return None
+  return max(0.0, min(1.0, 1.0 - percent / 100.0))
+
+
+def is_media_row(row: dict[str, Any]) -> bool:
+  name = str(row.get("model_name") or "").strip().lower()
+  return any(word in name for word in MEDIA_MODEL_WORDS)
+
+
+# current_*_status per window: 1 normal, 2 exhausted, 3 unlimited.
+STATUS_EXHAUSTED = 2
+STATUS_UNLIMITED = 3
+
+
+def not_in_plan(row: dict[str, Any]) -> bool:
+  """The shape mmx shows as "not in plan": both windows unlimited with
+  nothing allotted, a model the plan doesn't cover rather than a full one."""
+  return (
+    number(row.get("current_interval_total_count")) == 0 and number(row.get("current_weekly_total_count")) == 0
+    and number(row.get("current_interval_status")) == STATUS_UNLIMITED and number(row.get("current_weekly_status")) == STATUS_UNLIMITED
+  )
+
+
+def window_used(row: dict[str, Any], percent_key: str, status_key: str) -> float | None:
+  status = number(row.get(status_key))
+  # MiniMax's own status outranks the percentage: an exhausted window may
+  # omit it or keep a stale one, and an unlimited one has nothing to fill.
+  if status == STATUS_EXHAUSTED:
+    return 1.0
+  if status == STATUS_UNLIMITED:
+    return None
+  return used_fraction(row.get(percent_key))
+
+
+def quota_limits(payload: dict[str, Any]) -> list[dict[str, Any]]:
+  rows = payload.get("model_remains")
+  if not isinstance(rows, list):
+    raise MiniMaxError("MiniMax returned no Token Plan quotas")
+
+  # "general" is the language/agent quota. Without it the first row that
+  # isn't a media model's stands for the plan. A model outside the plan is
+  # never it.
+  rows = [row for row in rows if isinstance(row, dict) and not not_in_plan(row)]
+  general = next((row for row in rows if row.get("model_name") == "general"), None)
+  if general is None:
+    general = next((row for row in rows if not is_media_row(row)), None)
+  if general is None:
+    raise MiniMaxError("MiniMax returned no usable Token Plan quota")
+
+  limits = []
+  interval = window_used(general, "current_interval_remaining_percent", "current_interval_status")
+  weekly = window_used(general, "current_weekly_remaining_percent", "current_weekly_status")
+  if interval is not None:
+    limits.append({
+      "label": "Session (5-hour)",
+      "percent": interval,
+      "resetsAt": reset_at(general, "end_time", "remains_time"),
+    })
+  if weekly is not None:
+    limits.append({
+      "label": "Weekly (7-day)",
+      "percent": weekly,
+      "resetsAt": reset_at(general, "weekly_end_time", "weekly_remains_time"),
+    })
+  if not limits:
+    raise MiniMaxError("MiniMax returned no percentage-based Token Plan quotas")
+  return limits
+
+
+def fetch_quota(api_key: str, base_url: str) -> dict[str, Any]:
+  endpoint = base_url.rstrip("/") + "/v1/token_plan/remains"
+  # MINIMAX_BASE_URL, --base-url and mmx's own base_url or resource_url move
+  # the endpoint, never the key onto a connection anyone on the way can read.
+  if not trusted_endpoint(endpoint):
+    raise MiniMaxError("The MiniMax endpoint must use HTTPS (plain HTTP only for loopback); the key was not sent.")
+  request = urllib.request.Request(
+    endpoint,
+    headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
+  )
+  try:
+    payload = open_json(request, timeout=12)
+  except HttpError as error:
+    if error.status in (401, 403):
+      raise MiniMaxError(AUTH_HELP_BAD_KEY, rejected=True) from error
+    if 300 <= error.status < 400:
+      # A redirect would carry the bearer to whatever host it names.
+      raise MiniMaxError("MiniMax's quota endpoint redirected elsewhere; the key was not sent on.") from error
+    if error.status:
+      raise MiniMaxError(f"MiniMax's quota endpoint returned HTTP {error.status}.") from error
+    if error.transport:
+      # No answer from any server: no route, no DNS, a timeout, a reset.
+      raise MiniMaxError("Couldn't reach the MiniMax API. Retrying shortly.", transport=True) from error
+    raise MiniMaxError("MiniMax returned an invalid quota response.") from error
+
+  if not isinstance(payload, dict):
+    raise MiniMaxError("MiniMax returned an invalid quota response.")
+  base_response = payload.get("base_resp")
+  if isinstance(base_response, dict):
+    code = number(base_response.get("status_code"))
+    if code not in (None, 0):
+      if int(code) in AUTH_STATUS_CODES:
+        raise MiniMaxError(AUTH_HELP_BAD_KEY, rejected=True)
+      message = str(base_response.get("status_msg") or "MiniMax rejected the quota request")[:200]
+      raise MiniMaxError(message)
+  return payload
+
+
+def collect_limits(api_key: str, base_url: str, force: bool) -> dict[str, Any]:
+  """Fresh limits when a probe is due, else the last known ones.
+
+  `live` says whether the limits are this check's (or a probe recent enough
+  to stand in for one), and `fetchedAtMs` when they were measured.
+  """
+  result = {"limits": [], "usageStatusText": "", "authHelpText": "", "retryAdvised": False, "live": False, "fetchedAtMs": 0}
+  # Keyed by the credential and the host it signs in to: another key, or the
+  # same key in the other region, never shows this one's allowance.
+  cache = LimitsCache(AGENT_ID, base_url.rstrip("/"), api_key)
+
+  # --force is a person asking for fresh numbers, so it skips the reuse
+  # window; the interval absorbs repeated panel opens, not a refresh press.
+  if cache.fresh(force):
+    result.update(limits=cache.limits, live=True, fetchedAtMs=cache.fetched_at)
+    return result
+
+  with cache.lock():
+    if not force:
+      # Another run may have probed while this one waited for the lock.
+      cache.reload()
+      if cache.fresh(force):
+        result.update(limits=cache.limits, live=True, fetchedAtMs=cache.fetched_at)
+        return result
+    try:
+      limits = quota_limits(fetch_quota(api_key, base_url))
+    except MiniMaxError as error:
+      failure = error
+    except Exception as error:
+      # An answer shaped like nothing expected is still a failed check: the
+      # kept limits stand.
+      failure = MiniMaxError(f"MiniMax's quota check failed ({type(error).__name__}).")
+    else:
+      result.update(limits=limits, live=True, fetchedAtMs=cache.save(limits))
+      return result
+
+  # A transport failure reached no server — typically the seconds after login
+  # before the network is up — so ask the shell to retry sooner. A kept
+  # window whose reset has passed comes back at zero.
+  fallback, fetched_at = cache.kept()
+  result["retryAdvised"] = failure.transport
+  result["authHelpText"] = str(failure)
+  if fallback:
+    result.update(limits=fallback, fetchedAtMs=fetched_at)
+  if failure.rejected:
+    result["usageStatusText"] = "Sign-in expired"
+  elif not fallback:
+    result["usageStatusText"] = "MiniMax limits unavailable"
+  return result
+
+
+# --------------------------------------------------------------------------
+# Local session stats
+# --------------------------------------------------------------------------
+
+# pi, omp, and opencode name the provider alike. Exact names: a custom
+# gateway in front of MiniMax is not this account.
+def billed_here(provider: str, model: str, entry: dict) -> bool:
+  return provider in PROVIDERS
+
+
+def scan_sessions(reuse: bool = True) -> tuple[dict[str, Any], bool]:
+  stats = Stats()
+  # Every source runs, so one unreadable source still leaves the others.
+  # MiniMax Code on MiniMax's own routes or a custom provider at MiniMax's
+  # host, and Claude Code pointed at MiniMax or answered by a MiniMax model.
+  routed_rows, routed_complete = scan_routed(AGENT_ID, reuse)
+  for row in routed_rows:
+    stats.add_row(row, row.model or "minimax")
+  pattern = r'"provider"\s*:\s*"(' + "|".join(PROVIDERS) + r')"'
+  pi_rows, pi_complete = scan_pi_sessions(pattern, billed_here)
+  for row in pi_rows:
+    # pi counts each assistant turn as the prompt that asked for it.
+    stats.add_row(row, row.model or "minimax")
+  # The database's prefilter matches every MiniMax provider id.
+  db_rows, db_complete = scan_opencode(["minimax"], billed_here)
+  for row in db_rows:
+    stats.add_row(row, row.model.rstrip("/").split("/")[-1] or "minimax")
+  return stats.snapshot(), routed_complete and pi_complete and db_complete
+
+
+def cached_local_stats(max_age_seconds: float) -> dict[str, Any]:
+  # The digest covers every data path the scan reads.
+  sources = [opencode_db(), *pi_session_roots(), *routed_sources()]
+  # A forced scan reads every Codex rollout again too.
+  return cached_scan(AGENT_ID, sources, max_age_seconds, lambda: scan_sessions(reuse=max_age_seconds > 0), match=routed_match())
+
+
+# --------------------------------------------------------------------------
+# Record
+# --------------------------------------------------------------------------
+
+# Nobody using MiniMax here: an empty record, which the panel skips. With a
+# key, a failed check keeps the last good limits, marked stale; without one,
+# local usage still shows and the limits wait for a key.
+def collect(api_key: str, base_url: str, force: bool = False, stats: dict[str, Any] | None = None) -> dict[str, Any]:
+  record = base_record()
+  if stats:
+    record.update(stats)
+  has_stats = bool(record["modelUsage"]) or record["totalPrompts"] > 0
+  record["hasLocalStats"] = has_stats
+
+  if not api_key:
+    if has_stats:
+      record.update(ready=True, usageStatusText="Waiting for auth", authHelpText=AUTH_HELP)
+    return record
+
+  limits = collect_limits(api_key, base_url, force)
+  record.update(
+    ready=True,
+    tierLabel=TIER_LABEL if limits["limits"] else "",
+    limits=limits["limits"],
+    limitsStale=bool(limits["limits"]) and not limits["live"],
+    limitsFetchedAt=limits["fetchedAtMs"],
+    usageStatusText=limits["usageStatusText"],
+    authHelpText=limits["authHelpText"],
+  )
+  if limits["retryAdvised"]:
+    record["retryAdvised"] = True
+  return record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description="Print the MiniMax usage record as JSON")
+  # --force rescans and re-probes, ignoring both caches. --limits-only reuses
+  # a recent local scan (only the limits probe must be fresh); a bare run
+  # reuses a scan only long enough to dedup concurrent collector runs.
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  parser.add_argument("--base-url")
+  args = parser.parse_args()
+
+  try:
+    stats = cached_local_stats(scan_max_age(args.force, args.limits_only))
+  except Exception as error:
+    # Local stats are an addition; their failure must not cost the limits.
+    warn(f"local scan failed ({type(error).__name__})")
+    stats = None
+
+  try:
+    api_key, saved_base_url = credentials()
+    record = collect(api_key, args.base_url or saved_base_url, args.force, stats)
+  except Exception as error:
+    record = base_record(usageStatusText="MiniMax limits unavailable", authHelpText="MiniMax usage scan failed.")
+    warn(type(error).__name__)
+  emit(record, sort_keys=True)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/muse.py b/shell/plugins/agents/usage/muse.py
--- a/shell/plugins/agents/usage/muse.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/muse.py	2026-11-18 13:32:49.504620787 +0000
@@ -0,0 +1,754 @@
+# omarchy:summary=Print the Muse (Meta) usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Muse (Meta Muse Spark) local usage plus subscription windows.
+
+Local metering (always available, no network): token counts, prompt and
+session counts, per-day and per-model breakdowns. Sources (all local):
+  - native `muse` CLI sessions in $XDG_DATA_HOME/muse/sessions, defaulting to
+    ~/.local/share/muse/sessions (`model_completed` events carry usage),
+    with the real prompt and session counts from the CLI's own
+    session-index.db beside them when it is there,
+  - opencode sessions with providerID == "meta" (any Muse Spark model).
+    Muse Spark served through OpenCode Zen (providerID == "opencode") is
+    Zen usage, and the opencode record counts it.
+  - pi/omp sessions on the `meta` provider, or omp's `muse-code` (its Muse
+    Code sign-in), in every session root (profiles and PI_CODING_AGENT_DIR
+    included).
+
+Subscription windows (additive, authoritative only): when the CLI is signed
+in via `muse login`, the collector probes the client's own key endpoint
+(`POST https://api.meta.ai/muse-code/key` with the OAuth token from
+`MUSE_AUTH_PATH`, else `~/.config/muse/auth.json`) for `subs_usage`
+session (5-hour) + weekly percents with reset times plus `subs_tier_name` —
+the same figures the TUI's `/usage` overlay shows. Minting is idempotent so
+polling is safe; the token travels only in the Authorization header and
+neither it nor the returned API key is persisted, and the login file is only
+ever read, never refreshed or rewritten. A failed check keeps the last good
+windows, marked stale. Pay-as-you-go accounts
+and active plans that return no `subs_usage` (e.g. Muse Code Power Usage)
+have no subscription windows, so limits stay empty — the plan name (none for
+pay-as-you-go) plus local metering still show. No estimated meters from manual caps: without an
+authoritative probe the panel shows measured usage only. The agents panel
+only ever reads the JSON this prints.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import sqlite3
+import sys
+import time
+import urllib.request
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  Stats,
+  account_key,
+  base_record,
+  cache_root,
+  cached_scan,
+  config_home,
+  data_home,
+  emit,
+  now_ms,
+  number,
+  open_json,
+  opencode_db,
+  pi_session_roots,
+  read_json,
+  scan_max_age,
+  scan_opencode,
+  scan_pi_sessions,
+  token_count,
+  trusted_endpoint,
+  warn,
+  write_json,
+)
+
+AGENT_ID = "muse"
+AGENT_NAME = "Muse"
+
+# Model ids and session files are read from local data but flow into the
+# panel JSON, so bound them: overlong model names fail the row closed, and
+# symlinked or gigantic session files are skipped instead of followed.
+MAX_MODEL_NAME_LEN = 120
+MAX_SESSION_BYTES = 512 * 1024 * 1024
+
+# What the scan counts, stored beside the shared scan cache's own version and
+# required to match on reuse. Bump when the counting changes so old caches
+# are rescanned instead of trusted. 3: prompts and sessions from the session
+# index. 4: pi/omp sessions counted. 5: native sessions the index hasn't seen
+# counted. 6: today's prompts from what each session's count grew by today.
+# 7: a child's calls known only from the session's usage attribution.
+CACHE_SCHEMA_VERSION = 7
+
+
+def key_endpoint() -> str:
+  # Overridable for tests, which point it at a local stub instead of Meta's
+  # key service.
+  return os.environ.get("MUSE_KEY_ENDPOINT") or "https://api.meta.ai/muse-code/key"
+
+
+def percent_number(value):
+  if isinstance(value, bool):
+    return -1.0
+  try:
+    parsed = float(value)
+  except (TypeError, ValueError):
+    return -1.0
+  return min(1.0, max(0.0, parsed / 100.0)) if math.isfinite(parsed) else -1.0
+
+
+def model_name(raw):
+  value = str(raw or "muse-spark").rstrip("/").split("/")[-1]
+  if not value:
+    value = "muse-spark"
+  # Model ids flow into the panel JSON: cap the length so a crafted session
+  # file or DB row cannot bloat the record or the UI. Callers skip the row
+  # when this returns None (fail closed).
+  if len(value) > MAX_MODEL_NAME_LEN:
+    return None
+  return value
+
+
+# Muse's own stores date rows in microseconds, which the shared reader of pi
+# and opencode times doesn't expect, and Muse can't have written before 2000
+# or from the future.
+def local_day(value):
+  """Normalize assorted timestamps to a local YYYY-MM-DD date string.
+
+  A stamp that isn't a plausible moment (missing, zero, negative, NaN, a
+  bool, far future, not a time at all) gives None, so the caller can fall
+  back or leave the row undated rather than file it under today.
+  """
+  if value is None or isinstance(value, bool):
+    return None
+  if isinstance(value, (int, float)):
+    seconds = float(value)
+    if not math.isfinite(seconds) or seconds <= 0:
+      return None
+    # Native muse recorded_at is microseconds; opencode created is millis;
+    # codex-style seconds also possible.
+    if seconds > 10_000_000_000_000:
+      seconds = seconds / 1_000_000
+    elif seconds > 10_000_000_000:
+      seconds = seconds / 1000
+  else:
+    text = str(value).strip()
+    try:
+      # Some writers emit the epoch as a string: route micro/milli/second
+      # magnitudes through the numeric branch instead of misfiling them.
+      return local_day(float(text))
+    except ValueError:
+      pass
+    try:
+      dt = datetime.fromisoformat(text[:-1] + "+00:00" if text.endswith("Z") else text)
+      # A zoneless time at the edge of the calendar (year 1 or 9999) can't
+      # be placed in a zone off UTC.
+      if dt.tzinfo is None:
+        dt = dt.astimezone()
+      seconds = dt.timestamp()
+    except (OverflowError, OSError, ValueError):
+      return None
+  # Muse didn't exist before 2000 and can't write from the future.
+  if not 946_684_800 <= seconds <= time.time() + 2 * 86_400:
+    return None
+  try:
+    return datetime.fromtimestamp(seconds).astimezone().date().isoformat()
+  except (OverflowError, OSError, ValueError):
+    return None
+
+
+def muse_data_dir():
+  override = (os.environ.get("MUSE_DATA_DIR") or "").strip()
+  if override:
+    return Path(os.path.expandvars(os.path.expanduser(override)))
+  return data_home() / "muse"
+
+
+# The Muse CLI keeps one row per session in session-index.db with the number
+# of prompts typed into it, the real counts a completion tally can only
+# approximate (one prompt can run many model calls). Returns the ids of the
+# sessions the index has a row for, empty without an index, and whether it
+# could be read: an index that's there but unreadable falls back on
+# completions without caching that scan. A session nobody prompted isn't
+# counted, and a row whose creation time isn't a plausible moment counts in
+# the totals only.
+def scan_session_index(stats):
+  database = muse_data_dir() / "session-index.db"
+  if not database.is_file():
+    return set(), True
+  try:
+    conn = sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
+  except sqlite3.Error:
+    return set(), False
+  try:
+    conn.execute("PRAGMA query_only = ON")
+    rows = conn.execute("SELECT session_id, created_at_us, prompt_count FROM sessions").fetchall()
+  except sqlite3.Error:
+    return set(), False
+  finally:
+    try:
+      conn.close()
+    except Exception:
+      pass
+  indexed = {str(session_id) for session_id, _, _ in rows}
+  counts, created = {}, {}
+  for session_id, created_at_us, prompt_count in rows:
+    prompts = token_count(prompt_count)
+    if not prompts:
+      continue
+    session_id = str(session_id)
+    counts[session_id] = prompts
+    # created_at_us is microseconds, which local_day recognises by size.
+    created[session_id] = local_day(created_at_us)
+  grown = prompts_today(database, counts, {key for key, day in created.items() if day == stats.today}, stats.today)
+  for session_id, prompts in counts.items():
+    # A session's prompts land on the day it was created, which may be
+    # unknown, apart from today's, which are what its count grew by today.
+    today_prompts = grown.get(session_id, 0)
+    stats.add_prompts(created[session_id], "muse-index:" + session_id, prompts - today_prompts)
+    if today_prompts:
+      stats.add_prompts(stats.today, "muse-index:" + session_id, today_prompts)
+  return indexed, True
+
+
+# The index keeps a session's running prompt count and the day it was
+# created, not when each prompt came, so a session carried on from an
+# earlier day would put every prompt on the day it began. Today's prompts are
+# instead what each count grew by since the last scan before today, which
+# this collector keeps in a file of its own; a session created today counts
+# whole. A session from before today that no earlier scan saw counts from
+# when it is first seen, since nothing says when its earlier prompts came;
+# so does every session after a gap of days since the last scan.
+def prompts_today(database, counts, created_today, today):
+  digest = hashlib.sha1(str(database).encode("utf-8")).hexdigest()[:16]
+  path = cache_root() / f"muse-prompts-{digest}.json"
+  kept = read_json(path)
+  day = kept.get("day") if isinstance(kept.get("day"), str) else ""
+  if day == today:
+    start = kept.get("start")
+  elif day == (date.fromisoformat(today) - timedelta(days=1)).isoformat():
+    start = kept.get("last")
+  else:
+    # Never scanned, kept from a clock that went back, or from before a gap
+    # of days: what a count grew by since then wasn't all typed today.
+    start = None
+  start = {str(key): token_count(value) for key, value in start.items()} if isinstance(start, dict) else {}
+  for session_id, prompts in counts.items():
+    if session_id not in start and session_id not in created_today:
+      start[session_id] = prompts
+  try:
+    write_json(path, {"day": today, "start": start, "last": counts})
+  except Exception as exc:
+    warn(f"could not keep the session prompt counts ({exc})")
+  grown = {}
+  for session_id, prompts in counts.items():
+    added = prompts - start.get(session_id, 0)
+    if added > 0:
+      grown[session_id] = added
+  return grown
+
+
+def muse_sessions_root():
+  return muse_data_dir() / "sessions"
+
+
+def iter_native_events(path):
+  """Yield (event_dict, recorded_at, event_id) tuples from a native session.jsonl file.
+
+  Handles both plain event lines and retained_frame wrappers whose children
+  carry record_json payloads. A file that can't be read raises OSError, so
+  the scan knows it is incomplete.
+  """
+  with path.open(errors="replace") as handle:
+    for raw in handle:
+      # Session logs run to hundreds of megabytes, mostly lines without
+      # usage. Only completions ("usage", escaped or not inside a
+      # retained frame) and the model records ("model_id") matter, so
+      # everything else skips the JSON parse.
+      if "usage" not in raw and "model_id" not in raw:
+        continue
+      raw = raw.strip()
+      if not raw:
+        continue
+      try:
+        entry = json.loads(raw)
+      except Exception:
+        continue
+      if not isinstance(entry, dict):
+        continue
+      candidates = [entry]
+      children = entry.get("children")
+      if isinstance(children, list):
+        for child in children:
+          if not isinstance(child, dict):
+            continue
+          nested = child.get("record_json")
+          if not nested:
+            continue
+          try:
+            parsed = json.loads(nested)
+          except Exception:
+            continue
+          if isinstance(parsed, dict):
+            candidates.append(parsed)
+      for event in candidates:
+        payload = event.get("payload") or {}
+        if not isinstance(payload, dict):
+          continue
+        yield payload, event.get("recorded_at"), event.get("id")
+
+
+# A session's log credits every billed run to its owner in a
+# goal_usage_attribution record: the main agent, and each child it ran, such
+# as the reminder agents that watch a prompt. Most children keep a log of
+# their own, whose completions are counted from it, but some (a skill
+# reminder among them) leave nothing but this record, the only trace of the
+# calls they made. Returns (input, output, cache read, cache write) for such a
+# child's record, once per usage id, and None for every other.
+def attributed_usage(record, logged, seen):
+  if not isinstance(record, dict):
+    return None
+  owner = record.get("owner") if isinstance(record.get("owner"), dict) else {}
+  quantity = record.get("quantity") if isinstance(record.get("quantity"), dict) else {}
+  owner_id = owner.get("owner_id")
+  usage_id = record.get("usage_id")
+  if not isinstance(owner_id, str) or owner.get("owner_type") == "main_root" or owner_id in logged:
+    return None
+  if quantity.get("unit") != "tokens" or quantity.get("reported") is False:
+    return None
+  if not isinstance(usage_id, str) or not usage_id or usage_id in seen:
+    return None
+  input_tokens = token_count(quantity.get("input_tokens"))
+  cache_read = min(input_tokens, token_count(quantity.get("cached_tokens")))
+  output_tokens = token_count(quantity.get("output_tokens"))
+  if not (input_tokens or output_tokens):
+    return None
+  seen.add(usage_id)
+  return input_tokens - cache_read, output_tokens, cache_read, 0
+
+
+def scan_native_muse_sessions(stats, indexed=frozenset()):
+  """Add native Muse session completions. Returns whether every session file
+  was read (safe to cache); a deliberately skipped one doesn't count."""
+  root = muse_sessions_root()
+  if not root.exists():
+    return True
+  # Full history, no mtime cutoff: all-time totals and active days need every
+  # session still on disk (the same tradeoff the claude collector makes).
+  # Session files are small JSONL and the scan cache dedups concurrent runs,
+  # so each refresh pays one linear pass at most.
+  try:
+    resolved_root = root.resolve()
+  except OSError:
+    return False
+  files = []
+  try:
+    # Session views contain copies of the same history. Check only paths
+    # below the sessions root, so a custom data parent is not excluded.
+    files = [p for p in root.rglob("session.jsonl")
+             if not any(part.startswith(".msp-view") for part in p.relative_to(root).parts[:-1])
+             and p.is_file()]
+  except OSError:
+    return False
+  complete = True
+  seen_event_ids = set()
+  # Every agent with a log of its own: a session and each subagent are named
+  # by their ids, so a child attributed usage without one is found here.
+  logged = {p.parent.name for p in files}
+  seen_usage_ids = set()
+  for path in files:
+    try:
+      # Fail closed on entries that could escape the sessions tree or stall
+      # the scan: symlinked files are never followed (even when their target
+      # sits inside the tree, so a link cannot double-count a session), files
+      # reached via a symlinked directory are rejected by the resolve check,
+      # and gigantic files are skipped.
+      if path.is_symlink():
+        continue
+      if not path.resolve().is_relative_to(resolved_root):
+        continue
+      st = path.stat()
+      if st.st_size > MAX_SESSION_BYTES:
+        continue
+      mtime_day = local_day(st.st_mtime)
+    except OSError:
+      complete = False
+      continue
+    # Session directories are named by the index's session id, and subagent
+    # trees roll up into their parent session: normalize both the main
+    # session.jsonl and any subagent/.../session.jsonl to the session
+    # directory, so one user session counts once however many subagents it
+    # spawned.
+    session_dir = re.sub(r"(/subagent/.*)?/session\.jsonl$", "", str(path))
+    counted = Path(session_dir).name not in indexed
+    current_model = ""
+    try:
+      for payload, recorded_at, event_id in iter_native_events(path):
+        kind = payload.get("kind")
+        if kind == "metadata":
+          record = payload.get("record") or {}
+          if isinstance(record, dict) and record.get("model_id"):
+            current_model = model_name(record.get("model_id"))
+          continue
+        if kind == "run_model":
+          record = payload.get("record") or {}
+          if isinstance(record, dict) and record.get("model_id"):
+            current_model = model_name(record.get("model_id"))
+          continue
+        # Older logs wrap a completion as payload kind "run"; current ones
+        # (record_type "event", payload_type "runtime.session") carry the event
+        # with no payload kind at all.
+        if kind not in ("run", None):
+          continue
+        event = payload.get("event") or {}
+        if not isinstance(event, dict):
+          continue
+        if event.get("kind") == "goal_usage_attribution":
+          attributed = attributed_usage(event.get("record"), logged, seen_usage_ids)
+          model = model_name(current_model) if current_model is not None else None
+          if attributed and model:
+            # A child's calls, on the session's model, answer no prompt.
+            stats.add(local_day(recorded_at) or mtime_day, "muse:" + session_dir if counted else None, model,
+                      *attributed, prompts=0)
+          continue
+        if event.get("kind") != "model_completed":
+          continue
+        usage = event.get("usage") or {}
+        if not isinstance(usage, dict):
+          continue
+        raw_model = event.get("model")
+        # An oversized metadata model is an explicit rejection, not a reason to
+        # silently put the following completion in the generic fallback bucket.
+        if not raw_model and current_model is None:
+          continue
+        model = model_name(raw_model or current_model)
+        if model is None:
+          continue
+        input_tokens = token_count(usage.get("input_tokens"))
+        # Native Muse reports reasoning as a subset of output_tokens.
+        output_tokens = token_count(usage.get("output_tokens"))
+        # Cached tokens are a subset of input: keep the split without double
+        # counting (same convention as the codex collector), and never let a
+        # cache figure claim more than the input it is part of.
+        cache_read = min(input_tokens, token_count(usage.get("cache_read_tokens", usage.get("cached_tokens"))))
+        cache_write = min(input_tokens - cache_read, token_count(usage.get("cache_write_tokens")))
+        input_tokens = input_tokens - cache_read - cache_write
+        if not (input_tokens or output_tokens or cache_read or cache_write):
+          continue
+        # Native record IDs survive copies and retained-frame wrapping. Claim
+        # only valid completions: metadata or malformed usage must not suppress
+        # a later usable record. Missing/malformed IDs cannot identify duplicates.
+        if isinstance(event_id, str) and event_id:
+          if event_id in seen_event_ids:
+            continue
+          seen_event_ids.add(event_id)
+        # An unusable stamp falls back on the file's own time.
+        day = local_day(recorded_at) or mtime_day
+        # A session the index has no row for yet counts its completions as
+        # prompts, as it would with no index at all. One it has a row for
+        # supplied its real prompt and session counts already: its tokens
+        # still count, but a completion is a model call, not a prompt, and its
+        # session is the index's. An undated completion counts in the totals
+        # only.
+        stats.add(day, "muse:" + session_dir if counted else None, model,
+                  input_tokens, output_tokens, cache_read, cache_write, prompts=1 if counted else 0)
+    except OSError:
+      # Whatever it yielded before failing still counts here, but a scan
+      # missing the rest of a session isn't kept.
+      complete = False
+  return complete
+
+
+# pi, omp, and opencode alike: the meta provider is Meta's own Muse Spark API
+# and only serves Muse Spark models, so any model on it counts (muse-spark
+# 1.1/1.2/1.3, ...), and so does omp's `muse-code`, the same API reached
+# through a Muse Code sign-in. Muse Spark through the Zen gateway
+# (providerID "opencode") is OpenCode usage, so the opencode record keeps it.
+PROVIDERS = ("meta", "muse-code")
+
+
+def billed_here(provider, model, entry):
+  return provider in PROVIDERS
+
+
+def scan_shared_stores(stats):
+  """pi/omp and opencode replies on Meta's providers. Returns whether every
+  source was read in full (safe to cache)."""
+  pi_rows, pi_complete = scan_pi_sessions(r'"provider"\s*:\s*"(' + "|".join(PROVIDERS) + r')"', billed_here)
+  # The closing quote makes the database's prefilter match the whole id.
+  db_rows, db_complete = scan_opencode([provider + '"' for provider in PROVIDERS], billed_here)
+  for row in db_rows + pi_rows:
+    model = model_name(row.model)
+    if model is not None:
+      stats.add_row(row, model)
+  return pi_complete and db_complete
+
+
+# ------------------------------------------------------------------ limits
+#
+# Additive subscription windows only. Local metering above always runs; this
+# section only fills `limits`/`tierLabel`/status when the authoritative key
+# probe answers. Pay-as-you-go and active plans without `subs_usage` have no
+# subscription windows: no token, a PAYG probe, or an active probe with no
+# subs_usage means limits stay empty (never estimated, never zeroed) and
+# local metering still shows. The OAuth token goes nowhere but
+# the Authorization header; only plan label + usage figures enter the record.
+
+
+def muse_config_dir() -> Path:
+  return config_home() / "muse"
+
+
+def read_access_token() -> str:
+  try:
+    raw = (os.environ.get("MUSE_AUTH_PATH") or "").strip()
+    path = Path(os.path.expandvars(os.path.expanduser(raw))) if raw else (muse_config_dir() / "auth.json")
+    data = json.loads(path.read_text(encoding="utf-8"))
+  except Exception:
+    return ""
+  # Every level checked: a login file that parses to a list, or whose
+  # `providers` is not an object, is a missing credential, not a crash.
+  if not isinstance(data, dict):
+    return ""
+  providers = data.get("providers")
+  if not isinstance(providers, dict):
+    return ""
+  login = providers.get("meta")
+  if not isinstance(login, dict):
+    return ""
+  return str(login.get("access_token") or "")
+
+
+def normalize_reset_at(value) -> str:
+  if value is None or isinstance(value, bool):
+    return ""
+  try:
+    ts = float(value)
+  except Exception:
+    # Some answers give the reset as an ISO time, which omp reads too.
+    try:
+      parsed = datetime.fromisoformat(str(value).strip().replace("Z", "+00:00"))
+    except ValueError:
+      return ""
+    return (parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)).isoformat()
+  if ts <= 0:
+    return ""
+  # Epoch seconds; accept milliseconds too.
+  if ts >= 1e12:
+    ts = ts / 1000
+  try:
+    return datetime.fromtimestamp(ts, timezone.utc).isoformat()
+  except Exception:
+    return ""
+
+
+def probe_key(access_token: str) -> dict:
+  # MUSE_KEY_ENDPOINT moves the endpoint, never the token onto a connection
+  # anyone on the way can read.
+  if not trusted_endpoint(key_endpoint()):
+    return {"ok": False, "helpText": "MUSE_KEY_ENDPOINT must use HTTPS (plain HTTP only for loopback). Local Muse stats are still shown."}
+  request = urllib.request.Request(
+    key_endpoint(),
+    data=json.dumps({}).encode(),
+    method="POST",
+    headers={
+      "Authorization": "Bearer " + access_token,
+      "Accept": "application/json",
+      "Content-Type": "application/json",
+    },
+  )
+  try:
+    payload = open_json(request, timeout=10)
+  except HttpError as error:
+    if error.status in (401, 403):
+      return {"ok": False, "expired": True,
+              "helpText": "Muse's saved sign-in was rejected. Run `muse login` to refresh it."}
+    if error.status:
+      return {"ok": False,
+              "helpText": f"Muse's usage endpoint returned status {error.status}. Local Muse stats are still shown."}
+    if error.transport:
+      return {"ok": False, "transport": True,
+              "helpText": "Couldn't reach Muse's usage endpoint. Retrying shortly. Local Muse stats are still shown."}
+    # The server answered but not with JSON: a shape change, not a network
+    # failure. No retryAdvised — re-asking won't fix the parser.
+    return {"ok": False, "helpText": "Muse's usage endpoint returned an unreadable response. Local Muse stats are still shown."}
+
+  usage = payload.get("subs_usage") if isinstance(payload, dict) else None
+  if not isinstance(usage, dict):
+    # PAYG account: key mints fine but there is no subscription window to
+    # meter (live shape: is_subs_active=false, subs_tier_name=null, no
+    # subs_usage). Local metering is the whole story — stay silent, not an
+    # error.
+    if isinstance(payload, dict) and payload.get("is_subs_active") is False:
+      return {"ok": False, "payg": True}
+    # Active plan without windows (live shape on Muse Code Power Usage:
+    # is_subs_active=true, subs_tier_name set, no subs_usage key at all).
+    # That is the steady answer, not a snapshot about to appear: keep the
+    # tier, show local metering only, stay silent like PAYG.
+    if isinstance(payload, dict) and payload.get("is_subs_active") is True:
+      tier_hint = str(payload.get("subs_tier_name") or "")
+      return {"ok": False, "silent": True, "tierLabel": tier_hint}
+    tier_hint = str(payload.get("subs_tier_name") or "") if isinstance(payload, dict) else ""
+    return {"ok": False, "tierLabel": tier_hint,
+            "helpText": "Muse's usage endpoint returned no usage. Local Muse stats are still shown."}
+
+  limits = []
+  window = usage.get("window") or {}
+  if isinstance(window, dict) and window.get("used_percent") is not None:
+    percent = percent_number(window.get("used_percent"))
+    if percent >= 0:
+      mins = number(window.get("window_duration_mins"))
+      if mins >= 60 and mins % 60 == 0:
+        label = f"Session ({mins // 60}-hour)"
+      else:
+        label = f"Session ({mins}m)" if mins > 0 else "Session"
+      limits.append({"label": label, "percent": percent, "resetsAt": normalize_reset_at(window.get("resets_at"))})
+  weekly = usage.get("weekly") or {}
+  if isinstance(weekly, dict) and weekly.get("used_percent") is not None:
+    percent = percent_number(weekly.get("used_percent"))
+    if percent >= 0:
+      limits.append({"label": "Weekly (7-day)", "percent": percent, "resetsAt": normalize_reset_at(weekly.get("resets_at"))})
+
+  if not limits:
+    tier_hint = str(payload.get("subs_tier_name") or "") if isinstance(payload, dict) else ""
+    return {"ok": False, "tierLabel": tier_hint,
+            "helpText": "Muse's usage endpoint returned no limits. Local Muse stats are still shown."}
+  tier = ""
+  if isinstance(payload, dict):
+    tier = str(payload.get("subs_tier_name") or "")
+  return {"ok": True, "limits": limits, "tierLabel": tier}
+
+
+def collect_limits(force: bool) -> dict:
+  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "", "stale": False, "fetchedAtMs": 0}
+
+  access_token = read_access_token()
+  if access_token == "":
+    # No login. Muse Spark used only through opencode's meta provider signs
+    # in with a Model API key, not `muse login`, so that alone is no reason
+    # to ask for one; the Muse CLI's own home on this machine is.
+    if muse_config_dir().is_dir() or muse_sessions_root().is_dir():
+      result["usageStatusText"] = "Waiting for auth"
+      result["authHelpText"] = "Run `muse login` to show Muse's session and weekly limits."
+    return result
+  result["signedIn"] = True
+
+  # Keyed by who the token signs in as (the JWT's subject when it is one), so
+  # a machine signed in to someone else never shows the last one's windows,
+  # and a refreshed token keeps the same cache. A window kept from an earlier
+  # check whose reset has passed comes back at zero: the period it measured
+  # is over.
+  try:
+    probe_cache = LimitsCache(AGENT_ID, account_key(access_token))
+    cached, fallback, fetched_at = probe_cache.data, probe_cache.limits, probe_cache.fetched_at
+  except Exception as exc:
+    warn(f"could not read limits cache ({exc})")
+    probe_cache, cached, fallback, fetched_at = None, {}, [], 0
+  result["tierLabel"] = str(cached.get("tierLabel") or "")
+
+  # The last good windows, marked stale, with when they were measured.
+  def keep_cached():
+    result["limits"] = fallback
+    result["stale"] = True
+    result["fetchedAtMs"] = fetched_at if fallback else 0
+
+  # Minting is idempotent and cheap (the same key comes back every call), so
+  # the reuse only absorbs repeated panel opens. A plan without windows is an
+  # answer too, and stands in like any other.
+  if probe_cache is not None and probe_cache.fresh(force, allow_empty=True):
+    result["limits"] = fallback
+    result["fetchedAtMs"] = fetched_at if fallback else 0
+    return result
+
+  probe = probe_key(access_token)
+  if probe["ok"]:
+    result["limits"] = probe["limits"]
+    result["tierLabel"] = probe.get("tierLabel") or result["tierLabel"]
+    if probe_cache is not None:
+      result["fetchedAtMs"] = probe_cache.save(probe["limits"], tierLabel=result["tierLabel"])
+    else:
+      result["fetchedAtMs"] = now_ms()
+    return result
+
+  if probe.get("transport"):
+    result["retryAdvised"] = True
+  if probe.get("payg") or probe.get("silent"):
+    # Authenticated PAYG names no plan; an active plan without windows keeps
+    # its name. Either way local metering stands alone, silent — not an
+    # error, not expired — and the cached windows go with the old plan, so
+    # a later failed check can't bring them back.
+    result["tierLabel"] = "" if probe.get("payg") else probe.get("tierLabel") or result["tierLabel"]
+    if probe_cache is not None:
+      probe_cache.save([], tierLabel=result["tierLabel"], noWindows=True)
+    return result
+  keep_cached()
+  if probe.get("expired"):
+    result["usageStatusText"] = "Sign-in expired"
+    result["authHelpText"] = probe["helpText"]
+  elif not fallback:
+    result["usageStatusText"] = "Muse limits unavailable"
+    result["authHelpText"] = probe["helpText"]
+    result["tierLabel"] = probe.get("tierLabel") or result["tierLabel"]
+  return result
+
+
+def scan_sources():
+  # The digest covers every data path the scan reads.
+  return [Path.home(), muse_sessions_root(), opencode_db(), *pi_session_roots()]
+
+
+def run_local_scans():
+  stats = Stats()
+  indexed, index_read = scan_session_index(stats)
+  native_read = scan_native_muse_sessions(stats, indexed)
+  complete = scan_shared_stores(stats)
+  return stats.snapshot(), complete and index_read and native_read
+
+
+def main():
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--force", action="store_true", help="rescan sessions, ignoring caches")
+  parser.add_argument("--limits-only", action="store_true", help="reuse any recent scan; kept for CLI compatibility with the panel refresh")
+  args = parser.parse_args()
+
+  max_age = scan_max_age(args.force, args.limits_only)
+  stats = cached_scan(AGENT_ID, scan_sources(), max_age, run_local_scans, match={"museSchema": CACHE_SCHEMA_VERSION})
+  limits = collect_limits(args.force)
+
+  record = base_record(
+    AGENT_ID, AGENT_NAME,
+    # A sign-in shows even before its first session or window, and so does
+    # a Muse CLI waiting for one.
+    ready=number(stats.get("totalPrompts")) > 0 or len(limits["limits"]) > 0 or bool(limits.get("signedIn")) or limits["usageStatusText"] != "",
+    # A sign-in with no sessions here has no local stats to show.
+    hasLocalStats=number(stats.get("totalSessions")) > 0 or number(stats.get("totalPrompts")) > 0 or bool(stats.get("modelUsage")),
+    # Prompts and sessions are counted, so the panel shows them in tooltips.
+    hasPromptStats=True,
+    tierLabel=limits["tierLabel"],
+    limits=limits["limits"],
+    limitsStale=limits["stale"],
+    limitsFetchedAt=limits["fetchedAtMs"],
+    usageStatusText=limits["usageStatusText"],
+    authHelpText=limits["authHelpText"],
+  )
+  record.update(stats)
+  if limits.get("retryAdvised"):
+    record["retryAdvised"] = True
+  emit(record, sort_keys=True)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/ollama.py b/shell/plugins/agents/usage/ollama.py
--- a/shell/plugins/agents/usage/ollama.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/ollama.py	2026-11-18 13:32:49.504896901 +0000
@@ -0,0 +1,366 @@
+# omarchy:summary=Print the Ollama Cloud usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Ollama Cloud usage into one display-ready JSON record.
+
+Everything the agents panel shows for Ollama Cloud comes from this one
+command: local token stats from pi and omp sessions, opencode's message
+database, Codex's `--oss` rollouts and Claude Code's transcripts that ran on
+the `ollama-cloud` provider (or on a cloud model through the local daemon),
+and the account's 5-hour session and 7-day weekly
+limits (or the monthly included credits) from Ollama's balance endpoint. The
+panel itself only ever reads the JSON this prints; it never talks to disk
+formats or endpoints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import sys
+import urllib.request
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  Stats,
+  base_record,
+  cached_scan as shared_cached_scan,
+  cloud_model,
+  config_home,
+  emit,
+  limits_cache_path as shared_limits_cache_path,
+  open_json,
+  opencode_db,
+  pi_session_roots,
+  read_json,
+  routed_match,
+  routed_sources,
+  scan_max_age,
+  scan_opencode,
+  scan_pi_sessions,
+  scan_routed,
+)
+
+AGENT_ID = "ollama"
+AGENT_NAME = "Ollama Cloud"
+PROVIDER = "ollama-cloud"
+BALANCE_ENDPOINT = "https://ollama.com/api/balance"
+ME_ENDPOINT = "https://ollama.com/api/me"
+AUTH_HELP_NO_KEY = "Set OLLAMA_API_KEY, or sign in to pi with an Ollama Cloud key, to show the account limits."
+AUTH_HELP_BAD_KEY = (
+  "Ollama Cloud rejected the API key. Update OLLAMA_API_KEY or ~/.config/omarchy/agents/ollama.json,"
+  " or sign in to pi again. Local stats are still shown."
+)
+# GET /api/balance (docs.ollama.com/api/balance) answers a legacy plan with
+# `included.session` / `included.weekly` ({remaining_percent 0..100,
+# resets_at}) and a current plan with `included.balance_usd`,
+# `allowance_usd` and `period.until`. /api/usage only reports token and cost
+# history, never the limits.
+
+
+def config_dir() -> Path:
+  return config_home() / "omarchy" / "agents"
+
+
+def read_config() -> dict[str, Any]:
+  return read_json(config_dir() / "ollama.json")
+
+
+def pi_agent_dir() -> Path:
+  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
+  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"
+
+
+def api_key() -> str:
+  env = os.environ.get("OLLAMA_API_KEY", "").strip()
+  if env:
+    return env
+  configured = str(read_config().get("apiKey") or "").strip()
+  if configured:
+    return configured
+  # pi and omp store the Ollama Cloud key they signed in with; either one
+  # proves the account, and the balance endpoint accepts the same key. Only a
+  # literal key is taken: a `$VAR` or `!command` entry is resolved by pi alone.
+  for auth_path in (pi_agent_dir() / "auth.json", Path.home() / ".omp" / "agent" / "auth.json"):
+    entry = read_json(auth_path).get(PROVIDER)
+    key = str(entry.get("key") or "").strip() if isinstance(entry, dict) else ""
+    if key and not key.startswith(("!", "$")):
+      return key
+  return ""
+
+
+# ---------------------------------------------------------------- local scan
+#
+# pi and omp record every assistant message with its provider, model, and
+# token usage in JSONL session files, and opencode in its message database,
+# under the same provider ids. The `ollama-cloud` provider is the
+# Ollama Cloud API, which serves Claude models alongside the open ones. A
+# cloud-tagged model ("glm-4.6:cloud", "gpt-oss:120b-cloud") reached through
+# the local daemon's `ollama` provider runs on Ollama's servers too, so it
+# counts here; the local collector leaves exactly those out. Codex's `--oss`
+# rollouts name the same `ollama` provider, and count here on the same
+# models. Claude Code pointed at ollama.com, or answering with a cloud-tagged
+# model, is Ollama's too, as is a MiniMax Code custom provider at ollama.com.
+
+
+def billed_by_ollama_cloud(provider: str, model: str, entry: Any = None) -> bool:
+  return provider == PROVIDER or (provider == "ollama" and cloud_model(model))
+
+
+# Ollama model ids carry a version tag ("deepseek-v4-pro:0813"); merge tags
+# so the chart groups by model, not by release.
+def model_name(raw: str) -> str:
+  return (raw or "ollama").split(":", 1)[0]
+
+
+def scan_sessions(model_prefix: str, reuse: bool = True) -> tuple[dict[str, Any], bool]:
+  stats = Stats()
+  pi_rows, pi_complete = scan_pi_sessions(r'"provider"\s*:\s*"ollama(-cloud)?"', billed_by_ollama_cloud)
+  # The database's prefilter matches both provider ids.
+  db_rows, db_complete = scan_opencode(["ollama"], billed_by_ollama_cloud)
+  # Codex rollouts come with them, by codex_route_owner(): the `--oss`
+  # daemon's cloud-tagged models, a model_providers entry named
+  # `ollama-cloud`, or one whose base_url is ollama.com.
+  routed_rows, routed_complete = scan_routed(AGENT_ID, reuse)
+  for row in pi_rows + db_rows + routed_rows:
+    model = model_name(row.model)
+    if model_prefix and not model.lower().startswith(model_prefix):
+      continue
+    stats.add_row(row, model)
+  return stats.snapshot(), pi_complete and db_complete and routed_complete
+
+
+def cached_scan(max_age_seconds: float, model_prefix: str) -> dict[str, Any]:
+  # The digest covers every data path the scan reads: the pi/omp session
+  # roots, the opencode DB, Codex's home, and Claude Code's and MiniMax
+  # Code's sessions. A scan only answers for the model filter it applied, and
+  # the endpoints those were sent to.
+  return shared_cached_scan(
+    AGENT_ID,
+    [*pi_session_roots(), opencode_db(), *routed_sources()],
+    max_age_seconds,
+    lambda: scan_sessions(model_prefix, reuse=max_age_seconds > 0),
+    match={"modelPrefix": model_prefix, **routed_match()},
+  )
+
+
+# ------------------------------------------------------------------- limits
+
+
+def clamp_fraction(value: Any) -> float:
+  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:
+    return -1.0
+  return min(1.0, float(value))
+
+
+def reset_time(value: Any) -> str:
+  raw = value.strip() if isinstance(value, str) else ""
+  try:
+    datetime.fromisoformat(raw.replace("Z", "+00:00"))
+  except ValueError:
+    return ""
+  return raw
+
+
+def amount(value: Any) -> float | None:
+  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+    return None
+  return float(value)
+
+
+def balance_limits(payload: Any) -> list[dict[str, Any]]:
+  included = payload.get("included") if isinstance(payload, dict) else None
+  if not isinstance(included, dict):
+    return []
+  out = []
+  for key, label in (("session", "Session (5-hour)"), ("weekly", "Weekly (7-day)")):
+    window = included.get(key)
+    if not isinstance(window, dict):
+      continue
+    # remaining_percent runs 0..100 and says what is left, not what is used.
+    remaining = amount(window.get("remaining_percent"))
+    remaining = clamp_fraction(remaining / 100) if remaining is not None else -1.0
+    if remaining >= 0:
+      out.append({"label": label, "percent": 1.0 - remaining, "resetsAt": reset_time(window.get("resets_at"))})
+  balance, allowance = amount(included.get("balance_usd")), amount(included.get("allowance_usd"))
+  if balance is not None and allowance is not None and allowance > 0:
+    period = included.get("period")
+    out.append({
+      "label": "Included credits",
+      "title": "Monthly",
+      "percent": max(0.0, min(1.0, (allowance - balance) / allowance)),
+      "resetsAt": reset_time(period.get("until")) if isinstance(period, dict) else "",
+    })
+  return out
+
+
+# The credits bought apart from the plan: purchased.balance_usd, what's left
+# of them unexpired. The answer says how much remains but not how much was
+# bought, so the balance shows the remaining figure alone. A plan that never
+# bought any, or used them up, has none to show, and that is no alarm while
+# the plan's included credits still serve.
+def purchased_balance(payload: Any) -> dict[str, Any] | None:
+  purchased = payload.get("purchased") if isinstance(payload, dict) else None
+  remaining = amount(purchased.get("balance_usd")) if isinstance(purchased, dict) else None
+  if remaining is None or remaining <= 0:
+    return None
+  return {"remaining": remaining, "funded": 0, "spent": 0, "currency": "USD", "estimated": False}
+
+
+def kept_balance(cache: LimitsCache) -> dict[str, Any] | None:
+  balance = cache.data.get("balance")
+  return balance if isinstance(balance, dict) else None
+
+
+def probe_limits(access_key: str) -> dict[str, Any]:
+  request = urllib.request.Request(
+    BALANCE_ENDPOINT,
+    headers={"Authorization": "Bearer " + access_key, "Accept": "application/json"},
+  )
+  try:
+    payload = open_json(request, timeout=10)
+  except HttpError as error:
+    if error.status in (401, 403):
+      return {"ok": False, "auth": True, "helpText": AUTH_HELP_BAD_KEY}
+    if error.status:
+      return {"ok": False, "helpText": f"Ollama's balance endpoint returned status {error.status}. Local stats are still shown."}
+    if error.transport:
+      # A transport failure reached no server at all — no route, no DNS. Any
+      # real answer, including an error status, is a server we should stop
+      # pestering; this is not.
+      return {
+        "ok": False,
+        "transport": True,
+        "helpText": "Couldn't reach Ollama's balance endpoint. Retrying shortly. Local stats are still shown.",
+      }
+    return {"ok": False, "helpText": "Ollama's balance endpoint returned an invalid answer. Local stats are still shown."}
+
+  out = balance_limits(payload)
+  balance = purchased_balance(payload)
+  if not out and balance is None:
+    return {"ok": False, "helpText": "Ollama's balance endpoint returned no limits. Local stats are still shown."}
+  return {"ok": True, "limits": out, "balance": balance}
+
+
+def probe_plan(access_key: str) -> str | None:
+  """The plan Ollama names for the key, "" when it names none, None when it couldn't be asked."""
+  request = urllib.request.Request(
+    ME_ENDPOINT,
+    headers={"Authorization": "Bearer " + access_key, "Accept": "application/json"},
+    method="POST",
+  )
+  try:
+    payload = open_json(request, timeout=10)
+  except Exception:
+    return None
+  # Ollama's UserResponse tags the field `plan`; Go's decoder takes either
+  # case, so `Plan` is read too.
+  plan = str(payload.get("plan") or payload.get("Plan") or "").strip()[:64] if isinstance(payload, dict) else ""
+  return plan[0].upper() + plan[1:] if plan else ""
+
+
+def limits_cache_path(access_key: str) -> Path:
+  # Keyed by the credential: another key never shows this one's allowance or
+  # plan.
+  return shared_limits_cache_path(AGENT_ID, access_key)
+
+
+def collect_limits(access_key: str, force: bool) -> dict[str, Any]:
+  # `live` says whether the limits are this check's (or a probe recent enough
+  # to stand in for one), `fetchedAtMs` when they were measured, so the panel
+  # can tell kept limits from fresh ones.
+  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "", "live": False, "fetchedAtMs": 0}
+
+  if access_key == "":
+    result["usageStatusText"] = "Waiting for auth"
+    result["authHelpText"] = AUTH_HELP_NO_KEY
+    return result
+
+  # A panel that is opened and shut repeatedly must not turn into a request
+  # per flick, so recent probe results are reused for a short window — and
+  # kept as the answer of record when a later probe fails.
+  cache = LimitsCache(AGENT_ID, access_key)
+  cached_plan = str(cache.data.get("plan") or "")
+
+  # --force is a person asking for fresh numbers, so it skips the reuse window
+  # entirely; the interval is there to absorb repeated panel opens, not to
+  # overrule someone who pressed refresh.
+  if cache.fresh(force, allow_empty=kept_balance(cache) is not None):
+    result.update(limits=cache.limits, tierLabel=cached_plan, live=True, fetchedAtMs=cache.fetched_at, balance=kept_balance(cache))
+    return result
+
+  probe = probe_limits(access_key)
+  if probe["ok"]:
+    plan = probe_plan(access_key)
+    # A plan lookup that failed keeps the plan last named, rather than
+    # blanking a label the account still has.
+    plan = cached_plan if plan is None else plan
+    fetched_at = cache.save(probe["limits"], only_if_newer=True, plan=plan, balance=probe["balance"])
+    result.update(limits=probe["limits"], tierLabel=plan, live=True, fetchedAtMs=fetched_at, balance=probe["balance"])
+    return result
+
+  # The first probe after login often fires before DHCP has handed out a
+  # route. Ask the shell to try again sooner than its regular interval.
+  if probe.get("transport"):
+    result["retryAdvised"] = True
+  result["authHelpText"] = probe["helpText"]
+  fallback = cache.kept()[0]
+  balance = kept_balance(cache)
+  if fallback or balance:
+    result.update(limits=fallback, tierLabel=cached_plan, fetchedAtMs=cache.fetched_at, balance=balance)
+  if probe.get("auth"):
+    result["usageStatusText"] = "Sign-in expired"
+  elif not fallback and not balance:
+    result["usageStatusText"] = "Ollama limits unavailable"
+  return result
+
+
+# -------------------------------------------------------------------- record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--force", action="store_true", help="rescan sessions and re-probe limits, ignoring caches")
+  parser.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the limits probe must be fresh")
+  args = parser.parse_args()
+
+  config = read_config()
+  model_prefix = str(config.get("modelPrefix") or "").strip().lower()
+  stats = cached_scan(scan_max_age(args.force, args.limits_only), model_prefix)
+  has_stats = bool(stats.get("modelUsage"))
+
+  key = api_key()
+  record = base_record(AGENT_ID, AGENT_NAME, hasLocalStats=has_stats)
+  record.update(stats)
+
+  # A machine with neither a key nor any Ollama Cloud sessions doesn't use it,
+  # and the panel skips the record; that is no trouble to report.
+  if key or has_stats:
+    limits = collect_limits(key, args.force)
+    record.update(
+      ready=True,
+      tierLabel=limits["tierLabel"],
+      usageStatusText=limits["usageStatusText"],
+      authHelpText=limits["authHelpText"],
+      limits=limits["limits"],
+      limitsStale=bool(limits["limits"] or limits.get("balance")) and not limits["live"],
+      limitsFetchedAt=limits["fetchedAtMs"],
+    )
+    if limits.get("balance"):
+      record["balance"] = limits["balance"]
+    if limits.get("retryAdvised"):
+      record["retryAdvised"] = True
+  emit(record, sort_keys=True)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/opencode.py b/shell/plugins/agents/usage/opencode.py
--- a/shell/plugins/agents/usage/opencode.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/opencode.py	2026-11-18 13:32:49.505796134 +0000
@@ -0,0 +1,429 @@
+# omarchy:summary=Print the OpenCode usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect OpenCode usage into one display-ready JSON record.
+
+Local stats come from pi/omp sessions that ran through an opencode provider
+and from opencode's own message database, both of its stores. Only the Zen
+and Go providers count: opencode runs on Anthropic or OpenAI belong to the
+claude and codex records. The limits are the Go plan's rolling, weekly, and
+monthly meters from OpenCode's usage endpoint. The agents panel only ever
+reads the JSON this prints.
+"""
+
+import argparse
+import json
+import math
+import os
+import sqlite3
+import sys
+import time
+import urllib.request
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from typing import NamedTuple
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  Stats,
+  base_record,
+  cache_root,  # noqa: F401 - the tests reach the cache through it
+  cached_scan,
+  data_home,
+  emit,
+  limits_cache_path as shared_limits_cache_path,
+  number,
+  open_json,
+  opencode_db,
+  pi_session_roots,
+  scan_max_age,
+  scan_opencode,
+  scan_pi_sessions,
+)
+
+AGENT_ID = "opencode"
+AGENT_NAME = "OpenCode"
+
+# The subscription meters live on the Zen "go" gateway; the plain gateway has
+# no usage endpoint. Limits are per-account, so they come from the same key
+# regardless of which provider id a given run used. A Console session asks
+# Console's own endpoint for the same numbers.
+API_BASE_URL = "https://opencode.ai"
+USAGE_PATH = "/zen/go/v1/usage"
+CONSOLE_USAGE_PATH = "/inference/go/v1/usage"
+CONSOLE_ORG_HEADER = "x-opencode-org-id"
+CONSOLE_EXPIRED_HELP = "OpenCode's Console session has expired. Run `opencode auth login` to refresh it."
+
+# A key with no Go plan behind it (a Zen pay-as-you-go account) gets the same
+# answer every time, so it is asked again hourly rather than on every run;
+# --force asks at once, for someone who just subscribed.
+NO_PLAN_RECHECK_SECONDS = 3600
+
+# The subscription has two provider ids: "opencode" for the plain Zen
+# gateway and "opencode-go" for the Go plan. Both spend the same account and
+# both appear in pi sessions and in opencode's own database.
+PROVIDERS = ("opencode", "opencode-go")
+
+
+# Usage percentages arrive as 0-100; the record contract wants 0-1. An
+# unreadable value returns -1 so the caller can drop the window.
+def fraction(value):
+  if isinstance(value, bool):
+    return -1.0
+  try:
+    percent = float(value) / 100.0
+  except (TypeError, ValueError):
+    return -1.0
+  return percent if math.isfinite(percent) else -1.0
+
+
+def model_name(raw):
+  # opencode stores the model as a {providerID, modelID} object in its own
+  # database and as a plain string in pi sessions; the shared readers hand
+  # back the id either way. A variant suffix such as ":high" names the
+  # thinking level, not the model.
+  value = str(raw or "").rstrip("/").split("/")[-1].split(":")[0] or "opencode"
+  # The panel title-cases words but cannot produce all-caps acronyms.
+  if value[:3].lower() == "glm":
+    value = "GLM" + value[3:]
+  return value
+
+
+# Exact match: opencode provider ids are free-form, and a custom
+# "opencode-local" gateway is not this subscription. Anthropic and OpenAI runs
+# never match, so the claude and codex collectors keep those.
+def billed_here(provider, model, entry):
+  return provider in PROVIDERS
+
+
+def run_local_scans():
+  # pi and omp can spend the subscription without opencode's CLI ever
+  # running, so its own database cannot be the only source. Their JSONL
+  # transcripts carry the provider, model, and token usage per message. A
+  # subscription burned entirely through opencode leaves no pi session files,
+  # but opencode records the same per message in its own database.
+  stats = Stats()
+  pi_rows, pi_complete = scan_pi_sessions(r'"provider"\s*:\s*"opencode(-go)?"', billed_here)
+  db_rows, db_complete = scan_opencode(PROVIDERS, billed_here)
+  for row in pi_rows + db_rows:
+    stats.add_row(row, model_name(row.model))
+  return stats.snapshot(), pi_complete and db_complete
+
+
+def cached_local_stats(max_age):
+  # The digest covers every data path the scan reads: the opencode DB and the
+  # pi/omp session roots.
+  return cached_scan(AGENT_ID, [opencode_db(), *pi_session_roots()], max_age, run_local_scans)
+
+
+class Credential(NamedTuple):
+  """One way of asking OpenCode for the Go meters."""
+
+  token: str
+  url: str
+  headers: dict
+  expired: bool = False
+
+
+def read_auth_key(path):
+  try:
+    parsed = json.loads(path.read_text(encoding="utf-8"))
+  except Exception:
+    # Unreadable, not JSON, or nested past the parser's depth (a
+    # RecursionError): no key here.
+    return ""
+  if not isinstance(parsed, dict):
+    return ""
+  # Only the subscription's own provider ids: a custom gateway named like
+  # "opencode-local" holds a key for somewhere else, never to be sent here.
+  # An entry is an {type, key} object, or the key as a plain string.
+  # A pi `$VAR` or `!command` entry is resolved by pi alone, never sent.
+  entries = [parsed[provider] for provider in PROVIDERS if provider in parsed]
+  for entry in entries:
+    if isinstance(entry, dict):
+      entry = entry.get("key")
+    if isinstance(entry, str) and entry.strip() and not entry.strip().startswith(("!", "$")):
+      return entry.strip()
+  return ""
+
+
+def pi_agent_dir():
+  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
+  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"
+
+
+def read_store_credentials(db):
+  """The active credentials opencode V2 keeps in its database: Go keys, and
+  the Console session it signs the opencode integration in with."""
+  keys, console = [], None
+  if not db.is_file():
+    return keys, console
+  try:
+    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
+  except sqlite3.Error:
+    return keys, console
+  try:
+    conn.execute("PRAGMA query_only = ON")
+    rows = conn.execute(
+      "SELECT integration_id, value FROM credential WHERE active = 1 AND integration_id IN ('opencode-go', 'opencode')"
+      " ORDER BY integration_id = 'opencode-go' DESC, time_updated DESC"
+    ).fetchall()
+  except sqlite3.Error:
+    return keys, console
+  finally:
+    conn.close()
+  for _, raw in rows:
+    try:
+      value = json.loads(raw)
+    except Exception:
+      # Not JSON, or nested past the parser's depth: skip this row alone.
+      continue
+    if not isinstance(value, dict):
+      continue
+    if value.get("type") == "key" and str(value.get("key") or "").strip():
+      keys.append(str(value["key"]).strip())
+    elif value.get("type") == "oauth" and console is None and str(value.get("access") or "").strip():
+      # Console traffic is scoped to a workspace, and a wrong one is a hard
+      # 403, so the header only goes out when the id is there.
+      metadata = value.get("metadata")
+      org = str(metadata.get("orgID") or "").strip() if isinstance(metadata, dict) else ""
+      expired = 0 < number(value.get("expires")) <= time.time() * 1000
+      console = Credential(str(value["access"]).strip(), API_BASE_URL + CONSOLE_USAGE_PATH, {CONSOLE_ORG_HEADER: org} if org else {}, expired)
+  return keys, console
+
+
+def credential_candidates():
+  # An explicit key wins, then opencode's own credential stores, then pi's:
+  # pi drives the same Zen subscription and records it under the same
+  # provider ids, so a machine that codes through pi never signs the opencode
+  # CLI in. The Console session is the implicit one, so it comes last. Which
+  # one the endpoint accepts isn't knowable from here, so a refused one only
+  # hands over to the next.
+  store_keys, console = read_store_credentials(opencode_db())
+  tokens = [str(os.environ.get(name, "")).strip() for name in ("OPENCODE_API_KEY", "OPENCODE_GO_API_KEY")]
+  tokens += store_keys
+  tokens.append(read_auth_key(data_home() / "opencode" / "auth.json"))
+  tokens.append(read_auth_key(pi_agent_dir() / "auth.json"))
+  tokens.append(read_auth_key(Path.home() / ".omp" / "agent" / "auth.json"))
+  candidates = []
+  for token in tokens:
+    if token and token not in [c.token for c in candidates]:
+      candidates.append(Credential(token, API_BASE_URL + USAGE_PATH, {}))
+  if console is not None:
+    candidates.append(console)
+  return candidates
+
+
+def reset_from_seconds(value):
+  seconds = number(value)
+  if seconds <= 0:
+    return ""
+  try:
+    return (datetime.now(timezone.utc) + timedelta(seconds=seconds)).isoformat()
+  except OverflowError:
+    # Further out than a date goes: no reset time to show.
+    return ""
+
+
+def iso_reset(value):
+  # Only an ISO time is a reset time; an epoch, a list or garbage is none.
+  if not isinstance(value, str) or not value.strip():
+    return ""
+  try:
+    datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
+  except ValueError:
+    return ""
+  return value.strip()
+
+
+# The live endpoint nests the windows under "usage" with "percent" and
+# "resetsAt"; another deployment spells them "<window>Usage" with
+# "usagePercent" and "resetInSec". Both are read, so the collector doesn't
+# depend on which one answers.
+def parse_usage(payload):
+  usage = payload.get("usage") if isinstance(payload, dict) else None
+  usage = usage if isinstance(usage, dict) else (payload if isinstance(payload, dict) else {})
+  limits = []
+  for name, label in (("rolling", "Rolling (5h)"), ("weekly", "Weekly (7-day)"), ("monthly", "Monthly")):
+    window = usage.get(name)
+    if not isinstance(window, dict):
+      window = payload.get(name + "Usage") if isinstance(payload, dict) else None
+    if not isinstance(window, dict):
+      continue
+    percent = fraction(window.get("percent", window.get("usagePercent")))
+    if percent < 0:
+      continue
+    # A rate-limited window is spent until it resets, whatever it reads.
+    if str(window.get("status") or "") == "rate-limited":
+      percent = 1.0
+    limits.append({
+      "label": label,
+      "percent": max(0.0, min(1.0, percent)),
+      "resetsAt": iso_reset(window.get("resetsAt")) or reset_from_seconds(window.get("resetInSec")),
+    })
+  return limits
+
+
+def probe_limits(credential):
+  request = urllib.request.Request(credential.url, headers={
+    "Authorization": "Bearer " + credential.token,
+    "Accept": "application/json",
+    # Cloudflare answers the default urllib signature with a 1010 before the
+    # request reaches the API, so identify the collector instead.
+    "User-Agent": "omarchy-agent-usage-opencode/1.0",
+    **credential.headers,
+  })
+  unreachable = {"ok": False, "transport": True, "helpText": "Couldn't reach OpenCode's usage endpoint. Retrying shortly. Local OpenCode stats are still shown."}
+  try:
+    payload = open_json(request, timeout=10)
+  except HttpError as error:
+    if error.transport:
+      return unreachable
+    # A refused credential may just be the wrong one for this account, so the
+    # next way in still gets its turn.
+    if error.status == 401:
+      return {"ok": False, "refused": True, "helpText": "OpenCode rejected the saved key. Reconnect OpenCode Go with /connect in the TUI, or set OPENCODE_API_KEY."}
+    if error.status == 403:
+      # A key without a Go plan behind it: Zen pay-as-you-go has no meters,
+      # which is no trouble at all.
+      return {"ok": False, "noPlan": True}
+    if error.status:
+      return {"ok": False, "helpText": f"OpenCode's usage endpoint returned status {error.status}. Local OpenCode stats are still shown."}
+    payload = None
+  except Exception:
+    # open_json already names every transport failure, so anything else is
+    # a broken answer, and retrying soon won't mend it.
+    payload = None
+
+  if not isinstance(payload, dict) or not payload:
+    return {"ok": False, "helpText": "OpenCode's usage endpoint returned no data. Local OpenCode stats are still shown."}
+  limits = parse_usage(payload)
+  if not limits:
+    return {"ok": False, "helpText": "OpenCode's usage endpoint returned no quota windows. Local OpenCode stats are still shown."}
+  return {"ok": True, "limits": limits}
+
+
+# One cache per credential, so a machine signed in to another account never
+# shows the last one's meters.
+def limits_cache_path(token):
+  return shared_limits_cache_path(AGENT_ID, token)
+
+
+def collect_limits(force):
+  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "", "retryAdvised": False, "stale": False, "fetchedAtMs": 0, "signedIn": False}
+  # No key at all is a Zen user paying as they go, or someone who only runs
+  # opencode locally: local stats stand alone, with nothing to fix.
+  candidates = credential_candidates()
+  if not candidates:
+    return result
+  result["signedIn"] = True
+
+  # Limits only ever show for a Go plan, so a tier follows them.
+  def answer(limits, fetched_at, stale):
+    # Stale says limits were kept past a failed check, so none kept is none stale.
+    result.update(limits=limits, tierLabel="Go" if limits else "", stale=stale and bool(limits), fetchedAtMs=fetched_at if limits else 0)
+    return result
+
+  refused = None
+  no_plan = False
+  for candidate in candidates:
+    cache = LimitsCache(AGENT_ID, candidate.token)
+    fallback, fetched_at = cache.limits, cache.fetched_at
+
+    # A key already known to have no Go plan isn't asked again for a while.
+    if cache.data.get("noPlan") is True and not force and cache.younger_than(NO_PLAN_RECHECK_SECONDS):
+      no_plan = True
+      continue
+
+    # A recent answer stands in for a probe; --force skips the wait.
+    if cache.fresh(force):
+      return answer(fallback, fetched_at, False)
+
+    probe = probe_limits(candidate)
+    if probe.get("ok"):
+      return answer(probe["limits"], cache.save(probe["limits"], only_if_newer=True), False)
+
+    if probe.get("noPlan"):
+      # The windows of a plan that's gone mean nothing now, so they go too.
+      cache.save([], only_if_newer=True, noPlan=True)
+      no_plan = True
+      continue
+
+    if probe.get("refused"):
+      # Keep the first refusal that still has open windows, so a later
+      # credential without a cache can't blank them. A lapsed Console
+      # session is what to fix, whichever refusal is kept.
+      expired = candidate.expired or bool(refused and refused[3])
+      if refused is None or (not refused[1] and fallback):
+        refused = (probe, fallback, fetched_at, expired)
+      else:
+        refused = refused[:3] + (expired,)
+      continue
+
+    # Last good numbers, marked stale, beat an empty limits section while
+    # the probe is down. A key that already said it has no plan makes an
+    # outage on another one no news.
+    result["retryAdvised"] = bool(probe.get("transport"))
+    answer(fallback, fetched_at, True)
+    if fallback:
+      result["authHelpText"] = probe["helpText"]
+    elif not no_plan:
+      result["usageStatusText"] = "OpenCode limits unavailable"
+      result["authHelpText"] = probe["helpText"]
+    return result
+
+  # A working key without a Go plan is the answer: the other ways in only
+  # failed to say the same.
+  if no_plan:
+    return result
+
+  # Every way in was refused: an account problem, not an outage. Keep any
+  # still-open numbers, but say a new sign-in is needed.
+  probe, fallback, fetched_at, expired = refused
+  answer(fallback, fetched_at, True)
+  result["usageStatusText"] = "Sign-in expired"
+  result["authHelpText"] = CONSOLE_EXPIRED_HELP if expired else probe["helpText"]
+  return result
+
+
+def main():
+  parser = argparse.ArgumentParser()
+  # --force rescans everything and rewrites the cache. --limits-only is kept
+  # for CLI compatibility with the panel's refreshLimits() call: only the
+  # limits probe must be fresh, so it may reuse a scan for far longer than a
+  # normal run, whose short window exists purely to dedup concurrent
+  # collector runs.
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  args = parser.parse_args()
+
+  stats = cached_local_stats(scan_max_age(args.force, args.limits_only))
+  limits = collect_limits(args.force)
+
+  # Nobody uses OpenCode here: no usage and no credential leave a record the
+  # panel skips.
+  record = base_record(
+    AGENT_ID,
+    AGENT_NAME,
+    ready=number(stats.get("totalPrompts")) > 0 or bool(limits["limits"]) or limits["signedIn"],
+    # A sign-in with no sessions here has no local stats to show.
+    hasLocalStats=number(stats.get("totalSessions")) > 0 or number(stats.get("totalPrompts")) > 0 or bool(stats.get("modelUsage")),
+    tierLabel=limits["tierLabel"],
+    usageStatusText=limits["usageStatusText"],
+    authHelpText=limits["authHelpText"],
+    limits=limits["limits"],
+    limitsStale=limits["stale"],
+    limitsFetchedAt=limits["fetchedAtMs"],
+  )
+  record.update(stats)
+  if limits["retryAdvised"]:
+    record["retryAdvised"] = True
+  emit(record)
+
+
+if __name__ == "__main__":
+  main()
