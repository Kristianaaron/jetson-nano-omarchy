+# omarchy:summary=Print the GitHub Copilot usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect GitHub Copilot usage into one display-ready JSON record.
+
+GitHub exposes no supported personal-account usage API — the Copilot REST
+endpoints are organization- or enterprise-scoped — but the Copilot CLI keeps
+two local sources this collector reads. The primary one is the session store
+(~/.copilot/session-store.db): its assistant_usage_events table records every
+billed request with day, model, session, token split, and cost in nano AI
+units (1e9 nano units = 1 AI credit at 1 cent). The fallback, for CLI versions
+whose store predates that table, is the session transcript directory
+(~/.copilot/session-state/<id>/events.jsonl), whose shutdown events carry the
+same per-model token split and cost. The record prefers whichever source
+produced numbers, never both.
+
+The monthly meter is an allowance of AI credits: GitHub's own account-wide
+figure from the internal quota endpoint (the same one the editor plugins
+use), asked with a token from COPILOT_QUOTA_TOKEN, GH_TOKEN, GITHUB_TOKEN, or
+`gh auth token`. It names the plan, the allowance, and when it resets, and a
+failed check keeps the last answer, marked stale. An answer under 15 seconds
+old is reused rather than asked again (--force always asks), and `gh` is only
+run when GitHub is actually asked. Only when it can't be asked at all does a
+monthlyCredits budget from ~/.config/omarchy/agents/copilot.json give a local
+estimate, labeled as one, of this machine's CLI spend:
+
+  {
+    "monthlyCredits": 1500,
+    "remote": true
+  }
+
+remote turns the quota probe off when false, and on even without a Copilot
+CLI home when true; by default it runs only where the CLI has been used.
+
+The agents panel only ever reads the JSON this prints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import calendar
+import datetime as dt
+import hashlib
+import json
+import math
+import os
+import sqlite3
+import subprocess
+import sys
+import urllib.request
+from pathlib import Path
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  NUMBER_CEILING,
+  HttpError,
+  LimitsCache,
+  Stats,
+  base_record,
+  cache_root,
+  cached_scan,
+  config_home,
+  emit,
+  empty_bucket,
+  empty_stats,
+  find_command,
+  local_day,
+  number,
+  open_json,
+  read_json,
+  scan_max_age,
+  stamp,
+  token_count,
+  write_json,
+)
+
+AGENT_ID = "copilot"
+AGENT_NAME = "GitHub Copilot"
+AUTH_HELP = (
+  "Run `gh auth login`, or set COPILOT_QUOTA_TOKEN, to show Copilot's monthly allowance."
+)
+
+ULTRA_SECONDS = 1_000_000_000
+QUOTA_URL = "https://api.github.com/copilot_internal/user"
+REMOTE_TIMEOUT = 6.0
+
+# Plan names as the quota endpoint spells them.
+API_PLAN_LABELS = {
+  "individual": "Pro",
+  "individual_pro": "Pro+",
+  "business": "Business",
+  "enterprise": "Enterprise",
+  "free": "Free",
+  "max": "Max",
+}
+
+def expand_path(value: str) -> Path:
+  return Path(os.path.expandvars(os.path.expanduser(value))).resolve()
+
+
+def read_config() -> dict[str, Any]:
+  return read_json(config_home() / "omarchy" / "agents" / "copilot.json")
+
+
+TOKEN_KEYS = tuple(empty_bucket())
+
+
+def month_start(now: dt.datetime) -> dt.datetime:
+  return now.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
+
+
+def next_month_start(now: dt.datetime) -> dt.datetime:
+  days = calendar.monthrange(now.year, now.month)[1]
+  return month_start(now) + dt.timedelta(days=days)
+
+
+def positive_float(value: Any) -> float:
+  """A cost from disk, 0.0 when it can't be trusted: like number(), an
+  infinite or huge figure is a damaged field, not spend that fills the
+  allowance on its own."""
+  try:
+    n = float(value or 0)
+  except (TypeError, ValueError, OverflowError):
+    return 0.0
+  return n if math.isfinite(n) and 0 < n < NUMBER_CEILING else 0.0
+
+
+def credits_from_nano(nano: Any) -> float:
+  return positive_float(nano) / ULTRA_SECONDS
+
+
+def token_split(
+  prompt_tokens: Any, output_tokens: Any, cache_read: Any, cache_write: Any
+) -> dict[str, int]:
+  """Map Copilot's token counts onto the panel's four disjoint buckets.
+
+  Copilot's input count is the whole prompt, cache reads and writes included,
+  and its output count already includes reasoning tokens. The buckets are
+  disjoint, like the other collectors', so the cached part comes off input
+  and reasoning is never added a second time.
+  """
+  read = token_count(cache_read)
+  write = token_count(cache_write)
+  return {
+    "inputTokens": max(0, token_count(prompt_tokens) - read - write),
+    "outputTokens": token_count(output_tokens),
+    "cacheReadInputTokens": read,
+    "cacheCreationInputTokens": write,
+  }
+
+
+def clean_name(value: Any) -> str:
+  return str(value or "").strip()
+
+
+def parse_event_time(value: Any) -> dt.datetime | None:
+  """Parse a store or transcript timestamp into timezone-aware local time.
+
+  Accepts ISO-8601 (with or without Z) and epoch seconds or milliseconds.
+  As in local_day(), zero, a huge or negative number, NaN, a boolean, a date
+  outside 2000-2100, and anything else collapse to None; the caller falls
+  back to the file's time or the local date.
+  """
+  if isinstance(value, str):
+    value = value.strip()
+    if value.isdigit():
+      # ASCII digits only, and few enough to be a time: isdigit() also passes
+      # other scripts' digits and int() refuses strings past 4300 digits.
+      value = int(value) if value.isascii() and len(value) <= 20 else None
+  if value is None or value == "" or isinstance(value, bool):
+    return None
+  if isinstance(value, (int, float)):
+    if number(value) <= 0:
+      return None
+    seconds = value / 1000 if value > 10_000_000_000 else value
+    try:
+      parsed = dt.datetime.fromtimestamp(seconds, dt.timezone.utc)
+    except (OverflowError, OSError, ValueError):
+      return None
+  else:
+    try:
+      parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
+    except ValueError:
+      return None
+    if parsed.tzinfo is None:
+      parsed = parsed.replace(tzinfo=dt.timezone.utc)
+  if not 2000 <= parsed.year <= 2100:
+    return None
+  return parsed.astimezone()
+
+
+def utc_month_key(value: Any) -> str:
+  parsed = parse_event_time(value)
+  if parsed is None:
+    return ""
+  return parsed.astimezone(dt.timezone.utc).strftime("%Y-%m")
+
+
+# ------------------------------------------------------------------ database
+
+
+def open_store(path: Path) -> sqlite3.Connection | None:
+  """Open the session store read-only, or None when it can't be read.
+
+  The CLI writes to this database continuously in WAL mode. A read-only
+  connection reads it in place: each query sees one consistent state of the
+  store, without blocking the writer and without copying a store that grows
+  without bound. Every scan aggregates as it streams, so the record's size
+  depends on days and models, never on the number of rows.
+  """
+  if not path.is_file():
+    return None
+  try:
+    conn = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=5.0)
+  except sqlite3.Error:
+    return None
+  try:
+    conn.execute("PRAGMA query_only = ON")
+    # A file that isn't a database only says so when it is first read.
+    conn.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchall()
+  except sqlite3.Error:
+    conn.close()
+    return None
+  conn.row_factory = sqlite3.Row
+  return conn
+
+
+def has_table(conn: sqlite3.Connection, name: str) -> bool:
+  try:
+    row = conn.execute(
+      "SELECT 1 FROM sqlite_master WHERE type='table' AND name=? LIMIT 1", (name,)
+    ).fetchone()
+    return row is not None
+  except sqlite3.Error:
+    return False
+
+
+def blank_stats() -> dict[str, Any]:
+  return {**empty_stats(), "monthCredits": 0.0}
+
+
+# --------------------------------------------------------------- aggregate
+
+
+class UsageTally(Stats):
+  """Running aggregate shared by both scans, on the shared stats fields.
+
+  Unlike a pi or opencode reply, a Copilot prompt and the tokens it spent
+  arrive apart (a transcript books a segment's tokens at its shutdown), so
+  each is counted on its own, along with the month's spend. It grows with
+  days, sessions, and models, never with raw events, so a scan can stream an
+  entire store or transcript directory through it.
+  """
+
+  def __init__(self) -> None:
+    super().__init__()
+    self.current_utc_month = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m")
+    self.month_credits = 0.0
+
+  def usage(self, model: str, day: str, tokens: dict[str, int]) -> None:
+    # Tokens no prompt and no one session is known for: a segment's spend.
+    self.add(day, None, model, *(tokens[key] for key in TOKEN_KEYS), prompts=0)
+
+  def spend(self, month_key: str, credits: float) -> None:
+    # The allowance window is the current UTC month, matching the reset
+    # boundary; older spend belongs to windows that are already over.
+    if month_key == self.current_utc_month:
+      self.month_credits += credits
+
+  def stats(self) -> dict[str, Any]:
+    return {**self.snapshot(), "monthCredits": round(self.month_credits, 6)}
+
+
+# ---------------------------------------------------------- store scan
+#
+# The session store's assistant_usage_events table records one row per billed
+# assistant request with day, model, session, the token split, and the cost in
+# total_nano_aiu. Rows stream through the tally rather than being fetched, so
+# lifetime totals cover the whole store at constant memory. A row with no time
+# is today's, and one whose time can't be trusted counts nowhere.
+#
+# Current CLIs also say who started each request: initiator "user" is a
+# prompt typed into the session, and "agent" the follow-up calls the agent
+# made on its own (a tool loop's next step, a subagent). And a request GitHub
+# served carries GitHub's usage report, its copilot_usage_model and cost; one
+# sent to a custom provider (BYOK, COPILOT_PROVIDER_BASE_URL) has neither, so
+# that provider billed it, not Copilot, and it stays out of this record. The
+# store doesn't keep where such a request went. A store from before these
+# columns counts every row as Copilot's, and its prompts can't be told apart.
+
+
+def table_columns(conn: sqlite3.Connection, name: str) -> set[str]:
+  try:
+    return {str(row[1]) for row in conn.execute(f"PRAGMA table_info({name})")}
+  except sqlite3.Error:
+    return set()
+
+
+# The stats, and how many dated rows the store held: a store with none falls
+# back on the transcripts.
+def scan_store(conn: sqlite3.Connection) -> tuple[dict[str, Any], int]:
+  tally = UsageTally()
+  rows_seen = 0
+  columns = table_columns(conn, "assistant_usage_events")
+  knows_initiator = "initiator" in columns
+  knows_billing = "copilot_usage_model" in columns
+  optional = [name for name in ("initiator", "agent_id", "copilot_usage_model") if name in columns]
+  extra = "".join(", " + name for name in optional)
+  try:
+    rows = conn.execute(
+      "SELECT session_id, model, created_at, total_nano_aiu, input_tokens,"
+      " output_tokens, cache_read_tokens, cache_write_tokens" + extra +
+      " FROM assistant_usage_events"
+    )
+    for row in rows:
+      session_id = clean_name(row["session_id"])
+      day = local_day(row["created_at"])
+      if day is None:
+        continue
+      rows_seen += 1
+      if knows_billing and row["copilot_usage_model"] is None and row["total_nano_aiu"] is None:
+        continue
+      if knows_initiator:
+        typed = clean_name(row["initiator"]) == "user" and not ("agent_id" in optional and clean_name(row["agent_id"]))
+        tally.add_prompts(day, session_id or "unknown", 1 if typed else 0)
+      else:
+        tally.add_prompts(day, session_id or "unknown")
+      tally.spend(
+        utc_month_key(row["created_at"]),
+        credits_from_nano(row["total_nano_aiu"]),
+      )
+      tally.usage(
+        clean_name(row["model"]) or "copilot",
+        day,
+        token_split(
+          row["input_tokens"],
+          row["output_tokens"],
+          row["cache_read_tokens"],
+          row["cache_write_tokens"],
+        ),
+      )
+  except sqlite3.Error:
+    return blank_stats(), 0
+  # Without an initiator a row is a billed model request, and one prompt can
+  # make many, so its count stays out of the panel's prompt totals.
+  return dict(tally.stats(), hasPromptStats=knows_initiator), rows_seen
+
+
+# ------------------------------------------------------ transcript fallback
+#
+# A CLI whose store predates the assistant_usage_events table still writes one
+# events.jsonl per session, one {"type", "timestamp", "data"} event per line:
+#
+# - user.message is a prompt. data.source marks messages a skill, a subagent,
+#   or the CLI itself injected; those are not the user's prompts.
+# - session.shutdown carries data.modelMetrics: per-model token usage and cost
+#   (totalNanoAiu), cumulative for the session across resumes. The growth since
+#   the previous shutdown is the usage of the segment that just ended, spread
+#   over the days that segment's replies landed on.
+# - assistant.message carries data.outputTokens per reply. It dates a segment's
+#   usage, and stands in for a segment still running with no shutdown yet.
+
+
+def is_prompt(event_type: Any, data: dict[str, Any]) -> bool:
+  return event_type == "user.message" and clean_name(data.get("source")) in (
+    "",
+    "user",
+  )
+
+
+def shutdown_metrics(data: dict[str, Any]) -> dict[str, dict[str, float]]:
+  metrics = data.get("modelMetrics")
+  if not isinstance(metrics, dict):
+    return {}
+  totals: dict[str, dict[str, float]] = {}
+  for model, entry in metrics.items():
+    if not isinstance(entry, dict):
+      continue
+    usage = entry.get("usage")
+    if not isinstance(usage, dict):
+      usage = {}
+    totals[clean_name(model) or "copilot"] = {
+      **token_split(
+        usage.get("inputTokens"),
+        usage.get("outputTokens"),
+        usage.get("cacheReadTokens"),
+        usage.get("cacheWriteTokens"),
+      ),
+      "credits": credits_from_nano(entry.get("totalNanoAiu")),
+    }
+  return totals
+
+
+def apportion(total: int, weights: list[int]) -> list[int]:
+  """Split a whole total in proportion to positive weights, summing exactly."""
+  whole = sum(weights)
+  shares: list[int] = []
+  given = 0
+  running = 0
+  for weight in weights:
+    running += weight
+    share = total * running // whole - given
+    shares.append(share)
+    given += share
+  return shares
+
+
+Reply = tuple[str, str, str, int]  # model, local day, UTC month, output tokens
+
+
+def spread_segment(
+  tally: UsageTally,
+  model: str,
+  delta: dict[str, int],
+  credits: float,
+  replies: list[Reply],
+  shutdown_slot: tuple[str, str],
+) -> None:
+  """Book one model's usage for a finished segment on the days it happened.
+
+  A segment can span midnight, and its shutdown only reports totals. Output
+  splits by each day's reply output, which the transcript records exactly.
+  Input, cache, and cost split by reply count: every reply is one model call
+  that resends the context, so calls, not output, track what was read.
+  """
+  slots: dict[tuple[str, str], list[int]] = {}
+  for reply_model, day, month_key, output in replies:
+    if reply_model == model:
+      slot = slots.setdefault((day, month_key), [0, 0])
+      slot[0] += 1
+      slot[1] += output
+  if not slots:
+    slots[shutdown_slot] = [1, 0]
+
+  calls = [counts[0] for counts in slots.values()]
+  outputs = [counts[1] for counts in slots.values()]
+  if sum(outputs) <= 0:
+    outputs = calls
+  split = {
+    key: apportion(delta[key], outputs if key == "outputTokens" else calls)
+    for key in TOKEN_KEYS
+  }
+  all_calls = sum(calls)
+  for index, (day, month_key) in enumerate(slots):
+    tally.usage(model, day, {key: split[key][index] for key in TOKEN_KEYS})
+    tally.spend(month_key, credits * calls[index] / all_calls)
+
+
+def scan_transcript(event_file: Path, session_key: str, tally: UsageTally) -> None:
+  try:
+    session_mtime = event_file.stat().st_mtime
+  except OSError:
+    session_mtime = 0.0
+
+  # Session totals as of the last shutdown, and the replies since then.
+  reported: dict[str, dict[str, float]] = {}
+  replies: list[Reply] = []
+
+  with event_file.open("r", encoding="utf-8", errors="replace") as handle:
+    for raw in handle:
+      try:
+        entry = json.loads(raw)
+      except ValueError:
+        continue
+      if not isinstance(entry, dict):
+        continue
+      event_type = entry.get("type")
+      data = entry.get("data")
+      if not isinstance(data, dict):
+        continue
+
+      # A line with no time is the file's; one whose time can't be trusted
+      # counts nowhere, as in every other collector.
+      stamped = entry.get("timestamp")
+      parsed = parse_event_time(stamped)
+      if parsed is None and stamped is not None:
+        continue
+      if parsed is None and session_mtime > 0:
+        parsed = dt.datetime.fromtimestamp(
+          session_mtime, dt.timezone.utc
+        ).astimezone()
+      day = parsed.date().isoformat() if parsed else tally.today
+      month_key = (
+        parsed.astimezone(dt.timezone.utc).strftime("%Y-%m") if parsed else ""
+      )
+
+      if is_prompt(event_type, data):
+        tally.add_prompts(day, session_key)
+      elif event_type == "assistant.message":
+        model = clean_name(data.get("model")) or "copilot"
+        replies.append(
+          (model, day, month_key, token_count(data.get("outputTokens")))
+        )
+      elif event_type == "session.shutdown":
+        for model, totals in shutdown_metrics(data).items():
+          before = reported.get(model, {})
+          spread_segment(
+            tally,
+            model,
+            {
+              key: max(0, int(totals[key] - before.get(key, 0)))
+              for key in TOKEN_KEYS
+            },
+            max(0.0, totals["credits"] - before.get("credits", 0.0)),
+            replies,
+            (day, month_key),
+          )
+          reported[model] = totals
+        # The shutdown totals already count these replies.
+        replies.clear()
+
+  for model, day, _month_key, output in replies:
+    tally.usage(model, day, {**empty_bucket(), "outputTokens": output})
+
+
+# The stats, and whether every transcript was read: one that couldn't be
+# leaves the totals short, so they must not be cached.
+def scan_transcripts(session_root: Path) -> tuple[dict[str, Any], bool]:
+  if not session_root.is_dir():
+    return blank_stats(), True
+  tally = UsageTally()
+  complete = True
+  try:
+    session_dirs = sorted(p for p in session_root.iterdir() if p.is_dir())
+  except OSError:
+    return blank_stats(), False
+  for session_dir in session_dirs:
+    event_file = session_dir / "events.jsonl"
+    if not event_file.is_file():
+      continue
+    try:
+      scan_transcript(event_file, session_dir.name, tally)
+    except OSError:
+      complete = False
+  return tally.stats(), complete
+
+
+# ------------------------------------------------------------------- scan
+
+
+# The stats, and whether they are complete: a store that is there but could
+# not be read leaves only the transcripts, which newer CLIs may not write.
+def direct_scan(home_dir: Path) -> tuple[dict[str, Any], bool]:
+  store = home_dir / "session-store.db"
+  conn = open_store(store)
+  if conn is None:
+    stats, complete = scan_transcripts(home_dir / "session-state")
+    return stats, complete and not store.exists()
+  try:
+    if has_table(conn, "assistant_usage_events"):
+      stats, rows_seen = scan_store(conn)
+      if rows_seen:
+        return stats, True
+    # A store without the usage table, or one that is still empty, falls back
+    # to the transcripts exactly like a store-less machine.
+    return scan_transcripts(home_dir / "session-state")
+  finally:
+    conn.close()
+
+
+# ------------------------------------------------------------ remote quota
+
+
+def env_token() -> str:
+  for var in ("COPILOT_QUOTA_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"):
+    value = os.environ.get(var)
+    if value and value.strip():
+      return value.strip()
+  return ""
+
+
+def gh_token() -> str:
+  exe = find_command("gh")
+  if not exe:
+    return ""
+  try:
+    result = subprocess.run(
+      # gh follows GH_HOST without --hostname, and an Enterprise token must
+      # never go to api.github.com.
+      [exe, "auth", "token", "--hostname", "github.com"],
+      capture_output=True,
+      text=True,
+      timeout=REMOTE_TIMEOUT,
+      check=False,
+    )
+  except (OSError, subprocess.SubprocessError):
+    return ""
+  return result.stdout.strip() if result.returncode == 0 else ""
+
+
+def gh_user() -> str:
+  """Who `gh` is signed in to github.com as, from its hosts.yml.
+
+  Read as plain lines rather than YAML: only the host's own `user:` key
+  matters, and reading it costs no process, so a reused answer never has to
+  run `gh` to know whose it is.
+  """
+  config = os.environ.get("GH_CONFIG_DIR") or str(Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "gh")
+  try:
+    lines = (Path(config) / "hosts.yml").read_text(encoding="utf-8").splitlines()
+  except (OSError, UnicodeDecodeError):
+    return ""
+  in_host, child_indent = False, None
+  for line in lines:
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+      continue
+    indent = len(line) - len(line.lstrip(" "))
+    if indent == 0:
+      in_host, child_indent = stripped == "github.com:", None
+      continue
+    if not in_host:
+      continue
+    child_indent = indent if child_indent is None else child_indent
+    if indent == child_indent and stripped.startswith("user:"):
+      return stripped.split(":", 1)[1].strip().strip("'\"")
+  return ""
+
+
+def github_credential() -> tuple[str, str]:
+  """Who the quota is asked as, and the token when it is already in hand.
+
+  Environment first, so a user can scope exactly what this sees, then the
+  `gh` CLI's own credential store, which is where a machine that has signed
+  in already keeps it. An exported token keys by itself (the limits cache
+  hashes whatever it is keyed by). gh keys by the account its hosts.yml
+  names, and its token is only fetched when GitHub is asked; a hosts.yml
+  without a user falls back to fetching it now. Nothing here is ever stored
+  or logged.
+  """
+  token = env_token()
+  if token:
+    return token, token
+  user = gh_user() if find_command("gh") else ""
+  if user:
+    return f"gh:github.com:{user}", ""
+  token = gh_token()
+  return (token, token) if token else ("", "")
+
+
+# A quota amount as GitHub sends it, or None when it isn't a readable one.
+def quota_amount(value: Any) -> float | None:
+  if isinstance(value, bool) or not isinstance(value, (int, float, str)):
+    return None
+  try:
+    amount = float(value)
+  except ValueError:
+    return None
+  return amount if math.isfinite(amount) and amount >= 0 else None
+
+
+def ask_quota(token: str) -> dict[str, Any]:
+  """Ask GitHub for the account-wide credit balance."""
+  request = urllib.request.Request(
+    QUOTA_URL,
+    headers={
+      "Authorization": f"Bearer {token}",
+      "Accept": "application/json",
+      "User-Agent": "omarchy-agent-usage",
+    },
+  )
+  try:
+    payload = open_json(request, timeout=REMOTE_TIMEOUT, limit=2_000_000)
+  except HttpError as error:
+    if error.status:
+      return {"available": False, "reason": f"http-{error.status}"}
+    # No route, no DNS, refused, reset or timed out: nothing answered.
+    if error.transport:
+      return {"available": False, "reason": "unreachable"}
+    # A reply that came back cut short or unreadable is still an answer from
+    # GitHub.
+    return {"available": False, "reason": "bad-payload"}
+
+  if not isinstance(payload, dict):
+    return {"available": False, "reason": "bad-payload"}
+
+  snapshots = payload.get("quota_snapshots")
+  snapshot = snapshots.get("premium_interactions") if isinstance(snapshots, dict) else None
+  if not isinstance(snapshot, dict):
+    return {"available": False, "reason": "no-quota"}
+
+  # Under token-based billing the snapshot counts AI credits directly; only
+  # the local store and transcripts count in nano units. GitHub's snapshot
+  # (the CLI's CopilotUserResponseQuotaSnapshotsPremiumInteractions) says
+  # what is left, as remaining, quota_remaining or percent_remaining, so the
+  # amount used is the entitlement less that; a credits_used amount is still
+  # read first where one is sent. A limited allowance needs both amounts: one
+  # missing or unreadable would pass for no meter or an untouched allowance
+  # and replace the last good answer, so it is a failed check instead.
+  unlimited = snapshot.get("unlimited") is True
+  entitlement = quota_amount(snapshot.get("entitlement"))
+  used = quota_amount(snapshot.get("credits_used"))
+  if used is None and entitlement is not None:
+    remaining = quota_amount(snapshot.get("remaining"))
+    if remaining is None:
+      remaining = quota_amount(snapshot.get("quota_remaining"))
+    percent_remaining = quota_amount(snapshot.get("percent_remaining"))
+    if remaining is not None:
+      used = max(0.0, entitlement - remaining)
+    elif percent_remaining is not None:
+      used = entitlement * max(0.0, 100.0 - percent_remaining) / 100.0
+  if not unlimited and (entitlement is None or used is None):
+    return {"available": False, "reason": "bad-payload"}
+  return {
+    "available": True,
+    "unlimited": unlimited,
+    "entitlement": entitlement or 0.0,
+    "used": used or 0.0,
+    "resetsAt": str(payload.get("quota_reset_date_utc") or ""),
+    "planLabel": API_PLAN_LABELS.get(str(payload.get("copilot_plan") or "").strip().lower(), ""),
+  }
+
+
+# Before the limits caches were named copilot-limits-*, each token kept its
+# answer as copilot-quota-<token hash>. Read once, when this account has no
+# answer under the new name, so the last allowance survives the rename.
+def adopt_legacy_cache(cache: Path, token: str) -> dict[str, Any]:
+  legacy = cache_root() / f"copilot-quota-{hashlib.sha256(token.encode('utf-8')).hexdigest()[:16]}.json"
+  cached = read_json(legacy)
+  if not cached.get("available"):
+    return {}
+  try:
+    write_json(cache, cached)
+    legacy.unlink(missing_ok=True)
+  except OSError:
+    pass
+  return cached
+
+
+def fetch_remote_quota(force: bool = False) -> dict[str, Any]:
+  """The live quota, or the last good one marked stale.
+
+  Every failure is soft: a missing token, an offline machine, or a changed
+  payload keeps the last answer this account got, marked stale, or leaves
+  the record on its local stats rather than failing the whole collection.
+  Each account keeps its own cache, so a machine signed in to another
+  account never shows the last one's allowance. The cache is read whatever
+  its file time, so a clock that went back doesn't lose it.
+  """
+  identity, token = github_credential()
+  if not identity:
+    return {"available": False, "reason": "no-token"}
+
+  # The cache keeps GitHub's answer itself rather than meter rows: the meter
+  # is drawn from it at print time, budget and reset date included.
+  cache = LimitsCache(AGENT_ID, identity)
+  cached = cache.data
+  # A panel opened and shut repeatedly must not turn into a request (and a
+  # gh process) per flick, so an answer this recent is the answer.
+  if cached.get("available") and cache.fresh(force, allow_empty=True):
+    return open_quota(dict(cached, stale=False))
+
+  # hosts.yml still naming the account while `gh auth token` fails is gh or
+  # its credential store having a bad moment, not a sign-out (signing out
+  # drops the account from hosts.yml), so that account's last allowance
+  # stands, stale, like any other failed check.
+  token = token or gh_token()
+  if not token:
+    quota = {"available": False, "reason": "no-token"}
+  else:
+    if not cached:
+      cached = adopt_legacy_cache(cache.path, token)
+    quota = ask_quota(token)
+  if quota.get("available"):
+    quota["stale"] = False
+    quota["fetchedAtMs"] = cache.save([], **quota)
+    return quota
+
+  if cached.get("available"):
+    return open_quota(dict(cached, stale=True, failure=quota.get("reason", "")))
+  return quota
+
+
+# A kept answer describes its own allowance window and nothing after it:
+# once GitHub's reset date passes, its usage is back at zero and the next
+# reset is unknown until GitHub is asked again. One without a reset date is
+# kept as it is.
+def open_quota(cached: dict[str, Any]) -> dict[str, Any]:
+  resets_at = parse_event_time(str(cached.get("resetsAt") or ""))
+  if resets_at is not None and resets_at <= dt.datetime.now(dt.timezone.utc):
+    cached.update(used=0.0, resetsAt="")
+  return cached
+
+
+# What went wrong asking GitHub, and what to do about it.
+def quota_trouble(reason: str) -> str:
+  if reason == "unreachable":
+    return "Couldn't reach GitHub's Copilot quota endpoint. Retrying shortly."
+  if reason == "no-token":
+    return "The gh CLI didn't hand over its GitHub token; check `gh auth status`."
+  if reason in ("http-401", "http-403"):
+    return "GitHub refused the token for Copilot's quota. " + AUTH_HELP
+  if reason.startswith("http-"):
+    return f"GitHub's Copilot quota endpoint returned status {reason[5:]}."
+  return "GitHub's Copilot quota endpoint sent no allowance."
+
+
+# ---------------------------------------------------------------- allowance
+
+
+def allowance_limits(
+  month_credits: float,
+  config: dict[str, Any],
+  remote: dict[str, Any] | None,
+  now: dt.datetime,
+  has_stats: bool,
+) -> dict[str, Any]:
+  """The monthly allowance meter.
+
+  The live figure from the quota endpoint counts every machine, editor, and
+  agent on the entitlement, plan included. When it can't be asked, a
+  monthlyCredits budget from the configuration gives a local estimate of this
+  machine's CLI spend, labeled as such; without one there is no meter.
+  """
+  result = {
+    "limits": [],
+    "tierLabel": "",
+    "usageStatusText": "",
+    "authHelpText": "",
+    "limitsStale": False,
+    "limitsFetchedAt": 0,
+    "retryAdvised": False,
+  }
+  remote = remote if isinstance(remote, dict) else {}
+  reason = str(remote.get("failure") or remote.get("reason") or "")
+  result["retryAdvised"] = reason == "unreachable"
+
+  if remote.get("available"):
+    result["tierLabel"] = str(remote.get("planLabel") or "")
+    if remote.get("stale"):
+      result["authHelpText"] = quota_trouble(reason) + " Showing the last known allowance."
+      # A refused token is a sign-in to redo, kept allowance or not.
+      if reason in ("http-401", "http-403"):
+        result["usageStatusText"] = "Sign-in expired"
+    if remote.get("unlimited") or float(remote.get("entitlement") or 0) <= 0:
+      return result
+    # GitHub's own reset date, or none: a kept window that has reset has no
+    # known next one.
+    parsed = parse_event_time(str(remote.get("resetsAt") or ""))
+    result["limits"] = [{
+      "label": "Monthly allowance",
+      "percent": min(1.0, float(remote.get("used") or 0.0) / float(remote["entitlement"])),
+      "resetsAt": parsed.isoformat() if parsed is not None and parsed > now else "",
+    }]
+    result["limitsStale"] = bool(remote.get("stale"))
+    result["limitsFetchedAt"] = stamp(remote.get("fetchedAtMs"))
+    return result
+
+  if reason == "no-token":
+    result["usageStatusText"] = "Waiting for auth"
+    result["authHelpText"] = AUTH_HELP
+  elif reason in ("http-401", "http-403"):
+    result["usageStatusText"] = "Sign-in expired"
+    result["authHelpText"] = quota_trouble(reason)
+  elif reason and reason != "disabled":
+    result["usageStatusText"] = "Copilot limits unavailable"
+    result["authHelpText"] = quota_trouble(reason)
+
+  # A budget must not advertise a meter on a machine the CLI has never
+  # touched: the estimate needs local numbers to mean anything. Its window is
+  # the calendar month in UTC, the boundary GitHub documents for Copilot's
+  # allowance.
+  budget = config.get("monthlyCredits")
+  if isinstance(budget, (int, float)) and budget > 0 and has_stats:
+    result["limits"] = [{
+      "label": "Monthly allowance (est.)",
+      "percent": min(1.0, month_credits / float(budget)),
+      "resetsAt": next_month_start(now).isoformat(),
+    }]
+  return result
+
+
+# ------------------------------------------------------------------ record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser()
+  # --force rescans everything and rewrites the cache. --limits-only is kept
+  # for CLI compatibility with the panel's refreshLimits() call: only the
+  # limits probe must be fresh, so it may reuse a scan for far longer than a
+  # normal run, whose short window exists purely to dedup concurrent
+  # collector runs.
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  parser.add_argument("--copilot-home", default=os.environ.get("COPILOT_HOME") or "~/.copilot")
+  args = parser.parse_args()
+
+  home_dir = expand_path(args.copilot_home)
+  # The digest covers the one data path the scan reads, the CLI's home.
+  stats = cached_scan(AGENT_ID, [home_dir], scan_max_age(args.force, args.limits_only), lambda: direct_scan(home_dir))
+
+  config = read_config()
+  now = dt.datetime.now(dt.timezone.utc)
+
+  # The quota probe hands a GitHub token to GitHub, so it only runs where the
+  # Copilot CLI has been used, or where the configuration asks for it. A
+  # machine with gh signed in but no Copilot stays an empty record.
+  remote = {"available": False, "reason": "disabled"}
+  if config.get("remote") is True or (config.get("remote", True) is not False and home_dir.is_dir()):
+    remote = fetch_remote_quota(args.force)
+
+  has_stats = number(stats.get("totalPrompts")) > 0 or float(stats.get("monthCredits") or 0.0) > 0
+  allowance = allowance_limits(float(stats.get("monthCredits") or 0.0), config, remote, now, has_stats)
+  ready = number(stats.get("totalPrompts")) > 0 or len(allowance["limits"]) > 0
+
+  record = base_record(
+    AGENT_ID,
+    AGENT_NAME,
+    ready=ready,
+    # A store of custom-provider requests alone leaves nothing of Copilot's.
+    hasLocalStats=number(stats.get("totalSessions")) > 0 or bool(stats.get("modelUsage")),
+    hasPromptStats=stats.get("hasPromptStats") is not False,
+    tierLabel=allowance["tierLabel"],
+    usageStatusText=allowance["usageStatusText"],
+    authHelpText=allowance["authHelpText"],
+    limits=allowance["limits"],
+    limitsStale=allowance["limitsStale"],
+    limitsFetchedAt=allowance["limitsFetchedAt"],
+  )
+  # The first probe after login often fires before the network is up.
+  if allowance["retryAdvised"]:
+    record["retryAdvised"] = True
+  for key in (
+    "todayPrompts",
+    "todaySessions",
+    "todayTotalTokens",
+    "totalPrompts",
+    "totalSessions",
+    "activeDays",
+  ):
+    record[key] = number(stats.get(key))
+  record["todayTokensByModel"] = stats.get("todayTokensByModel") or {}
+  record["recentDays"] = stats.get("recentDays") or []
+  record["modelUsage"] = stats.get("modelUsage") or {}
+  record["activeDates"] = stats.get("activeDates") or []
+  emit(record)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/cursor.py b/shell/plugins/agents/usage/cursor.py
--- a/shell/plugins/agents/usage/cursor.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/cursor.py	2026-11-18 13:32:49.498125101 +0000
@@ -0,0 +1,472 @@
+# omarchy:summary=Print the Cursor usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect Cursor usage into one display-ready JSON record.
+
+Cursor keeps no token counts on disk, so everything here comes from the same
+dashboard RPCs the Cursor CLI itself calls: the plan and the period meters
+from GetCurrentPeriodUsage and GetPlanInfo, tokens per model and per day from
+GetAggregatedUsageEvents. They are asked with the sign-in the Cursor CLI
+stores, or failing that the one the Cursor editor keeps in its state.vscdb.
+The agents panel only ever reads the JSON this prints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+from datetime import date, datetime, time, timedelta, timezone
+from pathlib import Path
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  account_key,
+  base_record as shared_base_record,
+  cached_scan,
+  config_home,
+  cursor_auth_path,
+  cursor_token,
+  emit,
+  empty_bucket,
+  empty_stats,
+  finite,
+  number,
+  open_json,
+  read_json,
+  scan_cache_paths,
+  scan_max_age,
+  token_lapsed,
+  trusted_endpoint,
+)
+
+AGENT_ID = "cursor"
+AGENT_NAME = "Cursor"
+AUTH_HELP = "Sign in to the Cursor editor, or run `cursor-agent login`."
+API_BASE_URL = "https://api2.cursor.sh"
+SERVICE = "aiserver.v1.DashboardService"
+REQUEST_TIMEOUT = 20
+RECENT_DAYS = 7
+
+
+class CursorError(Exception):
+  def __init__(self, message: str, auth: bool = False, transport: bool = False) -> None:
+    super().__init__(message)
+    self.auth = auth
+    # Nothing answered at all, so the panel should try again soon.
+    self.transport = transport
+
+
+def fraction(value: Any) -> float:
+  # Cursor reports whole percentages; the panel's meters take 0..1.
+  return min(1.0, max(0.0, finite(value) / 100))
+
+
+# The Cursor CLI keeps its config beside auth.json and in ~/.cursor, the editor
+# under ~/.config/Cursor. Any of them means Cursor is used here, so a missing
+# sign-in is worth saying; without them the machine doesn't use Cursor at all.
+def cursor_in_use(auth_path: Path) -> bool:
+  return any(path.is_dir() for path in (auth_path.parent, config_home() / "Cursor", Path.home() / ".cursor"))
+
+
+# ------------------------------------------------------------------ record
+
+
+def iso(epoch_millis: Any) -> str:
+  millis = number(epoch_millis)
+  if millis <= 0:
+    return ""
+  try:
+    return datetime.fromtimestamp(millis / 1000, timezone.utc).isoformat()
+  except (OverflowError, OSError, ValueError):
+    return ""
+
+
+def base_record(**overrides: Any) -> dict[str, Any]:
+  # Dashboard numbers are account-global, not machine-local: every synced
+  # device reports the same truth, so aggregation must not sum them. The
+  # dashboard reports usage events, never prompt or session counts; the panel
+  # keeps those numbers out of today's tooltip when hasPromptStats is false.
+  return shared_base_record(AGENT_ID, AGENT_NAME, scope="account", hasPromptStats=False, **overrides)
+
+
+class CursorClient:
+  def __init__(self, token: str, api_base_url: str) -> None:
+    self.token = token
+    self.api_base_url = api_base_url.rstrip("/")
+
+  def call(self, method: str, payload: dict[str, Any]) -> dict[str, Any]:
+    request = urllib.request.Request(
+      f"{self.api_base_url}/{SERVICE}/{method}",
+      data=json.dumps(payload).encode("utf-8"),
+      headers={
+        "Content-Type": "application/json",
+        "Connect-Protocol-Version": "1",
+        "Authorization": f"Bearer {self.token}",
+        "x-cursor-client-type": "cli",
+      },
+      method="POST",
+    )
+    try:
+      parsed = open_json(request, timeout=REQUEST_TIMEOUT)
+    except HttpError as error:
+      if error.status in (401, 403):
+        raise CursorError(AUTH_HELP, auth=True) from error
+      if error.status:
+        raise CursorError(f"Cursor's dashboard returned status {error.status}.") from error
+      # A reply cut short came from a server that answered, so it is no
+      # reason to ask the panel for a sooner retry.
+      if error.cut_short:
+        raise CursorError("Cursor's dashboard cut its reply short.") from error
+      # No route, no DNS, refused, reset or timed out: nothing answered.
+      if error.transport:
+        raise CursorError("Couldn't reach Cursor's dashboard. Retrying shortly.", transport=True) from error
+      raise CursorError("Cursor's dashboard returned malformed JSON.") from error
+    if not isinstance(parsed, dict):
+      raise CursorError("Cursor's dashboard returned malformed JSON.")
+    return parsed
+
+  def period(self) -> dict[str, Any]:
+    return self.call("GetCurrentPeriodUsage", {})
+
+  # None when the plan couldn't be asked, so the last known one stands.
+  def plan_info(self) -> dict[str, Any] | None:
+    try:
+      plan = self.call("GetPlanInfo", {}).get("planInfo")
+    except CursorError:
+      return None
+    return plan if isinstance(plan, dict) else {}
+
+  def aggregations(self, start_millis: int, end_millis: int) -> list[Any]:
+    payload = {"startDate": str(start_millis), "endDate": str(end_millis)}
+    rows = self.call("GetAggregatedUsageEvents", payload).get("aggregations")
+    return rows if isinstance(rows, list) else []
+
+
+# ------------------------------------------------------------------ tokens
+
+
+def day_windows(today: date, count: int) -> list[tuple[str, int, int]]:
+  """The last `count` local days, oldest first, as (date, startMs, endMs)."""
+  windows = []
+  for offset in range(count - 1, -1, -1):
+    day = today - timedelta(days=offset)
+    # Each midnight converts on its own: a day that springs forward or falls
+    # back is 23 or 25 hours long, never a fixed 24.
+    start = datetime.combine(day, time.min).astimezone()
+    end = datetime.combine(day + timedelta(days=1), time.min).astimezone()
+    windows.append((day.isoformat(), int(start.timestamp() * 1000), int(end.timestamp() * 1000)))
+  return windows
+
+
+def summarize_day(rows: list[Any]) -> dict[str, dict[str, int]]:
+  """One day's aggregations under the token names every collector prints."""
+  usage: dict[str, dict[str, int]] = {}
+  for row in rows:
+    if not isinstance(row, dict):
+      continue
+    model = str(row.get("modelIntent") or "cursor")
+    bucket = usage.setdefault(model, empty_bucket())
+    # Connect's JSON writes 64-bit counts as strings, so number() rather than
+    # the strict token_count().
+    bucket["inputTokens"] += number(row.get("inputTokens"))
+    bucket["outputTokens"] += number(row.get("outputTokens"))
+    bucket["cacheReadInputTokens"] += number(row.get("cacheReadTokens"))
+    bucket["cacheCreationInputTokens"] += number(row.get("cacheWriteTokens"))
+  return usage
+
+
+def summarize_usage(days: list[tuple[str, dict[str, dict[str, int]]]]) -> dict[str, Any]:
+  recent_days = []
+  active_dates = []
+  model_usage: dict[str, dict[str, int]] = {}
+  today_by_model: dict[str, int] = {}
+
+  for index, (day, usage) in enumerate(days):
+    tokens = 0
+    for model, bucket in usage.items():
+      carried = model_usage.setdefault(model, empty_bucket())
+      for name, value in bucket.items():
+        carried[name] += value
+      tokens += sum(bucket.values())
+    recent_days.append({"date": day, "messageCount": tokens})
+    if tokens > 0:
+      active_dates.append(day)
+    if index == len(days) - 1:
+      today_by_model = {model: sum(bucket.values()) for model, bucket in usage.items() if sum(bucket.values()) > 0}
+
+  return {
+    "hasLocalStats": bool(model_usage),
+    "todayTotalTokens": sum(today_by_model.values()),
+    "todayTokensByModel": today_by_model,
+    "recentDays": recent_days,
+    "activeDays": len(active_dates),
+    "activeDates": active_dates,
+    "modelUsage": model_usage,
+  }
+
+
+# The token scan is cached per account rather than per data path: Cursor's
+# numbers live on its dashboard, and the account is who they belong to.
+def stats_cache(key: str) -> Path:
+  return scan_cache_paths(AGENT_ID, [key])[0]
+
+
+def carried_stats(key: str, today: date) -> dict[str, Any]:
+  """The last scan of this account, for runs that fetch no fresh tokens.
+
+  Another account's scan never stands in for this one's. A scan from an
+  earlier day is moved onto this week's dates, and its today figures are
+  cleared, since nothing in it happened today.
+  """
+  stats = {"hasLocalStats": False, **empty_stats()}
+  cached = read_json(stats_cache(key))
+  previous = cached.get("stats")
+  if not isinstance(previous, dict):
+    return stats
+  for name in stats:
+    if name in previous:
+      stats[name] = previous[name]
+  if cached.get("scanDate") != today.isoformat():
+    week = [window[0] for window in day_windows(today, RECENT_DAYS)]
+    kept_days = {str(day): usage for day, usage in previous.get("days") or [] if isinstance(usage, dict)}
+    if kept_days:
+      # Summed again over the new week, so the day that fell out leaves the
+      # model totals and active days along with the chart.
+      stats.update(summarize_usage([(day, kept_days.get(day, {})) for day in week]), hasLocalStats=stats["hasLocalStats"])
+    else:
+      counts = {str(row.get("date")): row.get("messageCount", 0) for row in stats["recentDays"] if isinstance(row, dict)}
+      stats["recentDays"] = [{"date": day, "messageCount": counts.get(day, 0)} for day in week]
+      stats["activeDates"] = [day for day in stats.get("activeDates") or [] if day in week]
+      stats["activeDays"] = len(stats["activeDates"])
+    stats["todayTotalTokens"] = 0
+    stats["todayTokensByModel"] = {}
+  return stats
+
+
+# This week's tokens: a scan of this account recent enough to reuse, else a
+# fresh one, else the last one when the fetch fails.
+def week_stats(client: CursorClient, today: date, key: str, max_age_seconds: float) -> dict[str, Any]:
+  def scan() -> tuple[dict[str, Any], bool]:
+    windows = day_windows(today, RECENT_DAYS)
+    with ThreadPoolExecutor(max_workers=4) as pool:
+      rows = list(pool.map(lambda window: client.aggregations(window[1], window[2]), windows))
+    days = [(window[0], summarize_day(day_rows)) for window, day_rows in zip(windows, rows)]
+    # Each day's usage is kept too, so a scan carried past midnight can be
+    # summed again over the new week.
+    return {**empty_stats(), **summarize_usage(days), "days": days}, True
+
+  try:
+    stats = cached_scan(AGENT_ID, [key], max_age_seconds, scan)
+  except Exception:
+    return carried_stats(key, today)
+  return {name: value for name, value in stats.items() if name != "days"}
+
+
+# ------------------------------------------------------------------ limits
+
+
+# One section of the period reply. Connect's JSON leaves an empty message out
+# (or sends null), so a missing section is a plan with nothing in it; one of
+# another type is a reply this doesn't read, which must not pass for no meters
+# and replace the known limits.
+def usage_section(period: dict[str, Any], key: str) -> dict[str, Any]:
+  section = period.get(key)
+  if section is None:
+    return {}
+  if not isinstance(section, dict):
+    raise CursorError("Cursor's dashboard sent usage in a form this doesn't read.")
+  return section
+
+
+# PlanInfo.included_usage_period says whether the included allowance runs on
+# the billing cycle or resets each week, at included_usage_resets_at. The
+# enum may arrive as its number or its name, prefixed or not.
+def weekly_included(plan: dict[str, Any] | None) -> bool:
+  value = (plan or {}).get("includedUsagePeriod")
+  if isinstance(value, bool):
+    return False
+  return value == 2 or (isinstance(value, str) and value.strip().upper() in ("WEEKLY", "INCLUDED_USAGE_PERIOD_WEEKLY"))
+
+
+# The weekly reset as an epoch in milliseconds, like billingCycleEnd; one
+# small enough to be seconds is read as seconds rather than as 1970.
+def weekly_reset(value: Any) -> str:
+  stamp = number(value)
+  return iso(stamp * 1000 if 0 < stamp < 100_000_000_000 else stamp)
+
+
+def summarize_limits(period: dict[str, Any], plan_info: dict[str, Any] | None = None) -> list[dict[str, Any]]:
+  """Cursor's own percentages, never a percentage derived from spend.
+
+  The dollar figures do not divide into the allowance: bonus usage the
+  providers hand out is spend without an allowance behind it, so
+  totalSpend/limit reads well past 100% while Cursor's own meters do not.
+
+  Every meter runs on the billing cycle, unless the plan says its included
+  allowance is weekly. The included total is the Monthly (or Weekly) row;
+  the model meters and the on-demand budget are titled after it, so the
+  panel attaches them to that row rather than showing four rows that each
+  read "Monthly". The on-demand budget always runs on the billing cycle.
+  """
+  plan = usage_section(period, "planUsage")
+  spend = usage_section(period, "spendLimitUsage")
+  resets_at = iso(period.get("billingCycleEnd"))
+  window, included_resets_at = "Monthly", resets_at
+  if weekly_included(plan_info):
+    window, included_resets_at = "Weekly", weekly_reset((plan_info or {}).get("includedUsageResetsAt"))
+  limits = []
+
+  for label, title, key in (
+    ("Included total", window, "totalPercentUsed"),
+    ("Auto models", f"Auto models {window}", "autoPercentUsed"),
+    ("Named models", f"Named models {window}", "apiPercentUsed"),
+  ):
+    if key in plan:
+      limits.append({"label": label, "title": title, "percent": fraction(plan.get(key)), "resetsAt": included_resets_at})
+
+  limit_cents = number(spend.get("individualLimit"))
+  if limit_cents > 0:
+    used_cents = number(spend.get("individualUsed"))
+    limits.append(dict(on_demand_names(used_cents, limit_cents), percent=min(1.0, used_cents / limit_cents), resetsAt=resets_at, onDemandLimitCents=limit_cents))
+  return limits
+
+
+# The on-demand meter names its dollars, so a kept one that resets to zero
+# is renamed with the spend it now stands at.
+def on_demand_names(used_cents: float, limit_cents: float) -> dict[str, str]:
+  label = f"On-demand ${used_cents / 100:.2f} / ${limit_cents / 100:.2f}"
+  return {"label": label, "title": f"{label} Monthly"}
+
+
+def limits_cache(key: str) -> LimitsCache:
+  return LimitsCache(AGENT_ID, key)
+
+
+# The kept limits as they read now: one whose billing cycle has ended is back
+# at zero, with the next cycle's reset unknown until a check succeeds, and an
+# on-demand meter among them is renamed for its spend of zero.
+def kept_limits(cache: LimitsCache) -> list[dict[str, Any]]:
+  raw = cache.data.get("limits")
+  raw = [entry for entry in raw if isinstance(entry, dict)] if isinstance(raw, list) else []
+  kept = []
+  for entry, opened in zip(raw, cache.limits):
+    cents = number(entry.get("onDemandLimitCents"))
+    if cents > 0 and entry.get("resetsAt") and not opened.get("resetsAt"):
+      opened = dict(opened, **on_demand_names(0, cents))
+    kept.append(opened)
+  return kept
+
+
+# ---------------------------------------------------------------- assembly
+
+
+def scan(api_base_url: str, auth_path: Path, limits_only: bool, state_db: Path | None = None, force: bool = False) -> dict[str, Any]:
+  token = cursor_token(auth_path, state_db)
+  if not token:
+    if cursor_in_use(auth_path):
+      return base_record(ready=True, usageStatusText="Waiting for auth", authHelpText=AUTH_HELP)
+    return base_record()
+
+  client = CursorClient(token, api_base_url)
+  key = account_key(token)
+  cache = limits_cache(key)
+  kept = kept_limits(cache)
+  fetched_at = cache.fetched_at
+  kept_tier = str(cache.data.get("tierLabel") or "")
+  today = datetime.now().astimezone().date()
+  # --limits-only runs while a meter is near its limit, which can last hours,
+  # so the tokens it carries are only so old before they are fetched again.
+  scan_age = scan_max_age(force, limits_only)
+
+  # A failed check keeps the last good limits, marked stale so the panel
+  # gives their age on hover, and the week of tokens already on disk.
+  def failed(status: str, detail: str, retry: bool = False) -> dict[str, Any]:
+    record = base_record(
+      ready=True,
+      tierLabel=kept_tier,
+      usageStatusText=status,
+      authHelpText=detail + (" Showing the last known limits." if kept else ""),
+      limits=kept,
+      limitsStale=True,
+      limitsFetchedAt=fetched_at if kept else 0,
+    )
+    if retry:
+      record["retryAdvised"] = True
+    record.update(carried_stats(key, today))
+    return record
+
+  # CURSOR_API_ENDPOINT moves the endpoint, never the sign-in onto a
+  # connection anyone on the way can read.
+  if not trusted_endpoint(api_base_url):
+    return failed("" if kept else "Cursor limits unavailable", "CURSOR_API_ENDPOINT must use HTTPS (plain HTTP only for loopback).")
+
+  if token_lapsed(token):
+    return failed(
+      "Limits paused",
+      "Cursor's access token has lapsed. Open the Cursor editor, or run `cursor-agent`, to renew it; signing in again is not needed.",
+    )
+
+  # A panel opened and shut repeatedly must not turn into a request per
+  # flick, so an answer this recent is the answer, even one with no meters.
+  if cache.fresh(force, allow_empty=True):
+    record = base_record(ready=True, tierLabel=kept_tier, limits=kept, limitsFetchedAt=fetched_at)
+    record.update(week_stats(client, today, key, scan_age))
+    return record
+
+  try:
+    period = client.period()
+    plan = client.plan_info()
+    # Only the plan says the included allowance is weekly, and the week's
+    # reset with it, so one last known weekly keeps its limits, stale,
+    # rather than reading them as Monthly on the billing cycle.
+    if plan is None and cache.data.get("weekly") is True:
+      raise CursorError("Cursor's plan couldn't be checked.")
+    limits = summarize_limits(period, plan)
+  except CursorError as error:
+    if error.auth:
+      return failed("Sign-in expired", "Cursor refused the saved sign-in. " + AUTH_HELP)
+    return failed("" if kept else "Cursor limits unavailable", str(error), retry=error.transport)
+  except Exception as error:
+    print(f"omarchy-agent-usage-cursor: {type(error).__name__}", file=sys.stderr)
+    return failed("" if kept else "Cursor limits unavailable", "Cursor's usage check failed.")
+
+  tier = kept_tier if plan is None else str(plan.get("planName") or "")
+  weekly = cache.data.get("weekly") is True if plan is None else weekly_included(plan)
+  # The cache only backs later runs; failing to keep it never costs this
+  # run's live answer.
+  record = base_record(ready=True, tierLabel=tier, limits=limits, limitsFetchedAt=cache.save(limits, tierLabel=tier, weekly=weekly))
+  record.update(week_stats(client, today, key, scan_age))
+  return record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description="Print the Cursor usage record as JSON")
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  parser.add_argument("--auth-path", default=os.environ.get("CURSOR_AUTH_PATH", ""))
+  parser.add_argument("--api-base-url", default=os.environ.get("CURSOR_API_ENDPOINT", API_BASE_URL))
+  args = parser.parse_args()
+
+  auth_path = Path(args.auth_path).expanduser() if args.auth_path else cursor_auth_path()
+  try:
+    record = scan(args.api_base_url, auth_path, args.limits_only, force=args.force)
+  # scan() keeps the last limits through any failed check; only a failure
+  # before it knows the account ends up here.
+  except Exception as error:
+    record = base_record(usageStatusText="Cursor limits unavailable", authHelpText="Cursor's usage check failed.")
+    print(f"omarchy-agent-usage-cursor: {type(error).__name__}", file=sys.stderr)
+  emit(record)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff -ruN a/shell/plugins/agents/usage/deepseek.py b/shell/plugins/agents/usage/deepseek.py
--- a/shell/plugins/agents/usage/deepseek.py	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/plugins/agents/usage/deepseek.py	2026-11-18 13:32:49.498727437 +0000
@@ -0,0 +1,449 @@
+# omarchy:summary=Print the DeepSeek usage record as JSON
+# omarchy:args=[--force] [--limits-only]
+# omarchy:hidden=true
+"""Collect DeepSeek usage into one display-ready JSON record.
+
+Local stats come from pi/omp session files whose assistant messages ran on the
+deepseek provider, from opencode sessions that ran on a deepseek provider, and
+from DeepSeek Harness (dsh) session logs on its DeepSeek routes. DeepSeek
+billing is prepaid, so the record carries the live credit balance from
+GET https://api.deepseek.com/user/balance when a key is available, plus the
+optional funded/spent detail derived from ~/.config/omarchy/agents/deepseek.json
+(the same shape the fireworks collector uses). The agents panel only ever reads
+the JSON this prints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import sys
+import urllib.request
+from decimal import Decimal, InvalidOperation
+from pathlib import Path
+from typing import Any
+
+# The shared collector plumbing ships with the agents panel.
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
+from collectors import (  # noqa: E402
+  HttpError,
+  LimitsCache,
+  Stats,
+  base_record as shared_base_record,
+  cached_scan,
+  config_home,
+  data_home,
+  dsh_home,
+  emit,
+  limits_cache_path,
+  now_ms,
+  number,
+  obj,
+  open_json,
+  opencode_db,
+  pi_session_roots,
+  read_json,
+  routed_match,
+  routed_sources,
+  scan_dsh_sessions,
+  scan_max_age,
+  scan_opencode,
+  scan_pi_sessions,
+  scan_routed,
+  trusted_endpoint,
+  warn,
+)
+
+AGENT_ID = "deepseek"
+AGENT_NAME = "DeepSeek"
+API_BASE_URL = "https://api.deepseek.com"
+OUT_OF_CREDITS_HELP = "DeepSeek says the balance no longer covers API calls. Top up at platform.deepseek.com."
+
+# DeepSeek Harness bills DeepSeek through these provider routes: an API key
+# and a DeepSeek account sign-in (its DeepSeek adapter), and its pi-ai
+# adapter's route for pi-ai's own `deepseek` provider, the id pi and opencode
+# name too. Its other pi-ai routes belong to whoever bills them: OpenRouter's
+# to the openrouter collector, a hand-declared gateway's to nobody here.
+DSH_PROVIDERS = ("deepseek-official", "deepseek-account", "deepseek")
+
+
+class DeepSeekError(Exception):
+  def __init__(self, message: str, transport: bool = False, refused: bool = False) -> None:
+    super().__init__(message)
+    self.transport = transport
+    self.refused = refused
+
+
+def model_name(raw: Any) -> str:
+  value = str(raw or AGENT_ID)
+  return value if value else AGENT_ID
+
+
+# ---------------------------------------------------- pi, omp, and opencode
+
+# pi, omp, and opencode name the provider alike. Exact match: a custom
+# gateway named like DeepSeek is not this account.
+def billed_here(provider: str, model: str, entry: dict) -> bool:
+  return provider == "deepseek"
+
+
+def add_harness_rows(stats: Stats) -> bool:
+  """Add pi/omp and opencode messages on the deepseek provider. Returns
+  whether every source was read in full."""
+  pi_rows, pi_complete = scan_pi_sessions(r'"provider"\s*:\s*"deepseek"', billed_here)
+  for row in pi_rows:
+    stats.add_row(row, model_name(row.model))
+  # The closing quote makes the database's prefilter match the whole id.
+  db_rows, db_complete = scan_opencode(['deepseek"'], billed_here)
+  for row in db_rows:
+    stats.add_row(row, model_name(row.model.rstrip("/").split("/")[-1]))
+  return pi_complete and db_complete
+
+
+# -------------------------------------------------------- DeepSeek Harness
+
+def dsh_billed_here(provider: str, model: str, request: dict) -> bool:
+  return provider in DSH_PROVIDERS
+
+
+def scan_dsh(stats: Stats) -> bool:
+  rows, complete = scan_dsh_sessions(dsh_billed_here)
+  for row in rows:
+    stats.add_row(row, model_name(row.model))
+  return complete
+
+
+# ------------------------------------------------------------- scan cache
+
+def run_local_scans(reuse: bool = True) -> tuple[dict[str, Any], bool]:
+  stats = Stats()
+  complete = add_harness_rows(stats)
+  complete = scan_dsh(stats) and complete
+  # Claude Code pointed at DeepSeek's Anthropic API, or answered by a
+  # DeepSeek model, and a MiniMax Code custom provider at DeepSeek's host.
+  routed_rows, routed_complete = scan_routed(AGENT_ID, reuse)
+  for row in routed_rows:
+    stats.add_row(row, model_name(row.model))
+  return stats.snapshot(), complete and routed_complete
+
+
+def cached_local_stats(max_age: float) -> dict[str, Any]:
+  # The digest covers every data path the scan reads.
+  sources = [opencode_db(), dsh_home(), *pi_session_roots(), *routed_sources()]
+  # A forced scan reads every Codex rollout again too.
+  return cached_scan(AGENT_ID, sources, max_age, lambda: run_local_scans(reuse=max_age > 0), match=routed_match())
+
+
+# -------------------------------------------------------------- credentials
+
+def read_key_from_dict(parsed: Any, provider: str) -> str:
+  if not isinstance(parsed, dict):
+    return ""
+  entry = parsed.get(provider)
+  if isinstance(entry, dict):
+    entry = entry.get("key") or entry.get("apiKey") or entry.get("api_key")
+  key = entry.strip() if isinstance(entry, str) else ""
+  # Only a literal key is taken: a pi `$VAR` or `!command` entry is resolved
+  # by pi alone, and sent as it stands it would read as a refused key.
+  return "" if key.startswith(("!", "$")) else key
+
+
+def pi_agent_dir() -> Path:
+  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
+  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"
+
+
+def read_json_key(path: Path, provider: str) -> str:
+  return read_key_from_dict(read_json(path), provider)
+
+
+def unquote(value: str) -> str:
+  value = value.strip()
+  if value[:1] in ("'", '"'):
+    end = value.find(value[0], 1)
+    return value[1:end] if end > 0 else ""
+  # An unquoted scalar ends where a comment begins.
+  return value.split(" #", 1)[0].strip()
+
+
+def read_dsh_credentials_key(path: Path) -> str:
+  """DEEPSEEK_API_KEY from dsh's managed `.credentials.yaml`.
+
+  Only the one plain scalar is needed, so this reads the line rather than
+  pulling in a YAML parser: `refs:` holds it in the current layout, and the
+  pre-release layout kept it at the top level.
+  """
+  try:
+    text = path.read_text(encoding="utf-8")
+  except (OSError, UnicodeDecodeError):
+    return ""
+  section = ""
+  for line in text.splitlines():
+    if not line.strip() or line.lstrip().startswith("#"):
+      continue
+    if not line[0].isspace():
+      section = line.split(":", 1)[0].strip()
+      if section == "DEEPSEEK_API_KEY":
+        return unquote(line.split(":", 1)[1])
+      continue
+    if section == "refs":
+      name, _, value = line.strip().partition(":")
+      if name.strip() == "DEEPSEEK_API_KEY":
+        return unquote(value)
+  return ""
+
+
+def read_dotenv_key(path: Path) -> str:
+  try:
+    text = path.read_text(encoding="utf-8")
+  except (OSError, UnicodeDecodeError):
+    return ""
+  for line in text.splitlines():
+    line = line.strip()
+    if line.startswith("export "):
+      line = line[len("export "):].strip()
+    name, sep, value = line.partition("=")
+    if sep and name.strip() == "DEEPSEEK_API_KEY":
+      return unquote(value)
+  return ""
+
+
+def api_key() -> str:
+  # The environment first, then the agents that keep a DeepSeek key, read
+  # only: pi and omp, opencode, and dsh's managed store with its `.env`
+  # fallback.
+  env_key = str(os.environ.get("DEEPSEEK_API_KEY", "")).strip()
+  if env_key:
+    return env_key
+  for read in (
+    lambda: read_json_key(pi_agent_dir() / "auth.json", "deepseek"),
+    lambda: read_json_key(Path.home() / ".omp" / "agent" / "auth.json", "deepseek"),
+    lambda: read_json_key(data_home() / "opencode" / "auth.json", "deepseek"),
+    lambda: read_dsh_credentials_key(dsh_home() / ".credentials.yaml"),
+    lambda: read_dotenv_key(dsh_home() / ".env"),
+  ):
+    key = read()
+    if key:
+      return key
+  return ""
+
+
+def read_config() -> dict[str, Any]:
+  return read_json(config_home() / "omarchy" / "agents" / "deepseek.json")
+
+
+# ----------------------------------------------------------------- balance
+
+def representable(amount: Decimal) -> bool:
+  # Finite as a Decimal can still overflow the float the record prints.
+  return amount.is_finite() and math.isfinite(float(amount))
+
+
+def money(value: Any) -> Decimal:
+  if isinstance(value, bool):
+    return Decimal("0")
+  try:
+    amount = Decimal(str(value or "0"))
+  except InvalidOperation:
+    return Decimal("0")
+  return amount if representable(amount) else Decimal("0")
+
+
+def fetch_balance(api_base_url: str, key: str) -> dict[str, Any]:
+  """GET /user/balance: total_balance, granted_balance, topped_up_balance."""
+  url = api_base_url.rstrip("/") + "/user/balance"
+  # DEEPSEEK_API_BASE_URL moves the endpoint, never the key onto a
+  # connection anyone on the way can read.
+  if not trusted_endpoint(url):
+    raise DeepSeekError("DEEPSEEK_API_BASE_URL must use HTTPS (plain HTTP only for loopback).")
+  request = urllib.request.Request(
+    url,
+    headers={"Authorization": "Bearer " + key, "Accept": "application/json"},
+  )
+  try:
+    payload = open_json(request, timeout=15)
+  except HttpError as error:
+    if error.status in (401, 403):
+      raise DeepSeekError("DeepSeek rejected the saved API key. Set a current one in DEEPSEEK_API_KEY or the agent that holds it.", refused=True) from error
+    if error.status:
+      raise DeepSeekError(f"DeepSeek's balance endpoint returned HTTP {error.status}.") from error
+    if error.transport:
+      # No answer at all: no route, no DNS, a timeout. Worth a retry soon.
+      raise DeepSeekError("Couldn't reach the DeepSeek API. Retrying shortly.", transport=True) from error
+    raise DeepSeekError("DeepSeek returned an invalid balance response.") from error
+
+  if not isinstance(payload, dict):
+    raise DeepSeekError("DeepSeek returned an invalid balance response.")
+  infos = payload.get("balance_infos")
+  if not isinstance(infos, list) or not infos:
+    raise DeepSeekError("DeepSeek's balance response carried no balance_infos.")
+
+  # One entry per currency (CNY or USD). The one holding credit is the
+  # balance, so an empty CNY entry never hides a funded USD one; with none
+  # funded, the first. An entry without a readable total says nothing and is
+  # skipped, and an answer with none is a failed check that keeps the last
+  # good balance, never a balance of zero.
+  readable = []
+  for info in infos:
+    if not isinstance(info, dict):
+      continue
+    total = info.get("total_balance")
+    try:
+      remaining = None if isinstance(total, bool) or total is None else Decimal(str(total).strip())
+    except InvalidOperation:
+      remaining = None
+    if remaining is not None and representable(remaining):
+      readable.append((remaining, info))
+  if not readable:
+    raise DeepSeekError("DeepSeek's balance response carried no total_balance.")
+  remaining, info = next((entry for entry in readable if entry[0] > 0), readable[0])
+
+  return {
+    "remaining": remaining,
+    "granted": money(info.get("granted_balance")),
+    "toppedUp": money(info.get("topped_up_balance")),
+    "currency": str(info.get("currency") or "CNY"),
+    # DeepSeek's own word on whether the balance still covers API calls.
+    "available": payload.get("is_available") is not False and remaining > 0,
+  }
+
+
+def balance_record(remaining: Decimal, currency: str) -> dict[str, Any]:
+  config = read_config()
+  funded = money(config.get("fundedAmount"))
+  if funded < 0:
+    funded = Decimal("0")
+  spent = max(Decimal("0"), funded - remaining) if funded > 0 else Decimal("0")
+  return {
+    "remaining": float(max(Decimal("0"), remaining)),
+    "funded": float(funded),
+    "spent": float(spent),
+    "currency": str(currency or "CNY"),
+    # funded/spent derive from the configured fundedAmount, not DeepSeek's
+    # own ledger, so they are labelled estimates; remaining is live.
+    "estimated": funded > 0,
+  }
+
+
+# One cache per key and endpoint, so a machine signed in to another account
+# never shows the last one's balance.
+def balance_cache_path(key: str, api_base_url: str) -> Path:
+  return limits_cache_path(AGENT_ID, api_base_url.rstrip("/"), key)
+
+
+def out_of_credits(result: dict[str, Any], available: Any) -> None:
+  # With no funded figure the balance gauge can't raise this alarm itself,
+  # so the status does.
+  if available is False:
+    result.update(usageStatusText="Out of credits", authHelpText=OUT_OF_CREDITS_HELP)
+
+
+def collect_balance(key: str, api_base_url: str, force: bool) -> dict[str, Any]:
+  result: dict[str, Any] = {"balance": None, "stale": False, "fetchedAtMs": 0, "usageStatusText": "", "authHelpText": "", "retryAdvised": False}
+  cache = None
+  try:
+    cache = LimitsCache.at(balance_cache_path(key, api_base_url))
+  except OSError as exc:
+    warn(f"could not read the balance cache ({exc})")
+  kept = obj(cache.data.get("balance")) if cache else {}
+  fetched_at = cache.fetched_at if cache else 0
+
+  # A panel opened and closed repeatedly must not become one request per
+  # flick, so a recent answer is reused, though a balance has no limit
+  # windows; --force skips the wait.
+  if kept and cache.fresh(force, allow_empty=True):
+    result.update(balance=balance_record(money(kept.get("remaining")), str(kept.get("currency") or "")), fetchedAtMs=fetched_at)
+    out_of_credits(result, kept.get("available"))
+    return result
+
+  try:
+    live = fetch_balance(api_base_url, key)
+  except DeepSeekError as error:
+    result["retryAdvised"] = error.transport
+    result["authHelpText"] = str(error)
+    if kept:
+      # The last good balance, marked stale with when it was read, beats an
+      # empty section while DeepSeek can't be asked.
+      result.update(balance=balance_record(money(kept.get("remaining")), str(kept.get("currency") or "")), stale=True, fetchedAtMs=fetched_at)
+      out_of_credits(result, kept.get("available"))
+      result["authHelpText"] = str(error)
+    if error.refused:
+      result["usageStatusText"] = "Sign-in expired"
+    elif not kept:
+      result["usageStatusText"] = "Balance unavailable"
+    return result
+
+  balance = {"remaining": str(live["remaining"]), "currency": live["currency"], "available": live["available"]}
+  fetched_at = cache.save([], only_if_newer=True, balance=balance) if cache is not None else now_ms()
+  result.update(balance=balance_record(live["remaining"], live["currency"]), fetchedAtMs=fetched_at)
+  out_of_credits(result, live["available"])
+  return result
+
+
+# ------------------------------------------------------------------ record
+
+# Whether a scan found any DeepSeek usage on this machine: a session, or
+# tokens no session is known for.
+def has_local_stats(stats: dict[str, Any]) -> bool:
+  return number(stats.get("totalSessions")) > 0 or bool(stats.get("modelUsage"))
+
+
+def base_record(stats: dict[str, Any] | None = None) -> dict[str, Any]:
+  # Prompt and session counts are real: every pi session message carries
+  # them, so today's tooltip may show "N prompts · M sessions".
+  record = shared_base_record(AGENT_ID, AGENT_NAME)
+  if stats is not None:
+    record.update(stats, hasLocalStats=has_local_stats(stats))
+  return record
+
+
+def collect(api_base_url: str, max_age: float, force: bool) -> dict[str, Any]:
+  record = base_record(cached_local_stats(max_age))
+  record["ready"] = record["hasLocalStats"]
+
+  # Without a key the record carries local stats only, with no plan, so the
+  # panel leaves out the balance section, and skips the record altogether on
+  # a machine that has never used DeepSeek.
+  key = api_key()
+  if not key:
+    return record
+  record.update(ready=True, tierLabel="Prepaid")
+  balance = collect_balance(key, api_base_url, force)
+  if balance["balance"] is not None:
+    record["balance"] = balance["balance"]
+  record.update(
+    usageStatusText=balance["usageStatusText"],
+    authHelpText=balance["authHelpText"],
+    limitsStale=balance["stale"],
+    limitsFetchedAt=balance["fetchedAtMs"],
+  )
+  if balance["retryAdvised"]:
+    record["retryAdvised"] = True
+  return record
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description="Print the DeepSeek usage record as JSON")
+  # --force rescans everything and asks DeepSeek past the reuse window.
+  # --limits-only (the panel's quick refresh) may reuse a scan for 15
+  # minutes, but asks for the balance like a normal run.
+  parser.add_argument("--force", action="store_true")
+  parser.add_argument("--limits-only", action="store_true")
+  parser.add_argument("--api-base-url", default=os.environ.get("DEEPSEEK_API_BASE_URL", API_BASE_URL))
+  args = parser.parse_args()
+
+  try:
+    record = collect(args.api_base_url, scan_max_age(args.force, args.limits_only), args.force)
+  except Exception as error:
+    # A bug, not a state the panel should explain: an empty record keeps
+    # the panel steady, and stderr says what broke.
+    record = base_record()
+    warn(f"{type(error).__name__}: {error}")
+  emit(record)
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
