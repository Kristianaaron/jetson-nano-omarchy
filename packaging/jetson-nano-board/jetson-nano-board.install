post_install() {
  systemctl enable jetson-nano-emc.service
  echo ">>> jetson-nano-board supersedes the local jetson-emc-min-clock, jetson-gpu-min-clock and"
  echo ">>> jetson-nano-fan services; disable them: systemctl disable jetson-emc-min-clock"
  echo ">>> jetson-gpu-min-clock jetson-nano-fan"
}
pre_remove() {
  systemctl disable jetson-nano-emc.service
}
