[Unit]
Description=Jetson Nano memory clock 1600 MHz (guarded)
After=systemd-modules-load.service sys-kernel-debug.mount
Requires=sys-kernel-debug.mount

[Service]
# exec, not oneshot: the raise and its 5 s guard run next to the rest of boot instead of holding
# multi-user.target (and the desktop) back by about 11 s
Type=exec
ExecStart=/usr/lib/jetson-nano/emc-raise
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
