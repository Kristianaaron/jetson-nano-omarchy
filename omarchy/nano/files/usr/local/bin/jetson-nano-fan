#!/bin/bash
# Jetson Nano: mainline starts the fan at the cpu-thermal active trip (50 C).
# Start it at FAN_ON_MC instead, so the desktop runs cooler and quieter under load.
FAN_ON_MC=${FAN_ON_MC:-38000}
for z in /sys/class/thermal/thermal_zone*; do
  [[ $(cat "$z/type") == cpu-thermal ]] || continue
  for t in "$z"/trip_point_*_type; do
    [[ $(cat "$t") == active ]] && echo "$FAN_ON_MC" > "${t%_type}_temp"
  done
done
